@* Thai site header — mirrors the shared header in exports/site-html/thai-pages/*.html. Menu links go to the English pages, as in the HTML site. *@
<header class="hana-header" style="background:#fff; font-family:var(--font-text);">

    
    <div class="hana-util-bar" data-hana-geo="strip" data-geo-theme="midnight"
         style="color:rgba(255,255,255,0.78); font-size:12px;">
        <div class="hana-wrap"
             style="height:36px; display:flex; align-items:center; justify-content:space-between; padding-top:0; padding-bottom:0;">

            
            <div style="display:flex; gap:18px; align-items:center; font-family:var(--font-mono); font-size:11px;">
                <span style="font-family:var(--font-text); font-size:10px; font-weight:600;
                             text-transform:uppercase; letter-spacing:0.1em; color:rgba(255,255,255,0.55);">SET</span>
                <span style="color:#fff;">HANA</span>
                <span>฿24.50</span>
                <span style="color:#7EC8FF;">+1.24%</span>
            </div>

            
            <div class="hs-hdr-box" style="display:flex; align-items:center; gap:8px;
                            border-radius:4px; padding:4px 10px; min-width:220px;">
                    <i data-lucide="search"
                       style="width:12px; height:12px; flex-shrink:0;"></i>
                    <span style="color:#444B54; font-size:12px;">
                        ค้นหาความสามารถ ขนาดแพ็กเกจ ใบรับรอง และอื่น ๆ&hellip;
                    </span>
                </div>

                <div style="display:flex; gap:18px; align-items:center;">
                <a href="/th/careers" style="color:inherit; text-decoration:none;">ร่วมงานกับเรา</a>
                <a href="/insights" style="color:inherit; text-decoration:none;">บทความและมุมมอง</a>
                @if (ViewData["AltLangUrl"] != null)
                {
                    <a href="@ViewData["AltLangUrl"]" class="hana-lang" lang="en" style="color:inherit; text-decoration:none; display:inline-flex; align-items:center; gap:6px;"><i data-lucide="globe" style="width:13px; height:13px;"></i> EN</a>
                }
                                

                
                
            </div>
        </div>
    </div>

    
    <div id="hana-nav-wrap" style="position:relative;">

        
        <div style="border-bottom:1px solid var(--line);">
            <div class="hana-wrap"
                 style="padding-top:18px; padding-bottom:18px; display:flex; align-items:center; gap:32px;">

                
                <a href="/th" aria-label="Hana Microelectronics — หน้าแรก">
                    <img src="/images/hana-logo-full-trimmed.webp" alt="Hana"
                         width="200" height="65"
                         style="display:block; object-fit:contain; object-position:left center;" />
                </a>

                
                <nav aria-label="เมนูหลัก"
                     style="display:flex; gap:24px; margin-left:12px;">

                    <a href="/about" data-menu="About"
                       class="hana-nav-link">
                        เกี่ยวกับเรา
                        <span class="hana-nav-chevron">
                            <i data-lucide="chevron-down" style="width:13px; height:13px;"></i>
                        </span>
                    </a>

                    <a data-menu="Markets" role="button" tabindex="0" aria-haspopup="true"
                       class="hana-nav-link">
                        ตลาด
                        <span class="hana-nav-chevron">
                            <i data-lucide="chevron-down" style="width:13px; height:13px;"></i>
                        </span>
                    </a>

                    <a href="/capabilities" data-menu="Capabilities"
                       class="hana-nav-link">
                        ความสามารถ
                        <span class="hana-nav-chevron">
                            <i data-lucide="chevron-down" style="width:13px; height:13px;"></i>
                        </span>
                    </a>

                    <a href="/locations" data-menu="Locations"
                       class="hana-nav-link">
                        ที่ตั้ง
                        <span class="hana-nav-chevron">
                            <i data-lucide="chevron-down" style="width:13px; height:13px;"></i>
                        </span>
                    </a>

                    <a href="/th/investor-relations" data-menu="Investor Relations"
                       class="hana-nav-link">
                        นักลงทุนสัมพันธ์
                        <span class="hana-nav-chevron">
                            <i data-lucide="chevron-down" style="width:13px; height:13px;"></i>
                        </span>
                    </a>

                </nav>

                
                <div style="margin-left:auto; display:flex; gap:8px;">
                    <a href="/th/contact" class="hana-btn hana-btn-secondary"
                       style="padding:11px 24px; font-size:12px; white-space:nowrap; background:var(--hana-blue); color:#fff; border-color:var(--hana-blue);"
                       onmouseover="this.style.background='var(--hana-blue-deep)'; this.style.borderColor='var(--hana-blue-deep)';" onmouseout="this.style.background='var(--hana-blue)'; this.style.borderColor='var(--hana-blue)';">ติดต่อเรา</a>
                </div>

            </div>
        </div>

        
        

        
        <div data-panel="About" class="hana-mega" hidden
             style="position:absolute; top:100%; left:0; right:0; z-index:60;
                    background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
                    box-shadow:0 24px 48px rgba(3,10,23,0.12);">
            <div class="hana-wrap"
                 style="padding-top:36px; padding-bottom:40px;
                        display:grid; grid-template-columns:270px 1fr; gap:56px; align-items:start;">
                
                <div style="border-right:1px solid var(--line); padding-right:40px;">
                    <div style="font-family:var(--font-display); font-size:21px; font-weight:700;
                                letter-spacing:-0.02em; margin-bottom:12px;">เกี่ยวกับ Hana</div>
                    <p style="font-family:var(--font-text); font-size:13px; line-height:1.6;
                               color:var(--ink-2); margin:0 0 20px; text-wrap:pretty;">
                        ผู้ผลิตอิเล็กทรอนิกส์ระดับโลกตั้งแต่ปี 1978 รวม EMS, OSAT และไมโครอิเล็กทรอนิกส์ไว้ภายใต้มาตรฐานการดำเนินงานเดียวกัน
                    </p>
                    <a href="/about" class="hana-link" style="font-size:11px; letter-spacing:0.1em;">
                        ภาพรวมบริษัท
                        <i data-lucide="arrow-right" style="width:13px; height:13px;"></i>
                    </a>
                </div>
                
                <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:36px;">
                    <div>
                        <div class="hana-spec-label" style="margin-bottom:14px; color:var(--ink);">บริษัท</div>
                        <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px;">
                            <li><a href="/about"              class="hana-mega-sub-link">ทำไมต้อง Hana</a></li>
                            <li><a href="/th/about/leadership"   class="hana-mega-sub-link">คณะกรรมการและผู้บริหาร</a></li>
                            <li><a href="/th/about/history"      class="hana-mega-sub-link">ประวัติความเป็นมา</a></li>
                            <li><a href="/th/about/quality"      class="hana-mega-sub-link">คุณภาพและการรับรองมาตรฐาน</a></li>
                        </ul>
                    </div>
                    <div>
                        <div class="hana-spec-label" style="margin-bottom:14px; color:var(--ink);">ติดต่อ</div>
                        <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px;">
                            <li><a href="/th/careers"  class="hana-mega-sub-link">ร่วมงานกับเรา</a></li>
                            <li><a href="/th/contact"  class="hana-mega-sub-link">ติดต่อเรา</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        
        <div data-panel="Markets" class="hana-mega" hidden
             style="position:absolute; top:100%; left:0; right:0; z-index:60;
                    background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
                    box-shadow:0 24px 48px rgba(3,10,23,0.12);">
