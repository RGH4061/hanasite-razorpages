@*
    Pages/Shared/_Layout.cshtml — host layout for the whole site.
    Renders the shared header + footer around every page's content.

    Per-page overrides via ViewData:
      ViewData["Title"]        page <title> (required-ish)
      ViewData["FullTitle"]    optional: the whole <title>, when it should not end in "| Hana Microelectronics"
      ViewData["Motion"]       optional: entrance-motion profile in js/motion.js (e.g. "capability")
      ViewData["Description"]  meta description
      ViewData["Canonical"]    canonical URL (default: this page's route on www.hanagroup.com)
      ViewData["Robots"]       optional robots directive, e.g. "noindex"
      ViewData["OgImage"]      optional share image (default: the page's first content photo)

    Canonical, hreflang, Open Graph and the JSON-LD graph (organization, website,
    page, breadcrumbs, FAQ) are built by Services/Seo.cs from the rendered page,
    so FAQ structured data always matches the FAQ copy on the page.

    Optional Razor sections a page may define:
      @@section Head    { ... }   extra <head> markup (e.g. Article JSON-LD)
      @@section Scripts { ... }   page-specific JS, loaded after global JS

    Global assets:
      ~/css/site.css              tokens → base → layout → components
      Lucide UMD                  line-icon set (data-lucide attributes)
      ~/js/hana-backgrounds.js    auto-renders [data-hana-bg] section art
      ~/css/hana-geo-motion.css + ~/js/hana-geo-motion.js   [data-hana-geo] Midnight strips (util bar, footer)
      ~/js/mega-menu.js           header hover mega-menus
      ~/js/mobile-nav.js          ≤900px compact bar + slide-in accordion
*@
@using HanaSite.Services
@inject IEnumerable<Microsoft.AspNetCore.Routing.EndpointDataSource> EndpointSources
<!DOCTYPE html>
@{
    var motionProfile = ViewData["Motion"] as string;
    var lang = ViewData["Lang"] as string ?? "en";
    var fullTitle = ViewData["FullTitle"] as string ?? ViewData["Title"] + " | Hana Microelectronics";
    var description = ViewData["Description"] as string ?? Seo.DefaultDescription;

    // The page body and its Head section render first, so the metadata can be built from them.
    // RenderSectionAsync writes straight to the output, so the Head section is captured in a buffer.
    var pageBody = RenderBody();
    var headWriter = new System.IO.StringWriter();
    PushWriter(headWriter);
    await RenderSectionAsync("Head", required: false);
    PopWriter();
    var pageHead = headWriter.ToString();
    var seo = Seo.ForPage(Context, ViewData["Title"] as string, fullTitle, description,
        ViewData["Canonical"] as string, ViewData["Robots"] as string, ViewData["OgImage"] as string, lang,
        Seo.ToHtml(pageBody), pageHead, EndpointSources);
}
<html lang="@lang" @if (motionProfile != null) { <text>data-motion="@motionProfile"</text> }>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>

    <meta name="description" content="@description" />
    <link rel="canonical" href="@seo.Canonical" />
    @if (seo.Robots != null)
    {
        <meta name="robots" content="@seo.Robots" />
    }
    @foreach (var alt in seo.Alternates)
    {
        <link rel="alternate" hreflang="@alt.Lang" href="@alt.Href" />
    }
    <meta property="og:site_name" content="@Seo.SiteName" />
    <meta property="og:type" content="@seo.OgType" />
    <meta property="og:title" content="@seo.OgTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@seo.Canonical" />
    <meta property="og:image" content="@seo.OgImage" />
    <meta property="og:locale" content="@seo.OgLocale" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="~/images/hana-mark.svg" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/hana-geo-motion.css" />
    <link rel="stylesheet" href="~/css/search.css" />
    <link rel="stylesheet" href="~/css/motion.css" />
    @if (motionProfile != null)
    {
        @* Hide the main content until motion.js has tagged it (never longer than 1.5 s). *@
        <script>(function(h){if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;h.classList.add('m-pre');setTimeout(function(){h.classList.remove('m-pre')},1500)})(document.documentElement)</script>
        <script src="~/js/motion.js" defer></script>
    }

    @* Lucide line-icon set (matches brand iconography spec). *@
    <script src="~/js/vendor/lucide.min.js"></script>

    @Html.Raw(pageHead)
    <script type="application/ld+json">@Html.Raw(seo.JsonLd)</script>
</head>
<body style="margin:0; background:#fff; font-family:var(--font-text); -webkit-font-smoothing:antialiased;">

    @if ((string?)ViewData["Lang"] == "th")
    {
        <partial name="_HeaderTh" />
    }
    else
    {
        <partial name="_Header" />
    }

    <main id="main-content">
        @pageBody
    </main>

    <partial name="_Footer" />

    @* ── Global scripts ─────────────────────────────────────── *@
    <script src="~/js/hana-backgrounds.js"></script>
    @* Ambient geometric motion on [data-hana-geo]. Remove this line to switch motion off site-wide (CSS keeps the Midnight fill). *@
    <script src="~/js/hana-geo-motion.js"></script>
    <script src="~/js/mega-menu.js"></script>
    <script src="~/js/section-menu.js"></script>
    <script src="~/js/mobile-nav.js"></script>
    <script src="~/js/search/data.js"></script>
    @* engine.js reads window.HS_PACKAGES once, at load — the package card in the header
       dropdown, the mobile menu and /search all depend on this file loading first. *@
    <script src="~/js/search/packages.js"></script>
    <script src="~/js/search/engine.js"></script>
    <script src="~/js/site-search.js"></script>
    @* Insights article share links (LinkedIn / Email / Copy link); does nothing on other pages. *@
    <script src="~/js/share.js"></script>
    <script>
        if (typeof lucide !== 'undefined') { lucide.createIcons(); }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
