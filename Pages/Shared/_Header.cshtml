                    <a href="/contact" class="hana-btn hana-btn-secondary"
                       style="padding:11px 24px; font-size:12px; white-space:nowrap; background:var(--hana-blue); color:#fff; border-color:var(--hana-blue);"
                       onmouseover="this.style.background='var(--hana-blue-deep)'; this.style.borderColor='var(--hana-blue-deep)';" onmouseout="this.style.background='var(--hana-blue)'; this.style.borderColor='var(--hana-blue)';">Contact</a>
                </div>

            </div>
