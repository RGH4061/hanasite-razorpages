@{
    // On Thai pages, footer links open the Thai version where one exists.
    var thai = (string?)ViewData["Lang"] == "th";
    string L(string path) => thai ? (path == "/" ? "/th" : "/th" + path) : path;
    // Share price column: SET's HANA price box (irpage.jsp, 200 x 214 px). SET serves it only on the
    // website registered with it (www.hanagroup.com); on any other host (localhost, the GitHub Pages
    // preview) its firewall answers "Access denied", so those hosts show SET's sample image instead.
    var setLive = Context.Request.Host.Host.EndsWith("hanagroup.com", StringComparison.OrdinalIgnoreCase);
}
