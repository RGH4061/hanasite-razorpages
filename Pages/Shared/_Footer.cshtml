            @* Share price: SET's HANA price box (see setLive above). Settrade's 160 x 60 banner was
               tried and dropped: it shows only the SET Index and takes no symbol. *@
            <div>
                <div style="font-family:var(--font-text); font-size:12px; font-weight:600;
                             text-transform:uppercase; letter-spacing:0.1em;
                             color:var(--ink); margin-bottom:12px;">Share price</div>
                <div style="width:200px; height:214px; overflow:hidden; border:1px solid var(--line); border-radius:4px; background:#fff;">
                    @if (setLive)
                    {
                    <iframe src="https://weblink.settrade.com/IRPage/irpage.jsp?txtSymbol=HANA&amp;language=@(thai ? "th" : "en")&amp;key=27160" title="HANA share price from the Stock Exchange of Thailand" width="200" height="214" frameborder="0" scrolling="no"
                            style="display:block; border:0;"></iframe>
                    }
                    else
                    {
                    <img src="https://media.set.or.th/set/Images/2022/Mar/%E0%B8%95%E0%B8%B1%E0%B8%A7%E0%B8%AD%E0%B8%A2%E0%B9%88%E0%B8%B2%E0%B8%87%E0%B8%A3%E0%B8%B9%E0%B8%9B%E0%B9%81%E0%B8%9A%E0%B8%9A%E0%B8%A1%E0%B8%B2%E0%B8%95%E0%B8%A3%E0%B8%90%E0%B8%B2%E0%B8%99%E0%B8%82%E0%B8%AD%E0%B8%87%E0%B8%95%E0%B8%A5%E0%B8%B2%E0%B8%94%E0%B8%AB%E0%B8%A5%E0%B8%B1%E0%B8%81%E0%B8%97%E0%B8%A3%E0%B8%B1%E0%B8%9E%E0%B8%A2%E0%B9%8C%E0%B8%AF.jpg"
                         alt="SET sample display of the IR widget" style="display:block; width:200px; height:214px; object-fit:cover; object-position:right center;" />
                    }
