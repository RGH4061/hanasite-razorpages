                        <path d="M14.5 13.5H18.3V15.05H18.35C18.87 14.06 20.09 13 21.95 13C26 13 27 15.63 27 19.09V24H23V19.86C23 18.25 22.97 16.19 20.75 16.19C18.5 16.19 18.15 17.93 18.15 19.74V24H14.5V13.5Z" fill="#fff"/>
