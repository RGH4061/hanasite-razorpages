@* _Homepage_Cta.cshtml — Closing CTA — free-floating rounded card on white
   Dark blue panel with PCB grid texture and two CTA buttons.
   Spec ref: design_handoff_homepage/README.md §8
*@

<section class="hana-cta-section mm-cta-float" style="background:#fff; padding:16px 0 64px;">
    <div class="hana-wrap">
      <div class="mm-cta-card"
           data-hana-bg="grid" data-variant="dark" data-accent="cyan" data-fade="none"
           style="background:var(--hana-blue-deep); position:relative; overflow:hidden;
                  border-radius:14px; padding:64px 56px;">
        <div style="position:relative; z-index:1;">
        <div style="display:grid;
                    grid-template-columns:minmax(0, 1.2fr) minmax(0, 1fr);
                    gap:48px; align-items:center;">

            <h2 style="font-family:var(--font-display); font-size:30px; font-weight:600;
                        letter-spacing:-0.02em; line-height:1.2; color:#ffffff;
                        max-width:640px; margin:0; text-wrap:pretty;">
                Tell us about your program. We'll route it to the right facility.
            </h2>

            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <a href="/contact" class="hana-btn hana-btn-primary">
                    Talk to engineering
                    <i data-lucide="arrow-right" style="width:14px; height:14px;"></i>
                </a>
            </div>

        </div>
    </div>
      </div>
    </div>
</section>
