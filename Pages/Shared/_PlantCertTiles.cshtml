@model string
@using HanaSite.Services
@*
    Certification tiles on a plant location page (17 Nov 2026), drawn from
    Data/certifications.json so the tiles, the plant certification page, the Locations hub
    chips and the search card list the same certificates. Model = the plant's register key.
    The page keeps the grid container; a partner logo tile (Ohio) follows the partial.
*@
@foreach (var s in Certifications.StandardsAt(Model))
{
        <div style="display:flex;align-items:center;gap:13px;background:#fff;border:1px solid var(--line);border-radius:var(--radius-card);padding:13px 16px;">
      <div style="width:34px;height:34px;border-radius:50%;border:1.5px solid #0E4A7C;flex-shrink:0;display:flex;align-items:center;justify-content:center;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#0E4A7C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg></div>
      <div><div style="font-family:var(--font-display);font-size:15px;font-weight:600;color:var(--ink);letter-spacing:-0.01em;line-height:1.15;">@s.Short</div>
      <div style="font-size:11.5px;color:var(--ink-3);margin-top:2px;">@s.Label</div></div>
    </div>
}
