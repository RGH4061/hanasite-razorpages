@model string
@using HanaSite.Services
@*
    Certification chips on a Locations hub plant card (17 Nov 2026), drawn from
    Data/certifications.json. Model = the plant's register key. Partner statuses that are not
    certificates (Impinj and NXP Gold Partner at Ohio) follow the partial in the hub page.
*@
@foreach (var s in Certifications.StandardsAt(Model))
{<span style="font-family:var(--font-mono);font-size:10.5px;font-weight:500;line-height:1.2;color:var(--ink-2);padding:3px 8px;white-space:nowrap;border:1px solid var(--line);border-radius:4px;background:#fff;">@(s.Chip ?? s.Short)</span>}
