@page "/th"
@model IndexModel
@{
    ViewData["Title"] = "บริการผลิตอิเล็กทรอนิกส์ (EMS) และ OSAT — Hana Microelectronics";
    ViewData["Canonical"] = "https://www.hanagroup.com/th";
    ViewData["Lang"] = "th";
    ViewData["AltLang"] = "en";
    ViewData["AltLangUrl"] = "/";
}
@* Thai homepage — mirrors exports/site-html/thai-pages/index.html (Thai copy from 08-homepage.md). *@
@section Head {
<link rel="stylesheet" href="~/css/homepage-mobile.css" />
<style>
#main-content h2,#main-content .hana-spec-label,#main-content .hana-body,#main-content .hana-btn,#main-content .hana-link,#main-content .hha-sub,#main-content .hrv,#main-content .hana-tile-name,#main-content .hana-tile-body,#main-content .hana-cap-card__title,#main-content .hana-cap-card__desc,#main-content .hana-loc-card,#main-content .hana-loc-card *,#main-content .cap-find-lb,#main-content .cap-find-meta,#main-content .cap-find-box input,#main-content .hana-loc-card__hq-badge{font-family:var(--font-thai)!important;letter-spacing:0!important;text-transform:none!important}
#main-content .hha-badge{font-family:var(--font-thai)!important;letter-spacing:0!important;white-space:nowrap}#main-content h2{line-height:1.35!important}#main-content .hana-body,#main-content .hha-sub,#main-content p.hrv{line-height:1.8!important}</style>
<link rel="alternate" hreflang="en" href="https://www.hanagroup.com/" />
<link rel="alternate" hreflang="th" href="https://www.hanagroup.com/th" />
<link rel="alternate" hreflang="x-default" href="https://www.hanagroup.com/" />
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Organization",
  "name": "Hana Microelectronics Public Company Limited",
  "url": "https://www.hanagroup.com",
  "logo": "https://www.hanagroup.com/images/hana-logo-full.svg",
  "description": "The leading independent EMS and OSAT company in Southeast Asia, specializing in microelectronics.",
  "foundingDate": "1978"
}
</script>
