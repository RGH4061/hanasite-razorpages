@page "/th/careers/stories"
@{
    ViewData["Title"] = "ชีวิตการทำงานที่ Hana — Hana Microelectronics";
    ViewData["Description"] = "เรื่องราวจากบุคลากรผู้สร้างสรรค์งานด้านไมโครอิเล็กทรอนิกส์ที่ Hana";
    ViewData["Canonical"] = "https://www.hanagroup.com/th/careers/stories";
    ViewData["Lang"] = "th";
    ViewData["AltLang"] = "en";
    ViewData["AltLangUrl"] = "/careers/stories";
}
@section Head {
    <link rel="stylesheet" href="~/css/careers-stories.css" />
    <link rel="stylesheet" href="~/css/careers-th.css" />
    <link rel="stylesheet" href="~/css/careers-stories-th.css" />
    <link rel="alternate" hreflang="en" href="https://www.hanagroup.com/careers/stories" />
    <link rel="alternate" hreflang="th" href="https://www.hanagroup.com/th/careers/stories" />
    <link rel="alternate" hreflang="x-default" href="https://www.hanagroup.com/careers/stories" />
    <style>
      .hero .hero-inner { display: grid; grid-template-columns: 1fr auto; gap: var(--s-7); align-items: center; }
      .hero-card { width: 500px; max-width: 46vw; background: var(--hana-blue-deep, #0E4A7C); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
      .hero-card img { display: block; width: 100%; height: 320px; object-fit: cover; }
      @@media (max-width: 820px) { .hero .hero-inner { grid-template-columns: 1fr; align-items: start; } .hero-card { width: 100%; max-width: none; } }
    </style>
}

@* Thai — Stories — Careers at Hana. Static content + vanilla interactions in ~/js/careers-stories.js. *@

