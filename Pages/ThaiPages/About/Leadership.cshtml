@page "/th/about/leadership"
@{
    ViewData["Title"] = "คณะกรรมการและผู้บริหาร";
    ViewData["Description"] = "Hana Microelectronics เป็นบริษัทมหาชนที่จดทะเบียนในตลาดหลักทรัพย์แห่งประเทศไทย คณะกรรมการบริษัทกำหนดนโยบายการกำกับดูแลกิจการและกลยุทธ์ของบริษัท ส่วนคณะผู้บริหารดูแลการผลิตในประเทศไทย จีน และกัมพูชา";
    ViewData["Canonical"] = "https://www.hanagroup.com/th/about/leadership";
    ViewData["Lang"] = "th";
    ViewData["AltLang"] = "en";
    ViewData["AltLangUrl"] = "/about/leadership";
}
@section Head {
    <link rel="stylesheet" href="~/css/about-leadership.css" />
    <link rel="stylesheet" href="~/css/about-leadership-th.css" />
    <link rel="alternate" hreflang="en" href="https://www.hanagroup.com/about/leadership" />
    <link rel="alternate" hreflang="th" href="https://www.hanagroup.com/th/about/leadership" />
    <link rel="alternate" hreflang="x-default" href="https://www.hanagroup.com/about/leadership" />
}

@* Thai — Leadership. Thai from workbook 20; photo alt text stays English (workbook blank). Headshots hot-linked from the live site, same as the English page. *@

<!-- ── Hero band: breadcrumb + hero over flow background ── -->
<div class="hero-band hero-band--flow" data-hana-bg="flow" data-variant="light" data-accent="cyan" data-fade="none">

  <div class="subbar">
    <div class="subbar-inner">
      <nav class="crumbs" aria-label="เส้นทางการเข้าชม (Breadcrumb)">
        <a href="/">Home</a><span class="sep">/</span>
        <span class="nolink">เกี่ยวกับเรา</span><span class="sep">/</span>
        <span>คณะกรรมการและผู้บริหาร</span>
      </nav>
      <div class="meta">จดทะเบียนใน SET · พ.ศ. 2536</div>
    </div>
  </div>

  <section class="hero">
    <div class="hero-inner">
      <h1>คณะกรรมการและผู้บริหารของ Hana</h1>
      <p class="lede">Hana Microelectronics เป็นบริษัทมหาชนที่จดทะเบียนในตลาดหลักทรัพย์แห่งประเทศไทย คณะกรรมการบริษัทกำหนดนโยบายการกำกับดูแลกิจการและกลยุทธ์ของบริษัท ส่วนคณะผู้บริหารดูแลการผลิตในประเทศไทย จีน และกัมพูชา</p>
      <a class="anchor-chip" href="#board-of-directors">คณะกรรมการบริษัท</a>
      <a class="anchor-chip" href="#executive-team">ผู้บริหารระดับสูง</a>
    </div>
  </section>
</div>

<!-- ── Board of Directors ── -->
<div class="people-band">
<section class="section" id="board-of-directors">
  <div class="section-head">
    <h2>คณะกรรมการบริษัท</h2>
    <p>คณะกรรมการบริษัทกำหนดนโยบายการกำกับดูแลกิจการ การกำกับติดตาม และทิศทางเชิงกลยุทธ์ของบริษัท ฮานา ไมโครอิเล็คโทรนิคส จำกัด (มหาชน)</p>
  </div>

  <div class="people-grid board">
    <article class="person">
      <div class="photo"><img src="https://www.hanagroup.com/images/Board_1.%20John.png" alt="Mr. John Thompson" loading="lazy" onerror="this.style.display='none'"></div>
      <span class="p-tag">ประธานกรรมการบริษัท</span>
      <h3 class="p-name">นายจอห์น ทอมพ์สัน</h3>
      <p class="p-role">ประธานกรรมการบริษัทและกรรมการอิสระ</p>
    </article>
    <article class="person">
      <div class="photo"><img src="https://www.hanagroup.com/images/Executives_2.%20Richard.png" alt="Mr. Richard David Han" loading="lazy" onerror="this.style.display='none'"></div>
      <span class="p-tag">กรรมการบริหาร</span>
      <h3 class="p-name">นายริชาร์ด เดวิด ฮัน</h3>
      <p class="p-role">กรรมการบริหาร</p>
    </article>
    <article class="person">
      <div class="photo"><img src="https://www.hanagroup.com/images/Executives_3.%20Terrence.png" alt="Mr. Terrence Philip Weir" loading="lazy" onerror="this.style.display='none'"></div>
      <span class="p-tag">กรรมการบริหาร</span>
      <h3 class="p-name">นายเทอร์เรนซ ฟิลิป เวียร์</h3>
      <p class="p-role">กรรมการบริหาร</p>
    </article>
    <article class="person">
      <div class="photo"><img src="https://www.hanagroup.com/images/Executives_4.%20Sanjay.png" alt="Mr. Sanjay Nirendra Mitra" loading="lazy" onerror="this.style.display='none'"></div>
      <span class="p-tag">กรรมการบริหาร</span>
      <h3 class="p-name">นายซานเจย์ นิเรนดรา มิตรา</h3>
      <p class="p-role">กรรมการบริหาร</p>
    </article>
    <article class="person">
      <div class="photo"><img src="https://www.hanagroup.com/images/Executives_5.%20%E0%B8%84%E0%B8%B8%E0%B8%93%20Insuk%20Kim.png" alt="Mr. Insuk Kim" loading="lazy" onerror="this.style.display='none'"></div>
      <span class="p-tag">กรรมการบริหาร</span>
      <h3 class="p-name">นายอินซุค คิม</h3>
      <p class="p-role">กรรมการบริหาร</p>
    </article>
    <article class="person">
      <div class="photo"><img src="https://www.hanagroup.com/images/Board_6.%20%E0%B8%84%E0%B8%B8%E0%B8%93%E0%B8%9E%E0%B8%A3%E0%B8%9E%E0%B8%B1%E0%B8%99%E0%B8%98%E0%B9%8C_.png" alt="Ms. Pornphan Abhamongkol" loading="lazy" onerror="this.style.display='none'"></div>
      <span class="p-tag">กรรมการอิสระ</span>
      <h3 class="p-name">นางสาวพรพันธ์ อาภามงคล</h3>
      <p class="p-role">กรรมการอิสระ</p>
    </article>
    <article class="person">
      <div class="photo"><img src="https://www.hanagroup.com/images/Board_7.%20%E0%B8%84%E0%B8%B8%E0%B8%93%E0%B8%AA%E0%B8%B8%E0%B8%99%E0%B8%B1%E0%B8%99%E0%B8%97%E0%B9%8C.png" alt="Mrs. Sunun Thongbai" loading="lazy" onerror="this.style.display='none'"></div>
