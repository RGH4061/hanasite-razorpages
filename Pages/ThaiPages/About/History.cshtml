@page "/th/about/history"
@{
    ViewData["Title"] = "ประวัติความเป็นมา";
    ViewData["Motion"] = "page";
    ViewData["Description"] = "จากโรงงานขนาดเล็กในกรุงเทพฯ สู่การดำเนินงานทั่วโลก ติดตามเรื่องราวและการเติบโตของ Hana ตั้งแต่จุดเริ่มต้นในการประกอบโมดูลนาฬิกา สู่การเป็นผู้ผลิตอุปกรณ์อิเล็กทรอนิกส์ชั้นนำ";
    ViewData["Canonical"] = "https://www.hanagroup.com/th/about/history";
    ViewData["Lang"] = "th";
    ViewData["AltLang"] = "en";
    ViewData["AltLangUrl"] = "/about/history";
}
@section Head {
    <link rel="stylesheet" href="~/css/about-history.css" />
    <link rel="stylesheet" href="~/css/about-history-th.css" />
    <link rel="alternate" hreflang="en" href="https://www.hanagroup.com/about/history" />
    <link rel="alternate" hreflang="th" href="https://www.hanagroup.com/th/about/history" />
    <link rel="alternate" hreflang="x-default" href="https://www.hanagroup.com/about/history" />
}

@* Thai — Our heritage. Thai from workbook 19 (8 Oct 2026). Card years and data-year are Buddhist era (CE + 543); data-decade keys stay CE for ~/js/about-heritage.js. *@

<!-- ── Heritage flow wrapper: hero + decade bar + timeline share one flow field ── -->
<div class="heritage-flow" data-hana-bg="flow" data-variant="light" data-accent="cyan" data-fade="none">

<!-- ── Hero band: breadcrumb + hero ── -->
<div class="hero-band hero-band--flow">
  <div class="subbar">
    <div class="subbar-inner">
      <nav class="crumbs" aria-label="เส้นทางการเข้าชม (Breadcrumb)">
        <a href="/">Home</a><span class="sep">/</span>
        <span class="nolink">เกี่ยวกับเรา</span><span class="sep">/</span>
        <span>ประวัติความเป็นมา</span>
      </nav>
      <div class="meta">ก่อตั้ง พ.ศ. 2521 · กรุงเทพฯ</div>
    </div>
  </div>

  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-title">เส้นทางของเรา
        <span class="hero-title-line"><span>จาก <span class="yr">2521</span></span><span class="arrow" aria-hidden="true"></span><span class="sr-only"> ถึง </span><span class="yr yr-now">2569</span></span>
      </h1>
      <p class="hero-summary">จากโรงงานขนาดเล็กในกรุงเทพฯ สู่การดำเนินงานทั่วโลก ติดตามเรื่องราวและการเติบโตของ Hana ตั้งแต่จุดเริ่มต้นในการประกอบโมดูลนาฬิกา สู่การเป็นผู้ผลิตอุปกรณ์อิเล็กทรอนิกส์ชั้นนำ</p>
      <div class="hero-cta">
        <a href="/capabilities" class="hana-btn hana-btn-primary">ดูขีดความสามารถของเรา</a>
        <a href="/locations" class="hana-btn hana-btn-secondary">ดูฐานการผลิตของเรา</a>
      </div>
    </div>
  </section>
</div>

<!-- ── Decade nav (shares the hero's flow field via .heritage-flow) ── -->
<div class="decade-stick-sentinel" aria-hidden="true" style="height:1px;"></div>
<nav class="decade-nav">
  <div class="decade-nav-inner">
    <button class="decade-chip is-active" data-decade="1970s">พ.ศ. 2513–2522</button>
    <button class="decade-chip" data-decade="1980s">พ.ศ. 2523–2532</button>
    <button class="decade-chip" data-decade="1990s">พ.ศ. 2533–2542</button>
    <button class="decade-chip" data-decade="2000s">พ.ศ. 2543–2552</button>
    <button class="decade-chip" data-decade="2010s">พ.ศ. 2553–2562</button>
    <button class="decade-chip" data-decade="2020s">พ.ศ. 2563–2572</button>
  </div>
</nav>

<!-- ── Horizontal timeline ── -->
<!-- ── Vertical timeline (replaces the horizontal track, 21 Oct 2026) ── -->
<section class="tl-v" id="timeline" aria-label="ลำดับเหตุการณ์ของ Hana พ.ศ. 2521 ถึง 2569">
  <div class="tl-v-inner">
    <section class="tl-decade" id="decade-1970s" data-decade="1970s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2513–2522</span><p class="tl-decade-sum">ก่อตั้งในกรุงเทพฯ ประกอบโมดูลนาฬิกา LED และ LCD</p></div></div>
      <ol class="tl-list">
        <li class="tl-item tl-item--feature" data-year="2521">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2521</span>
          <div class="tl-card"><h3 class="tl-headline">บ้านไม้บนถนนสีลม</h3><p class="tl-body">ก่อตั้งในกรุงเทพฯ ในนาม บริษัท มิเนอร์วา เทรดิ้ง จำกัด โดยใช้บ้านไม้ที่สีลม เขตบางรัก เป็นที่ตั้งสำนักงาน มีพนักงาน 30 คน ดำเนินธุรกิจประกอบ LED ที่ใช้เป็นส่วนประกอบภายในของนาฬิกาอิเล็กทรอนิกส์ ต่อมาเปลี่ยนชื่อเป็นบริษัท มิเนอร์วา อิเล็คโทรนิคส จำกัด และเป็นบริษัท ฮานา อินดัสตรีส จำกัด</p></div>
        </li>
        <li class="tl-item" data-year="2522">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2522</span>
          <div class="tl-card"><h3 class="tl-headline">สู่ส่วนประกอบนาฬิกา LCD</h3><p class="tl-body">นำเทคโนโลยี LCD (Liquid Crystal Display) มาใช้แทนที่ LED เพื่อผลิตส่วนประกอบภายในของนาฬิกาอิเล็กทรอนิกส์</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-1980s" data-decade="1980s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2523–2532</span><p class="tl-decade-sum">ผลิตกลไกนาฬิกาครบชุดเพื่อการส่งออก และก้าวแรกสู่การประกอบวงจรรวม</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="2525">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2525</span>
          <div class="tl-card"><h3 class="tl-headline">โรงงานสำหรับนาฬิกาสวิส</h3><p class="tl-body">ตั้งโรงงานที่ถนนนางลิ้นจี่ เริ่มผลิตแผงวงจรอิเล็กทรอนิกส์ (E-module) สำหรับกลไกนาฬิการะบบ Quartz Analog เพื่อส่งให้กลุ่มผู้ผลิตนาฬิกาสวิสรายใหญ่</p></div>
        </li>
        <li class="tl-item" data-year="2526">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2526</span>
          <div class="tl-card"><h3 class="tl-headline">เครื่องนาฬิกาครบชุด</h3><p class="tl-body">ขยายการผลิตจากโมดูลสู่การประกอบเครื่องนาฬิกา Quartz ครบชุด เพื่อส่งออกไปยังตลาดฮ่องกง</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2527">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2527</span>
          <div class="tl-card"><h3 class="tl-headline">ก้าวแรกสู่เซมิคอนดักเตอร์</h3><p class="tl-body">ก่อตั้งบริษัทย่อย บริษัท ฮานา เซมิคอนดักเตอร์ (กรุงเทพ) จำกัด เพื่อลงทุนในการประกอบ IC (Integrated Circuits) ซึ่งเป็นก้าวสู่การผลิตที่ใช้เทคโนโลยีขั้นสูง</p></div>
        </li>
        <li class="tl-item" data-year="2529">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2529</span>
          <div class="tl-card"><h3 class="tl-headline">ขยายการผลิตที่หลักสี่</h3><p class="tl-body">ย้ายสายการผลิต PCBA และการผลิตนาฬิกาจากโรงงานนางลิ้นจี่ไปที่โรงงานเขตหลักสี่ เพื่อรองรับการขยายการผลิต IC และก่อตั้งบริษัท ฮานา คอยล์ จำกัด เพื่อผลิตขดลวดไฟฟ้า</p></div>
        </li>
        <li class="tl-item" data-year="2531">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2531</span>
          <div class="tl-card"><h3 class="tl-headline">ชื่อใหม่ ทิศทางที่ชัดเจนขึ้น</h3><p class="tl-body">เปลี่ยนชื่อจาก “บริษัท ฮานา อินดัสตรีส จำกัด” เป็น “บริษัท ฮานา ไมโครอิเล็คโทรนิคส จำกัด” ย้ายสายการผลิตขดลวดไฟฟ้าจากเขตหลักสี่ไปยังโรงงานเขตสุทธิสาร และเริ่มสายการผลิต PCBA ที่โรงงานเขตหลักสี่</p></div>
        </li>
        <li class="tl-item" data-year="2532">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2532</span>
          <div class="tl-card"><h3 class="tl-headline">บริษัทย่อยด้านการค้า</h3><p class="tl-body">ก่อตั้งบริษัท ฮานา เทรดิ้ง จำกัด ดำเนินธุรกิจนำเข้านาฬิกาสำเร็จรูปจากฮ่องกง</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-1990s" data-decade="1990s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2533–2542</span><p class="tl-decade-sum">เข้าจดทะเบียนในตลาดหลักทรัพย์ฯ เปิดโรงงานใหม่ที่ลำพูนและอยุธยา และเริ่มดำเนินงานนอกประเทศไทย</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="2534">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2534</span>
          <div class="tl-card"><h3 class="tl-headline">รวมการผลิตไว้ที่หลักสี่</h3><p class="tl-body">ย้ายหน่วยการผลิต IC จากถนนนางลิ้นจี่มาที่โรงงานเขตหลักสี่ ทำให้งานเซมิคอนดักเตอร์อยู่ในที่ตั้งเดียวกัน ในปีถัดมาย้ายสำนักงานใหญ่จากสีลมมาที่หลักสี่ เพื่อรองรับการขยายธุรกิจด้านการทดสอบ (functional test) และหลักสี่เป็นที่ตั้งของ Hana มาจนถึงปัจจุบัน</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2536">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2536</span>
          <div class="tl-card"><h3 class="tl-headline">ลำพูน และการเข้าจดทะเบียนในตลาดหลักทรัพย์</h3><p class="tl-body">ย้ายสายงานการผลิต PCBA, COB และ Coil Winding ไปยังโรงงานแห่งใหม่ในเขตส่งออกนิคมอุตสาหกรรมภาคเหนือ จังหวัดลำพูน และจดทะเบียนกับตลาดหลักทรัพย์แห่งประเทศไทย พร้อมแปรสภาพเป็นบริษัท ฮานา ไมโครอิเล็คโทรนิคส จำกัด (มหาชน) ในปีถัดมาเริ่มการผลิต PCBA ที่โรงงานแห่งใหม่</p><figure class="tl-photo"><img src="/images/lamphun-facility.webp" alt="โรงงานลำพูนในปัจจุบัน" width="1600" height="558" loading="lazy" decoding="async"><figcaption>โรงงานลำพูนในปัจจุบัน</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2539">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2539</span>
          <div class="tl-card"><h3 class="tl-headline">การซื้อกิจการ และบริษัทย่อยในเซี่ยงไฮ้</h3><p class="tl-body">ซื้อกิจการบริษัท Swire Technologies Ltd. ร้อยละ 100 และเปลี่ยนชื่อเป็นบริษัท ฮานา เทคโนโลยี จำกัด พร้อมก่อตั้งบริษัท ฮานา ไมโครอิเล็คโทรนิคส จำกัด (เซี่ยงไฮ้) ซึ่งเป็นฐานการผลิตแห่งแรกในประเทศจีน</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2540">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2540</span>
          <div class="tl-card"><h3 class="tl-headline">โรงงาน IC แห่งใหม่ที่อยุธยา หลังเหตุอัคคีภัยที่กรุงเทพฯ</h3><p class="tl-body">โรงงานฮานา เซมิคอนดักเตอร์ที่กรุงเทพฯ ประสบอัคคีภัย ทรัพย์สินเสียหายประมาณ 300 ล้านบาท จึงย้ายสายการผลิต IC ไปที่นิคมอุตสาหกรรมไฮเทค อำเภอบางปะอิน จังหวัดพระนครศรีอยุธยา ซึ่งปัจจุบันยังเป็นที่ตั้งของการดำเนินงาน OSAT ของ Hana</p><figure class="tl-photo"><img src="/images/ayutthaya-facility.webp" alt="โรงงานอยุธยาในปัจจุบัน" width="1918" height="673" loading="lazy" decoding="async"><figcaption>โรงงานอยุธยาในปัจจุบัน</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2541">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2541</span>
          <div class="tl-card"><h3 class="tl-headline">การซื้อกิจการ Olin Interconnect Technologies</h3><p class="tl-body">ซื้อสินทรัพย์ร้อยละ 100 ของ Olin Interconnect Technologies ซึ่งเป็นหน่วยงานของ Olin Corporation ประเทศสหรัฐอเมริกา ผลิตชิ้นส่วนโลหะสำหรับอุตสาหกรรมเซมิคอนดักเตอร์ โดยจัดตั้งบริษัทย่อยใหม่ ใช้ชื่อว่า บริษัท แอดแวนซ์ อินเตอร์คอนเนค เทคโนโลยี จำกัด (AIT)</p></div>
        </li>
        <li class="tl-item" data-year="2542">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2542</span>
          <div class="tl-card"><h3 class="tl-headline">การควบรวมกับ AIT และก้าวสู่ไมโครดิสเพลย์</h3><p class="tl-body">บริษัท ฮานา เทคโนโลยี จำกัด ควบกิจการกับ AIT ซึ่งเป็นบริษัทผลิต IC มีโรงงานที่เมืองบาตัม ประเทศอินโดนีเซีย โดยถือหุ้นร้อยละ 43 ในบริษัท AIT และก่อตั้งบริษัท ฮานา ไมโครดิสเพลย์ เทคโนโลยี อิงค์ จำกัด ในสหรัฐอเมริกา เพื่อผลิตและประกอบอุปกรณ์ Liquid Crystal on Silicon (LCoS)</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-2000s" data-decade="2000s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2543–2552</span><p class="tl-decade-sum">เริ่มการผลิตที่เจียซิง ประเทศจีน และขยายโรงงานในประเทศไทย</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="2546">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2546</span>
          <div class="tl-card"><h3 class="tl-headline">บริษัทย่อยแห่งที่สองในจีน ที่เจียซิง</h3><p class="tl-body">ก่อตั้งบริษัท ฮานา ไมโครอิเล็คโทรนิคส (เจียซิง) จำกัด ในเขตส่งเสริมเศรษฐกิจในสามเหลี่ยมปากแม่น้ำแยงซีของประเทศจีน ห่างจากเซี่ยงไฮ้ไปทางตะวันตกเฉียงใต้ประมาณ 100 กิโลเมตร เป็นฐานการผลิตแห่งที่สองในประเทศจีนต่อจากเซี่ยงไฮ้</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2548">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2548</span>
          <div class="tl-card"><h3 class="tl-headline">เจียซิง ประเทศจีน เริ่มดำเนินการ</h3><p class="tl-body">เริ่มการผลิตที่เจียซิงทางภาคตะวันออกของประเทศจีน โดยมี PCBA และ IC เป็นผลิตภัณฑ์หลัก</p><figure class="tl-photo"><img src="/images/jiaxing-facility.webp" alt="โรงงานเจียซิงในปัจจุบัน" width="1274" height="474" loading="lazy" decoding="async"><figcaption>โรงงานเจียซิงในปัจจุบัน</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2550">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2550</span>
          <div class="tl-card"><h3 class="tl-headline">ลำพูนและอยุธยาขยายกำลังผลิต ขาย AIT</h3><p class="tl-body">ลำพูนสร้างอาคารเพิ่มขนาด 10,000 ตารางเมตร ทำให้พื้นที่การผลิตเพิ่มขึ้นกว่าร้อยละ 60 อยุธยาสร้างอาคาร 3,000 ตารางเมตรเพื่อเพิ่มกำลังผลิต และขาย AIT ให้แก่บริษัทยูนิเซม</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-2010s" data-decade="2010s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2553–2562</span><p class="tl-decade-sum">ฟื้นฟูหลังอุทกภัยปี 2554 เปิดโรงงานใหม่ในกัมพูชา และโรงงานแห่งที่สองที่ลำพูน</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="2554">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2554</span>
          <div class="tl-card"><h3 class="tl-headline">อุทกภัยในประเทศไทย</h3><p class="tl-body">บริษัท ฮานา เซมิคอนดักเตอร์ (อยุธยา) จำกัด ประสบอุทกภัยครั้งใหญ่ในช่วงต้นเดือนตุลาคม ทำให้ทรัพย์สินเสียหายและธุรกิจหยุดชะงักอย่างมีนัยสำคัญ ทีมงานร่วมกันฟื้นฟูการดำเนินงาน</p></div>
        </li>
        <li class="tl-item" data-year="2556">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2556</span>
          <div class="tl-card"><h3 class="tl-headline">บริษัทย่อยแห่งใหม่ในกัมพูชา</h3><p class="tl-body">ก่อตั้งบริษัท ฮานา ไมโครอิเล็คโทรนิคส (กัมพูชา) จำกัด ที่เขตเศรษฐกิจพิเศษเกาะกง จังหวัดเกาะกง เป็นจุดเริ่มต้นของฐานการผลิตแห่งที่สามของกลุ่มบริษัทในต่างประเทศ</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2557">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2557</span>
          <div class="tl-card"><h3 class="tl-headline">สำนักงานใหญ่แห่งใหม่ในกรุงเทพฯ</h3><p class="tl-body">ย้ายสำนักงานใหญ่ไปที่ซอยวิภาวดี-รังสิต 64 เขตหลักสี่ กรุงเทพมหานคร ซึ่งตั้งอยู่บนที่ดินที่เป็นกรรมสิทธิ์ของบริษัท และได้รับเงินงวดสุดท้ายจากการเรียกร้องค่าสินไหมทดแทนประกันภัยอุทกภัยในปีเดียวกัน</p><figure class="tl-photo"><img src="/images/photos/hp-hq-building.webp" alt="สำนักงานใหญ่ Hana กรุงเทพฯ" width="2090" height="775" loading="lazy" decoding="async"><figcaption>สำนักงานใหญ่กรุงเทพฯ ในปัจจุบัน</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2557">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2557</span>
          <div class="tl-card"><h3 class="tl-headline">สาขาที่สองที่ลำพูน</h3><p class="tl-body">ก่อตั้งสาขาที่ 2 ที่จังหวัดลำพูน (ลำพูน 2) และเริ่มดำเนินการในปีถัดมา</p><figure class="tl-photo"><img src="/images/history/lamphun-2.webp" alt="โรงงานลำพูน 2" width="1280" height="847" loading="lazy" decoding="async"><figcaption>โรงงานลำพูน 2</figcaption></figure></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2558">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2558</span>
          <div class="tl-card"><h3 class="tl-headline">โรงงานใหม่สองแห่งเปิดดำเนินการ</h3><p class="tl-body">ลำพูน 2 เริ่มดำเนินการผลิต IC และ PCBA ส่วนโรงงานที่กัมพูชาเริ่มดำเนินการในเดือนกันยายน โดยในช่วงแรกผลิตเครื่องอ่าน RFID สำหรับระบบควบคุมการเข้าออก และประกอบควอตซ์คริสตัล (quartz crystals)</p><figure class="tl-photo"><img src="/images/koh-kong-facility.webp" alt="โรงงานเกาะกงในปัจจุบัน" width="1600" height="493" loading="lazy" decoding="async"><figcaption>โรงงานเกาะกงในปัจจุบัน</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2560">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2560</span>
          <div class="tl-card"><h3 class="tl-headline">ขยายกำลังการผลิตในประเทศไทย</h3><p class="tl-body">ลำพูน 2 ขยายพื้นที่การผลิตชั้น 2 เพิ่มพื้นที่การผลิตเป็นสองเท่า อยุธยาสร้างคลังสินค้า 3 ชั้น พื้นที่ 2,600 ตารางเมตร เพื่อรองรับการขยายกำลังการผลิต</p></div>
        </li>
        <li class="tl-item" data-year="2560">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2560</span>
          <div class="tl-card"><h3 class="tl-headline">Power Master Semiconductor ในประเทศเกาหลี</h3><p class="tl-body">ก่อตั้งบริษัท เพาเวอร์ มาสเตอร์ เซมิคอนดักเตอร์ จำกัด (PMS) ซึ่งเป็นบริษัทย่อยของบริษัทฯ ตั้งอยู่ในประเทศเกาหลี เพื่อผลิตอุปกรณ์ IC Power Management ขยายฐานการผลิตของ Hana ไปยังประเทศเกาหลี</p></div>
        </li>
        <li class="tl-item" data-year="2561">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2561</span>
          <div class="tl-card"><h3 class="tl-headline">ลำพูน 2 ขยายกำลังผลิต และเปลี่ยนชื่อบริษัทในโอไฮโอ</h3><p class="tl-body">ลำพูน 2 ขยายพื้นที่การผลิตชั้น 2 เพิ่มอีก 6,000 ตารางเมตร บริษัทย่อยในรัฐโอไฮโอเปลี่ยนชื่อเป็นบริษัท ฮานา เทคโนโลยี อิงค์ จำกัด เพื่อเปิดโอกาสทางธุรกิจให้กว้างขึ้น สะท้อนถึงศักยภาพที่เพิ่มขึ้นของอุปกรณ์ LCoS และอุปกรณ์ RFID</p></div>
        </li>
        <li class="tl-item" data-year="2562">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2562</span>
          <div class="tl-card"><h3 class="tl-headline">โครงสร้างบริษัทย่อยที่กระชับขึ้น</h3><p class="tl-body">บริษัท ฮานา เทคโนโลยี กรุ๊ป จำกัด บริษัท ฮานา เทคโนโลยี อินเวสท์เมนท์ จำกัด และบริษัท ฮานา เซมิคอนดักเตอร์ โฮลดิ้ง จำกัด ซึ่งเป็นบริษัทย่อยที่ถือหุ้น จดทะเบียนเลิกกิจการ โดยไม่มีกำไรขาดทุนจากการลงทุนในบริษัทย่อยดังกล่าว</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-2020s" data-decade="2020s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2563–2572</span><p class="tl-decade-sum">ขยายการผลิตที่อยุธยาและโอไฮโอ และเริ่มธุรกิจผลิตอินเลย์ RFID</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="2563">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2563</span>
          <div class="tl-card"><h3 class="tl-headline">อยุธยาขยายอย่างต่อเนื่อง</h3><p class="tl-body">โรงงานอยุธยาขยายพื้นที่สำนักงานและพื้นที่การผลิต 6,650 ตารางเมตร เพื่อรองรับคำสั่งซื้อที่ขยายตัว</p></div>
        </li>
        <li class="tl-item" data-year="2564">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2564</span>
          <div class="tl-card"><h3 class="tl-headline">เข้าสู่ธุรกิจ RFID inlay แบบ OEM</h3><p class="tl-body">บริษัท ฮานา เทคโนโลยี อิงค์ จำกัด เริ่มธุรกิจรับจ้างผลิต (OEM) RFID inlay</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2566">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2566</span>
          <div class="tl-card"><h3 class="tl-headline">ที่ตั้งใหม่ที่ใหญ่ขึ้นในโอไฮโอ และการเพิ่มทุนของกลุ่ม Hana</h3><p class="tl-body">ขายหุ้นสามัญเพิ่มทุนแบบมอบอำนาจทั่วไป (General Mandate) ให้แก่บุคคลในวงจำกัด (Private Placement) จำนวน 80.48 ล้านหุ้น ได้รับเงินก่อนหักค่าใช้จ่าย 4.58 พันล้านบาท บริษัท ฮานา เทคโนโลยี อิงค์ จำกัด ย้ายโรงงานไปที่เมืองโซลอน รัฐโอไฮโอ ทำให้พื้นที่การผลิตเพิ่มเป็นสามเท่า</p><figure class="tl-photo"><img src="/images/ohio-facility.webp" alt="โรงงานโซลอน รัฐโอไฮโอ ในปัจจุบัน" width="1600" height="1072" loading="lazy" decoding="async"><figcaption>โรงงานโซลอน รัฐโอไฮโอ ในปัจจุบัน</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2567">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2567</span>
          <div class="tl-card"><h3 class="tl-headline">ลงทุนใน FT1 Corporation</h3><p class="tl-body">ทำสัญญาร่วมทุนกับบริษัท นิวเวอซอลล์ จำกัด บริษัทย่อยของบริษัท ปตท. จำกัด (มหาชน) เพื่อลงทุนในบริษัท เอฟทีวัน คอร์เปอเรชั่น จำกัด และลงทุนเพิ่ม 744.80 ล้านบาท คิดเป็นสัดส่วนการลงทุนร้อยละ 49 ส่วนโรงงานอยุธยาซื้อที่ดินและสิ่งปลูกสร้างข้างเคียงในราคา 86 ล้านบาท</p></div>
        </li>
        <li class="tl-item" data-year="2568">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2568</span>
          <div class="tl-card"><h3 class="tl-headline">ขายที่ดินในกัมพูชา</h3><p class="tl-body">ในเดือนกุมภาพันธ์ 2568 บริษัทขายที่ดินที่ถือครองไว้เพื่อพัฒนาเป็นหอพักพนักงานในประเทศกัมพูชา เป็นจำนวนเงิน 1.3 ล้านเหรียญสหรัฐ</p></div>
        </li>
      </ol>
    </section>
    <div class="tl-rail" aria-hidden="true"><div class="tl-rail-fill"></div></div>
  </div>
</section>

