@page "/th/investor-relations/faq"
@{
    // Results Presentations hidden (management, 27 Nov 2026) until the Q4/2026 recording is published.
    // To bring it back: set this to true, add the video, and rename the page "FAQ & Presentations" again
    // (H1, breadcrumb, intro, IR hub card and the IR sub-navigation links; see git history).
    const bool ShowPresentations = false;
    ViewData["Title"] = "คำถามที่พบบ่อยจากนักลงทุน";
    ViewData["Motion"] = "page";
    ViewData["Description"] = "คำถามที่พบบ่อยจากนักลงทุน HANA";
    ViewData["Canonical"] = "https://www.hanagroup.com/th/investor-relations/faq";
    ViewData["Lang"] = "th";
    ViewData["AltLang"] = "en";
    ViewData["AltLangUrl"] = "/investor-relations/faq";
}

@section Head {
    <link rel="stylesheet" href="~/css/investors-faq.css" asp-append-version="true" />
}






<div class="hero-band">
  <canvas id="hero-topo"></canvas>
  <div class="hero-overlay"></div>
  <div class="subbar">
    <div class="subbar-inner">
      <nav class="crumbs" aria-label="เส้นทางการเข้าชม (Breadcrumb)">
        <a href="/th">Home</a>
        <span class="sep">/</span>
        <a href="/th/investor-relations">นักลงทุนสัมพันธ์</a>
        <span class="sep">/</span>
        <span>คำถามที่พบบ่อย</span>
      </nav>
      <div class="meta">
        ข้อมูลล่าสุด <strong>12 มิถุนายน 2569</strong>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <h1>คำถามที่พบบ่อย</h1>
      <p class="lede">
        คำถามที่พบบ่อยเกี่ยวกับหุ้น เงินปันผล รายงานทางการเงิน และช่องทางติดต่อนักลงทุนสัมพันธ์
      </p>
    </div>
  </section>
</div>

  <!-- MAIN -->
  <div class="layout-bg">
  <div class="layout">
    <aside class="sectionnav" aria-label="On this page">
      <div class="label">On this page</div>
      @if (ShowPresentations)
      {
      <ol>
        <li>
          <a href="#presentations">
            <span class="num">1</span>
            <span>การนำเสนอผลประกอบการ</span>
            <span class="count">4</span>
          </a>
        </li>
      </ol>
      }
      <div class="navgroup">
        <div class="navgroup-label">คำถามที่พบบ่อยจากนักลงทุน</div>
        <ol class="subnav">
          <li>
            <a href="#shares-dividends">
              <span>หุ้นและนโยบายการจ่ายเงินปันผล</span>
              <span class="count">6</span>
            </a>
          </li>
          <li>
            <a href="#reporting">
              <span>การรายงานผลประกอบการและข้อมูลทางการเงิน</span>
              <span class="count">4</span>
            </a>
          </li>
          <li>
            <a href="#company-listing">
              <span>ข้อมูลบริษัทและการจดทะเบียน</span>
              <span class="count">4</span>
            </a>
          </li>
        </ol>
      </div>
      <div class="footer-link">
        <span class="footer-link-label">ดูเพิ่มเติม</span>
        <a href="/th/investor-relations/contact">กิจกรรมนักลงทุน</a>
        <a href="/th/investor-relations/news">ข่าวสารสำหรับนักลงทุน</a>
      </div>
    </aside>

    <main class="content">

      @if (ShowPresentations)
      {
      <text>
      <!-- ─── 1. Results Presentations (SET video slots) ─── -->
      <section class="doc" id="presentations">
        <header class="section-head">
          <h2>การนำเสนอผลประกอบการ</h2>
          <p class="intro">
            บันทึกการนำเสนอผลประกอบการ (SET Earnings Call)
          </p>
        </header>

        @* Results Presentations reset (management, 27 Nov 2026): every earlier recording was removed;
             the first recording on the new site is Q4/2026. Thai line is a draft for review.
             To publish it, swap the frame below for the featured video block used before this change
             (git history: button.frame.has-poster.yt-facade with data-yt = the YouTube ID, poster in
             images/ir/, the "Latest" pill and date in .vc-kind, and the SET link in .detail). *@
        <div class="feature feature--pending">
          <div class="feature-head">
            <div class="vc-kind"><span>Earnings Call</span></div>
            <h3>การนำเสนอผลประกอบการไตรมาส 4/2569</h3>
          </div>
          <div class="feature-grid">
            <div class="frame pending-frame">
              <p class="pending-text">บันทึกการนำเสนอจะเผยแพร่ที่นี่หลังการประชุม Earnings Call ไตรมาส 4/2569</p>
            </div>
          </div>
        </div>

        <p class="video-note">
          กิจกรรมที่กำลังจะมีขึ้นและการลงทะเบียนเข้าร่วม ได้ที่
          <a href="/th/investor-relations/contact" style="color:var(--hana-blue-deep);text-decoration:none;border-bottom:1px solid var(--line);">กิจกรรมนักลงทุน</a>
        </p>
      </section>
      </text>
      }

      <!-- ─── Group heading: Investor FAQs ─── -->
      <div class="grouphead" id="faqs">
        <div class="eyebrow">
          <span>คำถามที่พบบ่อย</span>
        </div>
        <h2>คำถามที่พบบ่อยจากนักลงทุนและข้อมูลทั่วไปของบริษัท</h2>
        <p class="intro">
          คำถามที่พบบ่อยแยกตามหัวข้อ หากต้องการข้อมูลเพิ่มเติม กรุณาติดต่อนักลงทุนสัมพันธ์
        </p>
      </div>

      <!-- ─── 2. Shares & Dividends ─── -->
            <section class="doc" id="shares-dividends">
        <header class="section-head">
          <h2>หุ้นและนโยบายการจ่ายเงินปันผล</h2>
          <p class="intro">
            ข้อมูลเกี่ยวกับบริษัทจดทะเบียน การซื้อขายหุ้น และนโยบายการจ่ายเงินปันผลของ Hana
          </p>
        </header>

        <div class="faqgroup">
          <details class="faq">
            <summary><span class="q">Hana Microelectronics จดทะเบียนในตลาดหลักทรัพย์ใด?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana จดทะเบียนในตลาดหลักทรัพย์แห่งประเทศไทย ภายใต้ชื่อย่อหลักทรัพย์ <strong>HANA</strong> และซื้อขายหุ้นในสกุลเงินบาท (THB)</p>
              <dl class="faq-dl">
                <div><dt>ชื่อ</dt><dd>บริษัท ฮานา ไมโครอิเล็คโทรนิคส จำกัด (มหาชน)</dd></div>
                <div><dt>ชื่อย่อหุ้น</dt><dd><strong>HANA</strong></dd></div>
                <div><dt>ตลาดทุน</dt><dd>ตลาดหลักทรัพย์แห่งประเทศไทย</dd></div>
                <div><dt>เลขที่ทะเบียนบริษัท</dt><dd>0107536000773</dd></div>
              </dl>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">รายละเอียดทุนและมูลค่าหุ้นที่ตราไว้ของ Hana</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <dl class="faq-dl">
                <div><dt>ทุนจดทะเบียน</dt><dd>หุ้นสามัญ 885,366,746 หุ้น มูลค่าหุ้นละ 1.00 บาท</dd></div>
                <div><dt>ทุนเรียกชำระแล้ว</dt><dd>หุ้นสามัญ 885,366,660 หุ้น มูลค่าหุ้นละ 1.00 บาท</dd></div>
                <div><dt>มูลค่าราคาพาร์</dt><dd>1.00 บาทต่อหุ้น</dd></div>
              </dl>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">นโยบายการจ่ายเงินปันผลของ Hana</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>บริษัทมีนโยบายการจ่ายเงินปันผลให้แก่ผู้ถือหุ้นในอัตราไม่น้อยกว่าร้อยละ 30 ของกำไรสุทธิตามงบการเงินรวม หลังหักภาษีเงินได้นิติบุคคลและการจัดสรรสำรองตามกฎหมาย ทั้งนี้ การจ่ายเงินปันผลที่แท้จริงจะขึ้นอยู่กับผลการดำเนินงาน ฐานะทางการเงิน กระแสเงินสด แผนการลงทุน และปัจจัยอื่น ๆ ตามที่คณะกรรมการบริษัทเห็นสมควร และต้องเป็นไปตามกฎหมายและกฎเกณฑ์ที่เกี่ยวข้อง โดยอัตราการจ่ายเงินปันผลดังกล่าวอาจต่ำกว่าหรือสูงกว่าอัตราข้างต้น และอาจเกินกว่าร้อยละ 100 ของกำไรสุทธิรวมได้ตามที่คณะกรรมการบริษัทเห็นสมควร</p>
              <p>ส่วนบริษัทย่อยมีนโยบายการจ่ายเงินปันผลให้แก่บริษัท โดยพิจารณาจากผลการดำเนินงาน ฐานะทางการเงิน กระแสเงินสด แผนการลงทุน และความจำเป็นทางธุรกิจ ตามที่คณะกรรมการของบริษัทย่อยแต่ละแห่งเห็นสมควร และเป็นไปตามกฎหมายและกฎเกณฑ์ที่เกี่ยวข้อง</p>
              <p>สามารถศึกษาข้อมูลการจ่ายเงินปันผลย้อนหลังได้ที่หัวข้อ<a href="#dividend-history" data-open-faq>ประวัติการจ่ายเงินปันผล</a>ด้านล่าง</p>
            </div>
          </details>
          <details class="faq" id="dividend-history">
            <summary><span class="q">ประวัติการจ่ายเงินปันผล</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>ข้อมูลกำไรต่อหุ้นและเงินปันผลย้อนหลัง 10 ปี ที่เผยแพร่ผ่านตลาดหลักทรัพย์แห่งประเทศไทยและบนเว็บไซต์ของบริษัทในหมวด<a href="/th/investor-relations/news">ข่าวสาร สำหรับนักลงทุน</a></p>
              <div class="divtable-wrap">
                <table class="divtable">
                  <caption class="sr-only">ประวัติการจ่ายเงินปันผล ปี 2559 ถึง 2568</caption>
                  <thead><tr><th scope="col">ปี</th><th scope="col">EPS</th><th scope="col">เงินปันผล<br>ระหว่างกาล<br>(บาท/หุ้น)</th><th scope="col">เงินปันผล<br>ประจำปี<br>(บาท/หุ้น)</th><th scope="col">เงินปันผล<br>ทั้งหมด<br>(บาท/หุ้น)</th><th scope="col">อัตรา<br>เงินปันผล<br>(ร้อยละ)</th></tr></thead>
                  <tbody>
                  <tr><th scope="row">2568</th><td>0.76</td><td>0.25</td><td>0.75</td><td>1.00</td><td>132</td></tr>
                  <tr><th scope="row">2567</th><td>(0.72)</td><td>0.25</td><td>0.50</td><td>0.75</td><td>0*</td></tr>
                  <tr><th scope="row">2566</th><td>2.14</td><td>0.50</td><td>0.50</td><td>1.00</td><td>47</td></tr>
                  <tr><th scope="row">2565</th><td>2.61</td><td>0.50</td><td>0.50</td><td>1.00</td><td>38</td></tr>
                  <tr><th scope="row">2564</th><td>1.92</td><td>1.00</td><td>1.00</td><td>2.00</td><td>104</td></tr>
                  <tr><th scope="row">2563</th><td>2.37</td><td>0.65</td><td>0.75</td><td>1.40</td><td>59</td></tr>
                  <tr><th scope="row">2562</th><td>2.24</td><td>0.65</td><td>0.65</td><td>1.30</td><td>58</td></tr>
                  <tr><th scope="row">2561</th><td>2.95</td><td>1.00</td><td>1.00</td><td>2.00</td><td>68</td></tr>
                  <tr><th scope="row">2560</th><td>3.59</td><td>1.00</td><td>1.00</td><td>2.00</td><td>56</td></tr>
                  <tr><th scope="row">2559</th><td>2.62</td><td>1.00</td><td>1.00</td><td>2.00</td><td>76</td></tr>
                  </tbody>
                </table>
              </div>
              <p class="divnote" lang="th">หมายเหตุ: *เนื่องจากกำไรต่อหุ้นติดลบ จึงแสดงอัตราการจ่ายเงินปันผลเป็น 0% เพื่อการนำเสนอข้อมูลเท่านั้น</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">กำหนดการจ่ายเงินปันผลของ Hana</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>บริษัทจะพิจารณาการจ่ายเงินปันผลพร้อมกับประกาศผลประกอบการประจำปี และดำเนินการขออนุมัติจากที่ประชุมสามัญผู้ถือหุ้นประจำปี (AGM) โดยกำหนดการจ่ายจะเป็นไปตามวันที่ประกาศต่อตลาดหลักทรัพย์แห่งประเทศไทย ทั้งนี้ หากมีการจ่ายเงินปันผลระหว่างกาล จะมีการประกาศเป็นกรณีไป</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">Hana มีนโยบายนำเงินปันผลกลับมาลงทุนหรือไม่?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>ปัจจุบัน Hana ยังไม่มีนโยบายนำเงินปันผลกลับไปลงทุนต่อโดยอัตโนมัติ (Dividend Reinvestment Plan: DRIP) โดยเงินปันผลจะจ่ายเป็นเงินสดให้แก่ผู้ถือหุ้นที่มีชื่ออยู่ในทะเบียนผู้ถือหุ้นเท่านั้น</p>
            </div>
          </details>
        </div>
      </section>

      <!-- ─── 3. Financial Reporting ─── -->
      <section class="doc" id="reporting">
        <header class="section-head">
          <h2>การรายงานผลประกอบการและข้อมูลทางการเงิน</h2>
          <p class="intro">
            ข้อมูลรอบระยะเวลาบัญชี การรายงานผลประกอบการ และแหล่งข้อมูลทางการเงินของ Hana
          </p>
        </header>

        <div class="faqgroup">
          <details class="faq">
            <summary><span class="q">Hana กำหนดรอบระยะเวลาบัญชีอย่างไร?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana กำหนดรอบปีบัญชีตั้งแต่วันที่ 1 มกราคม ถึง 31 ธันวาคม และเปิดเผยผลประกอบการเป็นรายไตรมาส ตามหลักเกณฑ์ของตลาดหลักทรัพย์แห่งประเทศไทย</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">Hana กำหนดการรายงานผลประกอบการเมื่อใด?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana เผยแพร่งบการเงินเป็นรายไตรมาสพร้อมคำอธิบายและวิเคราะห์ของฝ่ายจัดการ (MD&amp;A) รวมถึงรายงานประจำปี (แบบ 56-1 One Report) โดยจะเผยแพร่ข้อมูลดังกล่าวผ่านตลาดหลักทรัพย์แห่งประเทศไทย และบนเว็บไซต์ของบริษัทในหน้านักลงทุนสัมพันธ์</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">สามารถค้นหารายงานประจำปีและงบการเงินของ Hana ได้จากที่ใด?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>รายงานประจำปีฉบับล่าสุด (56-1 One Report) อยู่ใน<a href="/th/investor-relations/annual">หมวดรายงานประจำปี</a> งบการเงินรายไตรมาสและคำอธิบายและวิเคราะห์ของฝ่ายจัดการ (MD&amp;A) อยู่ใน<a href="/th/investor-relations/news">หมวดข่าวสารสำหรับนักลงทุน</a>@if (ShowPresentations) {<text> ส่วนการนำเสนอผลประกอบการอยู่ในหมวดคำถามที่พบบ่อย ในส่วน<a href="#presentations">การนำเสนอผลประกอบการ</a></text>}</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">สามารถติดตามข่าวสารและประกาศของ Hana ที่เผยแพร่ต่อตลาดหลักทรัพย์แห่งประเทศไทยได้อย่างไร?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>สามารถติดตามประกาศและข้อมูลที่เผยแพร่ของบริษัทผ่านตลาดหลักทรัพย์แห่งประเทศไทย และเว็บไซต์ของบริษัทใน<a href="/th/investor-relations/news">หมวดข่าวสารสำหรับนักลงทุน</a> ในรูปแบบไฟล์ที่สามารถดาวน์โหลดได้ โดยจัดเรียงตามปี</p>
            </div>
          </details>
        </div>
      </section>

      <!-- ─── 4. Company & Listing ─── -->
      <section class="doc" id="company-listing">
        <header class="section-head">
          <h2>ข้อมูลบริษัทและการจดทะเบียน</h2>
          <p class="intro">
