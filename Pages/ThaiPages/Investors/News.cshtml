@section Scripts {
    <script src="~/js/investors-bg.js"></script>
    <script>
  // Year selector — filters every section to the chosen year
  (function(){
  const yearBtns = Array.from(document.querySelectorAll('.yr-btn'));
  const tables = Array.from(document.querySelectorAll('.yr-table'));
  const yiYear = document.getElementById('yiYear');
  const secCounts = Array.from(document.querySelectorAll('[data-sec-count]'));
  function updateSectionCounts(){
    secCounts.forEach(function(span){
      const active = document.querySelector('#' + span.dataset.secCount + ' .yr-table.active');
      span.textContent = active ? active.querySelectorAll('tbody tr').length : '0';
    });
  }
  function selectYear(year){
    yearBtns.forEach(function(b){ b.classList.toggle('active', b.dataset.year === year); });
    tables.forEach(function(t){ t.classList.toggle('active', t.dataset.year === year); });
    if (yiYear) yiYear.textContent = year;
    updateSectionCounts();
  }
  yearBtns.forEach(function(b){ b.addEventListener('click', function(){ selectYear(b.dataset.year); }); });
  updateSectionCounts();
  })();
</script>
}
