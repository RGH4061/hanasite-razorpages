          <div class="contact-card">
            <div class="role">ฝ่ายกิจการองค์กร</div>
            <p class="cname">Ms. Jirapa Kongmanee</p>
            <dl>
              <dt>อีเมล</dt>
              <dd><a href="mailto:jirapak@@hanabk.th.com">jirapak@@hanabk.th.com</a></dd>
              <dt>Tel</dt>
