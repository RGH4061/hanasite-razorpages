@page "/th/contact"
@{
    ViewData["Title"] = "ติดต่อเรา | พูดคุยกับทีมงาน Hana";
    ViewData["Motion"] = "page";
    ViewData["Description"] = "ส่งอีเมลถึง Hana Microelectronics เพื่อสอบถามเรื่องโครงการผลิต ใบเสนอราคา หรือคำถามด้านเทคนิค หรือติดต่อฝ่ายนักลงทุนสัมพันธ์ ฝ่ายทรัพยากรบุคคล และฝ่ายจัดซื้อ";
    ViewData["Canonical"] = "https://www.hanagroup.com/th/contact";
    ViewData["Lang"] = "th";
    ViewData["AltLang"] = "en";
    ViewData["AltLangUrl"] = "/contact";

    var salesEmail = "info-request@hanaus.com";
    var salesSubject = "Manufacturing inquiry for Hana Microelectronics Group";
    var salesMailto = "mailto:" + salesEmail + "?subject=" + Uri.EscapeDataString(salesSubject);
    // value = English name (what the backend receives), label = Thai
    var countries = new (string Value, string Label)[] {
        ("United Kingdom","สหราชอาณาจักร"), ("Germany","เยอรมนี"), ("France","ฝรั่งเศส"), ("Netherlands","เนเธอร์แลนด์"),
        ("Sweden","สวีเดน"), ("Norway","นอร์เวย์"), ("Denmark","เดนมาร์ก"), ("Finland","ฟินแลนด์"),
        ("Belgium","เบลเยียม"), ("Switzerland","สวิตเซอร์แลนด์"), ("Austria","ออสเตรีย"), ("Italy","อิตาลี"),
        ("Spain","สเปน"), ("Portugal","โปรตุเกส"), ("Poland","โปแลนด์"), ("Czech Republic","สาธารณรัฐเช็ก"),
        ("Ireland","ไอร์แลนด์"), ("United States","สหรัฐอเมริกา"), ("Canada","แคนาดา"), ("Mexico","เม็กซิโก"),
        ("Thailand","ไทย"), ("China","จีน"), ("Japan","ญี่ปุ่น"), ("South Korea","เกาหลีใต้"),
        ("Taiwan","ไต้หวัน"), ("Singapore","สิงคโปร์"), ("Malaysia","มาเลเซีย"), ("Vietnam","เวียดนาม"),
        ("India","อินเดีย"), ("Other","อื่น ๆ")
    };
}
@section Head {
    <link rel="stylesheet" href="~/css/contact-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contact-hub.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contact-forms-th.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contact-hub-th.css" asp-append-version="true" />
}

@* Contact (Thai) — same layout as /contact (Nov 2026 email-first redesign).
   Thai text: lines carried over from the previous Thai page are unchanged; new lines are
   drafts for Thai review. Names, addresses, phone numbers, job titles and the mailto
   subject stay in English. Fonts: contact-forms-th.css + contact-hub-th.css. *@

<div class="cf-page">
  @* ── 1. Split hero: sales email card on the right ─────── *@
  <section class="cf-hero ch-hero" id="sales" data-hana-bg="pcb" data-variant="dark" data-accent="cyan" data-fade="left" style="background:var(--hana-blue-deep);">
    <div class="cf-hero-inner ch-hero-inner">
      <div class="ch-hero-text">
        <h1 style="color:#fff;">พูดคุยกับทีมงาน Hana</h1>
        <p class="cf-hero-sub" style="color:rgba(229,238,245,0.72);">หากมีคำถามด้านการผลิต ใบเสนอราคา หรือคำถามด้านเทคนิค โปรดส่งอีเมลถึงทีมขายของเรา เราจะตอบกลับภายใน 2 วันทำการ</p>
      </div>
      <div class="ch-email-card">
        <p class="ch-label">ฝ่ายขายและคำถามด้านเทคนิค</p>
        <h2>ส่งอีเมลถึงทีมขาย</h2>
        <a class="ch-email-address" href="@salesMailto">@salesEmail</a>
        <div class="ch-email-actions">
          <a class="ch-btn ch-btn-primary" href="@salesMailto">เขียนอีเมล</a>
          <button type="button" class="ch-btn ch-btn-ghost" data-copy="@salesEmail">คัดลอกอีเมล</button>
        </div>
        <p class="ch-include"><span class="ch-include-label">ข้อมูลที่ควรระบุในอีเมล:</span> ข้อมูลบริษัท เว็บไซต์ ผลิตภัณฑ์ที่คุณผลิต ปริมาณการผลิตต่อปี รายการวัสดุ (BOM) และไฟล์ออกแบบ เช่น ไฟล์ Gerber แบบเขียน (drawings) หรือข้อกำหนดการทดสอบ (test specifications)</p>
      </div>
    </div>
  </section>

  @* ── 2. Contact bar: offices box left, other inquiries right (under the email card) ── *@
  <section class="ch-contact-bar" data-hana-bg="wafer" data-variant="light" data-accent="" data-fade="none" style="background:linear-gradient(120deg,#f6f8fb 40%,#e6eef6 100%);">
    <div class="cf-wrap">
      <div class="ch-bar-grid">
        <div class="ch-offices-box">
          <p class="cf-offices-label" style="margin-top:0;">สำนักงานใหญ่</p>
          <div class="ch-hq">
            <figure class="cf-hq-photo"><img src="/images/Hana_bkk.webp" alt="Hana Microelectronics head office, Bangkok, Thailand" loading="lazy"></figure>
            <div>
              <div class="cf-hq-name">Hana Microelectronics Public Company Limited</div>
              <address class="cf-hq-addr">65/98 Soi Vibhavadi-Rangsit 64 Junction 2, Kwang Talad Bangkhen, Khet Laksi, Bangkok 10210, Thailand</address>
              <a class="ch-map-link" href="https://maps.app.goo.gl/S8Sq7kQE9aFxt6JK7" target="_blank" rel="noopener noreferrer">ตำแหน่งบน Google Maps <span aria-hidden="true">↗</span></a>
              <div class="cf-hq-lines"><a href="tel:+6625511297">+66-2-551-1297-8</a><a href="tel:+6625214935">+66-2-521-4935-9</a></div>
            </div>
          </div>
          <div class="ch-regional">
            <p class="cf-offices-label" style="margin-top:0;">สำนักงานขายประจำภูมิภาค</p>
            <div class="cf-accordion">
            <details class="cf-acc-item">
              <summary class="cf-acc-header"><span class="cf-acc-region">USA <span class="cf-acc-count">สำนักงาน 2 แห่ง</span></span><span class="cf-acc-chevron"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
              <div class="cf-acc-body">
                <div class="cf-office"><div class="cf-office-name">Hana Microelectronics, Inc.</div><div class="cf-office-person">Sanjay Mitra — President</div><div class="cf-office-addr">5255 Stevens Creek Blvd. #122, Santa Clara, CA 95051</div><div class="cf-office-contacts"><a href="tel:+14084527474">+1 (408) 452-7474</a></div></div>
                <div class="cf-office"><div class="cf-office-name">Hana Technologies, Inc.</div><div class="cf-office-addr">29000 Aurora Road, Solon, OH 44139</div><div class="cf-office-contacts"><a href="tel:+13304054600">+1 330 405 4600</a></div></div>
              </div>
            </details>
            <details class="cf-acc-item">
              <summary class="cf-acc-header"><span class="cf-acc-region">ยุโรป <span class="cf-acc-count">สำนักงาน 3 แห่ง</span></span><span class="cf-acc-chevron"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
              <div class="cf-acc-body">
                <div class="cf-office"><div class="cf-office-name">สหราชอาณาจักรและยุโรป</div><div class="cf-office-person">Rupert Han</div><div class="cf-office-contacts"><a href="mailto:rupert@@hanabk.th.com">rupert@@hanabk.th.com</a></div></div>
                <div class="cf-office"><div class="cf-office-name">ฝรั่งเศส</div><div class="cf-office-person">Mortar Feddal</div><div class="cf-office-contacts"><a href="tel:+33617721068">+33 6 17 72 10 68</a></div></div>
                <div class="cf-office"><div class="cf-office-name">เยอรมนี</div><div class="cf-office-person">Frank Böhme</div><div class="cf-office-addr">Schwatlostraße 4, 12207 Berlin</div><div class="cf-office-contacts"><a href="tel:+491723830507">+49 172 3830507</a></div></div>
              </div>
            </details>
            <details class="cf-acc-item">
              <summary class="cf-acc-header"><span class="cf-acc-region">Asia <span class="cf-acc-count">สำนักงาน 2 แห่ง</span></span><span class="cf-acc-chevron"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
              <div class="cf-acc-body">
                <div class="cf-office"><div class="cf-office-name">ฟิลิปปินส์</div><div class="cf-office-person">Edward Policarpio Fontanilla</div><div class="cf-office-contacts"><a href="mailto:EdwardF@@ayt.hanabk.th.com">EdwardF@@ayt.hanabk.th.com</a></div></div>
                <div class="cf-office"><div class="cf-office-name">สิงคโปร์</div><div class="cf-office-person">SR Chok</div><div class="cf-office-contacts"><a href="tel:+6596922682">+65 9692 2682</a></div></div>
              </div>
            </details>
          </div>
          </div>
        </div>
        <div class="ch-inquiries" id="other-inquiries">
      <div class="ch-tabs" data-tabs>
        <h2 class="ch-h2">สอบถามเรื่องอื่น ๆ</h2>
        <div class="ch-tablist" role="tablist" aria-label="หัวข้อที่ต้องการสอบถาม">
          <button type="button" role="tab" id="tab-ir" aria-controls="investor-relations" aria-selected="true">นักลงทุน</button>
          <button type="button" role="tab" id="tab-careers" aria-controls="careers" aria-selected="false" tabindex="-1">ร่วมงานกับเรา</button>
          <button type="button" role="tab" id="tab-suppliers" aria-controls="suppliers" aria-selected="false" tabindex="-1">ซัพพลายเออร์</button>
          <button type="button" role="tab" id="tab-other" aria-controls="other" aria-selected="false" tabindex="-1">อื่น ๆ</button>
          <button type="button" role="tab" id="tab-anon" aria-controls="anonymous-reporting" aria-selected="false" tabindex="-1">ร้องเรียน</button>
        </div>

        @* Investor relations *@
        <div class="ch-panel cf-card" role="tabpanel" id="investor-relations" aria-labelledby="tab-ir">
          <div class="cf-success" hidden><div class="cf-success-mark"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></div><h3>ส่งข้อความแล้ว</h3><p>ข้อความของคุณถูกส่งไปยังฝ่ายนักลงทุนสัมพันธ์แล้ว</p></div>
          <form class="cf-form" method="post" novalidate data-route="investor-relations">
            <p class="ch-panel-intro">สำหรับคำถามเกี่ยวกับผลการดำเนินงาน เรื่องของผู้ถือหุ้น หรือการนัดประชุมกับนักวิเคราะห์ ดูรายชื่อผู้ติดต่อฝ่ายนักลงทุนสัมพันธ์และปฏิทินกิจกรรมได้ที่หน้า <a href="/th/investor-relations/contact">ข่าวสารและข้อมูลติดต่อสำหรับนักลงทุน</a></p>
            <div class="cf-row two">
              <div class="cf-field"><label for="ir-name"><span class="req">*</span>ชื่อ</label><input type="text" id="ir-name" name="ir-name" autocomplete="name" required></div>
              <div class="cf-field"><label for="ir-email"><span class="req">*</span>อีเมล</label><input type="email" id="ir-email" name="ir-email" autocomplete="email" placeholder="you@@company.com" required></div>
            </div>
            <div class="cf-row two">
              <div class="cf-field"><label for="ir-org">องค์กร <span class="hint">(ไม่บังคับ)</span></label><input type="text" id="ir-org" name="ir-org" autocomplete="organization"></div>
              <div class="cf-field"><label for="ir-type"><span class="req">*</span>ประเภทผู้ติดต่อ</label>
                <select id="ir-type" name="ir-type" required>
                  <option value="" disabled selected>เลือก 1 รายการ</option>
                  <option value="An individual shareholder">ผู้ถือหุ้นรายย่อย</option>
                  <option value="An institutional investor">นักลงทุนสถาบัน</option>
                  <option value="An analyst">นักวิเคราะห์</option>
                  <option value="A journalist">สื่อมวลชน</option>
                  <option value="Other">อื่น ๆ</option>
                </select></div>
            </div>
            <div class="cf-row one"><div class="cf-field"><label for="ir-message"><span class="req">*</span>ข้อความ</label><textarea id="ir-message" name="ir-message" required></textarea></div></div>
            <div class="cf-submit-area"><div class="cf-recaptcha"><input type="checkbox" id="cf-rc-ir"><label for="cf-rc-ir" class="rc-label">ฉันไม่ใช่โปรแกรมอัตโนมัติ</label><div class="rc-logo"><span class="rc-text">reCAPTCHA<br>นโยบายความเป็นส่วนตัว &middot; ข้อกำหนดการใช้งาน</span></div></div><button type="submit" class="cf-btn-submit" disabled style="opacity:0.5;cursor:not-allowed;">ส่งข้อความ</button></div>
            <div class="cf-privacy">เราใช้ข้อมูลของคุณเพื่อตอบกลับคำถามของคุณเท่านั้น และจะไม่เปิดเผยข้อมูลให้แก่บุคคลภายนอก</div>
          </form>
        </div>

        @* Careers *@
        <div class="ch-panel cf-card" role="tabpanel" id="careers" aria-labelledby="tab-careers">
          <div class="cf-success" hidden><div class="cf-success-mark"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></div><h3>ส่งข้อความแล้ว</h3><p>ข้อความของคุณถูกส่งไปยังฝ่ายทรัพยากรบุคคลแล้ว</p></div>
          <form class="cf-form" method="post" novalidate data-route="careers">
            <p class="ch-panel-intro">สำหรับคำถามทั่วไปเกี่ยวกับการทำงานกับ Hana หากต้องการสมัครงาน โปรดใช้แบบฟอร์มในประกาศรับสมัครงานที่หน้า <a href="/th/careers">ร่วมงานกับเรา</a></p>
            <div class="cf-row two">
              <div class="cf-field"><label for="ca-name"><span class="req">*</span>ชื่อ</label><input type="text" id="ca-name" name="ca-name" autocomplete="name" required></div>
              <div class="cf-field"><label for="ca-email"><span class="req">*</span>อีเมล</label><input type="email" id="ca-email" name="ca-email" autocomplete="email" placeholder="you@@example.com" required></div>
            </div>
            <div class="cf-row two">
              <div class="cf-field"><label for="ca-phone">โทรศัพท์ <span class="hint">(ไม่บังคับ)</span></label><input type="tel" id="ca-phone" name="ca-phone" autocomplete="tel"></div>
              <div class="cf-field"><label for="ca-site">สถานที่ทำงานที่สนใจ</label>
                <select id="ca-site" name="ca-site">
                  <option value="" disabled selected>เลือก 1 รายการ</option>
                  <option value="Thailand — Ayutthaya">ไทย — อยุธยา</option>
                  <option value="Thailand — Lamphun">ไทย — ลำพูน</option>
                  <option value="China — Jiaxing">จีน — เจียซิง</option>
                  <option value="Cambodia — Koh Kong">กัมพูชา — เกาะกง</option>
                  <option value="USA — Ohio">สหรัฐอเมริกา — โอไฮโอ</option>
                  <option value="Not sure yet">ยังไม่แน่ใจ</option>
                </select></div>
            </div>
            <div class="cf-row one"><div class="cf-field"><label for="ca-message"><span class="req">*</span>ข้อความ</label><textarea id="ca-message" name="ca-message" required></textarea></div></div>
            <div class="cf-submit-area"><div class="cf-recaptcha"><input type="checkbox" id="cf-rc-ca"><label for="cf-rc-ca" class="rc-label">ฉันไม่ใช่โปรแกรมอัตโนมัติ</label><div class="rc-logo"><span class="rc-text">reCAPTCHA<br>นโยบายความเป็นส่วนตัว &middot; ข้อกำหนดการใช้งาน</span></div></div><button type="submit" class="cf-btn-submit" disabled style="opacity:0.5;cursor:not-allowed;">ส่งข้อความ</button></div>
            <div class="cf-privacy">เราใช้ข้อมูลของคุณเพื่อตอบกลับคำถามของคุณเท่านั้น และจะไม่เปิดเผยข้อมูลให้แก่บุคคลภายนอก</div>
          </form>
        </div>

        @* Suppliers *@
        <div class="ch-panel cf-card" role="tabpanel" id="suppliers" aria-labelledby="tab-suppliers">
          <div class="cf-success" hidden><div class="cf-success-mark"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></div><h3>ส่งข้อความแล้ว</h3><p>ข้อความของคุณถูกส่งไปยังฝ่ายจัดซื้อแล้ว</p></div>
          <form class="cf-form" method="post" novalidate data-route="suppliers">
            <p class="ch-panel-intro">สำหรับบริษัทที่ต้องการนำเสนอวัสดุ ชิ้นส่วน อุปกรณ์ หรือบริการให้แก่ Hana</p>
            <div class="cf-row two">
              <div class="cf-field"><label for="su-company"><span class="req">*</span>บริษัท</label><input type="text" id="su-company" name="su-company" autocomplete="organization" required></div>
              <div class="cf-field"><label for="su-name"><span class="req">*</span>ชื่อ</label><input type="text" id="su-name" name="su-name" autocomplete="name" required></div>
            </div>
            <div class="cf-row two">
              <div class="cf-field"><label for="su-email"><span class="req">*</span>อีเมล</label><input type="email" id="su-email" name="su-email" autocomplete="email" placeholder="you@@company.com" required></div>
              <div class="cf-field"><label for="su-country"><span class="req">*</span>ประเทศ</label>
                <select id="su-country" name="su-country" required>
                  <option value="" disabled selected>เลือกประเทศ</option>
                  @foreach (var c in countries) { <option value="@c.Value">@c.Label</option> }
                </select></div>
            </div>
            <div class="cf-row one"><div class="cf-field"><label for="su-supply"><span class="req">*</span>สินค้าหรือบริการที่คุณจัดหา</label><input type="text" id="su-supply" name="su-supply" placeholder="เช่น SMT stencil, test fixture, บรรจุภัณฑ์" required></div></div>
            <div class="cf-row one"><div class="cf-field"><label for="su-message"><span class="req">*</span>ข้อความ</label><textarea id="su-message" name="su-message" required></textarea></div></div>
            <div class="cf-row one" style="margin-bottom:0;">
              <div class="cf-field" style="margin-bottom:0;">
                <label>ข้อมูลบริษัทหรือรายการสินค้า <span class="hint">(ไม่บังคับ)</span></label>
                <div class="cf-upload">
                  <input type="file" name="su-files" accept=".pdf" multiple>
                  <span class="cf-upload-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg></span>
                  <div class="cf-upload-text"><strong>คลิกเพื่ออัปโหลด</strong> หรือลากไฟล์มาวาง</div>
                  <div class="cf-upload-meta">PDF ขนาดไม่เกิน 10&nbsp;MB</div>
                </div>
                <div class="cf-filelist"></div>
              </div>
            </div>
            <div class="cf-submit-area"><div class="cf-recaptcha"><input type="checkbox" id="cf-rc-su"><label for="cf-rc-su" class="rc-label">ฉันไม่ใช่โปรแกรมอัตโนมัติ</label><div class="rc-logo"><span class="rc-text">reCAPTCHA<br>นโยบายความเป็นส่วนตัว &middot; ข้อกำหนดการใช้งาน</span></div></div><button type="submit" class="cf-btn-submit" disabled style="opacity:0.5;cursor:not-allowed;">ส่งข้อความ</button></div>
            <div class="cf-privacy">เราใช้ข้อมูลของคุณเพื่อตอบกลับคำถามของคุณเท่านั้น และจะไม่เปิดเผยข้อมูลให้แก่บุคคลภายนอก</div>
          </form>
        </div>

        @* Other *@
        <div class="ch-panel cf-card" role="tabpanel" id="other" aria-labelledby="tab-other">
          <div class="cf-success" hidden><div class="cf-success-mark"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></div><h3>ส่งข้อความแล้ว</h3><p>ข้อความของคุณถูกส่งไปยังทีมงานที่สำนักงานใหญ่แล้ว</p></div>
          <form class="cf-form" method="post" novalidate data-route="other">
            <p class="ch-panel-intro">สำหรับเรื่องอื่นที่ไม่อยู่ในหัวข้อข้างต้น คำถามด้านการผลิต ใบเสนอราคา และคำถามด้านเทคนิค โปรดส่งไปที่<a href="#sales">อีเมลของทีมขาย</a></p>
            <div class="cf-row two">
              <div class="cf-field"><label for="ot-name"><span class="req">*</span>ชื่อ</label><input type="text" id="ot-name" name="ot-name" autocomplete="name" required></div>
              <div class="cf-field"><label for="ot-email"><span class="req">*</span>อีเมล</label><input type="email" id="ot-email" name="ot-email" autocomplete="email" placeholder="you@@company.com" required></div>
            </div>
            <div class="cf-row two">
              <div class="cf-field"><label for="ot-company">บริษัท <span class="hint">(ไม่บังคับ)</span></label><input type="text" id="ot-company" name="ot-company" autocomplete="organization"></div>
              <div class="cf-field"><label for="ot-country"><span class="req">*</span>ประเทศ</label>
                <select id="ot-country" name="ot-country" required>
                  <option value="" disabled selected>เลือกประเทศ</option>
                  @foreach (var c in countries) { <option value="@c.Value">@c.Label</option> }
                </select></div>
            </div>
            <div class="cf-row one"><div class="cf-field"><label for="ot-message"><span class="req">*</span>ข้อความ</label><textarea id="ot-message" name="ot-message" required></textarea></div></div>
            <div class="cf-submit-area"><div class="cf-recaptcha"><input type="checkbox" id="cf-rc-ot"><label for="cf-rc-ot" class="rc-label">ฉันไม่ใช่โปรแกรมอัตโนมัติ</label><div class="rc-logo"><span class="rc-text">reCAPTCHA<br>นโยบายความเป็นส่วนตัว &middot; ข้อกำหนดการใช้งาน</span></div></div><button type="submit" class="cf-btn-submit" disabled style="opacity:0.5;cursor:not-allowed;">ส่งข้อความ</button></div>
            <div class="cf-privacy">เราใช้ข้อมูลของคุณเพื่อตอบกลับคำถามของคุณเท่านั้น และจะไม่เปิดเผยข้อมูลให้แก่บุคคลภายนอก</div>
          </form>
        </div>

        @* Anonymous reporting: links to the separate form (the link stays on this page) *@
        <div class="ch-panel cf-card" role="tabpanel" id="anonymous-reporting" aria-labelledby="tab-anon">
          <p class="ch-panel-intro">พนักงานและบุคคลอื่นสามารถแจ้งการกระทำที่ผิดกฎหมายหรือขัดต่อจริยธรรม หรือแจ้งข้อกังวลเกี่ยวกับจรรยาบรรณ (Code of Conduct) ของเรา ผ่านแบบฟอร์มการสื่อสารแบบไม่ระบุตัวตน โดยคุณเลือกได้ว่าจะให้ข้อมูลติดต่อหรือไม่</p>
          <a class="ch-btn ch-btn-primary" href="/contact/anonymous">เปิดแบบฟอร์มการสื่อสารแบบไม่ระบุตัวตน</a>
        </div>
      </div>
        </div>
      </div>
    </div>
  </section>


</div>
@section Scripts {
    <script src="~/js/contact-forms.js" asp-append-version="true"></script>
}
