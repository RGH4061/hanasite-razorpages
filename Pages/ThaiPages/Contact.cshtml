@page "/th/contact"
@{
    ViewData["Title"] = "ติดต่อเรา — พูดคุยกับทีมงาน Hana";
    ViewData["Description"] = "มีคำถามเกี่ยวกับความสามารถด้านการผลิต ความร่วมมือทางธุรกิจ หรือต้องการใบเสนอราคา แจ้งความต้องการของคุณให้เราทราบ";
    ViewData["Canonical"] = "https://www.hanagroup.com/th/contact";
    ViewData["Lang"] = "th";
    ViewData["AltLang"] = "en";
    ViewData["AltLangUrl"] = "/contact";
}
@section Head {
    <link rel="stylesheet" href="~/css/contact-forms.css" />
    <link rel="stylesheet" href="~/css/contact-forms-th.css" />
    <link rel="alternate" hreflang="en" href="https://www.hanagroup.com/contact" />
    <link rel="alternate" hreflang="th" href="https://www.hanagroup.com/th/contact" />
    <link rel="alternate" hreflang="x-default" href="https://www.hanagroup.com/contact" />
}

@* Contact — talk to the Hana team. Static form markup; chip multiselect via <details>+:has,
   helper JS in ~/js/contact-forms.js (demo submit — wire OnPost for the
   backend). Hero background via ~/js/hana-backgrounds.js. *@

<div class="cf-page">
  <section class="cf-hero" data-hana-bg="pcb" data-variant="dark" data-accent="cyan" data-fade="left" style="background:var(--hana-blue-deep);">
    <div class="cf-hero-inner">
      <p class="cf-eyebrow" style="color:#7EC8FF;">ติดต่อเรา</p>
      <h1 style="color:#fff;">พูดคุยกับทีมงาน Hana</h1>
      <p class="cf-hero-sub" style="color:rgba(229,238,245,0.72);">มีคำถามเกี่ยวกับความสามารถด้านการผลิต ความร่วมมือทางธุรกิจ หรือต้องการใบเสนอราคา แจ้งความต้องการของคุณ แล้วเราจะส่งต่อไปยังผู้รับผิดชอบที่เหมาะสมภายในองค์กรของเรา</p>
    </div>
  </section>
  <section class="cf-section">
    <div class="cf-wrap" style="position:relative;z-index:1;">
      <div class="cf-grid">
        <div class="cf-intro" style="width:500px;height:707px;">
          <p class="cf-eyebrow">เราช่วยอะไรคุณได้บ้าง</p>
          <div class="cf-hq-card">
            <figure class="cf-hq-photo"><img src="~/images/Hana_bkk.webp" alt="Hana Microelectronics head office — Bangkok, Thailand"></figure>
            <div class="cf-hq-label">Head office</div>
            <div class="cf-hq-name">Hana Microelectronics Public Company Limited</div>
            <address class="cf-hq-addr">65/98 Soi Vibhavadi-Rangsit 64 Junction 2, Kwang Talad Bangkhen, Khet Laksi, Bangkok 10210, Thailand</address>
            <div class="cf-hq-lines"><a href="tel:+6625511297">+66-2-551-1297-8</a><a href="tel:+6625214935">+66-2-521-4935-9</a></div>
          </div>
          <div class="cf-offices-label">สำนักงานขาย</div><div class="cf-accordion"><details class="cf-acc-item" open><summary class="cf-acc-header"><span class="cf-acc-region">USA <span class="cf-acc-count">สำนักงาน 2 แห่ง</span></span><span class="cf-acc-chevron"><span class="chevron"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span></span></summary><div class="cf-acc-body"><div class="cf-office"><div class="cf-office-name">Hana Microelectronics, Inc.</div><div class="cf-office-person">Sanjay Mitra — President</div><div class="cf-office-addr">5255 Stevens Creek Blvd. #122, Santa Clara, CA 95051</div><div class="cf-office-contacts"><a href="tel:+14084527474">+1 (408) 452-7474</a><a href="mailto:info-request@@hanaus.com">info-request@@hanaus.com</a></div></div><div class="cf-office"><div class="cf-office-name">Hana Technologies, Inc.</div><div class="cf-office-addr">29000 Aurora Road, Solon, OH 44139</div><div class="cf-office-contacts"><a href="tel:+13304054600">+1 330 405 4600</a><a href="mailto:info-request@@hanaus.com">info-request@@hanaus.com</a></div></div></div></details><details class="cf-acc-item"><summary class="cf-acc-header"><span class="cf-acc-region">Asia <span class="cf-acc-count">สำนักงาน 2 แห่ง</span></span><span class="cf-acc-chevron"><span class="chevron"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span></span></summary><div class="cf-acc-body"><div class="cf-office"><div class="cf-office-name">ฟิลิปปินส์</div><div class="cf-office-person">Henry Lubrico<div class="cf-office-contacts"><a href="mailto:info-request@@hanaus.com">info-request@@hanaus.com</a></div></div></div><div class="cf-office"><div class="cf-office-name">สิงคโปร์</div><div class="cf-office-person">SR Chok</div><div class="cf-office-contacts"><a href="tel:+6596922682">+65 9692 2682</a><a href="mailto:info-request@@hanaus.com">info-request@@hanaus.com</a></div></div></div></details><details class="cf-acc-item"><summary class="cf-acc-header"><span class="cf-acc-region">ยุโรป <span class="cf-acc-count">สำนักงาน 2 แห่ง</span></span><span class="cf-acc-chevron"><span class="chevron"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span></span></summary><div class="cf-acc-body"><div class="cf-office"><div class="cf-office-name">ฝรั่งเศส</div><div class="cf-office-person">Mortar Feddal</div><div class="cf-office-contacts"><a href="tel:+33617721068">+33 6 17 72 10 68</a><a href="mailto:info-request@@hanaus.com">info-request@@hanaus.com</a></div></div><div class="cf-office"><div class="cf-office-name">เยอรมนี</div><div class="cf-office-person">Frank Böhme</div><div class="cf-office-addr">Schwatlostraße 4, 12207 Berlin</div><div class="cf-office-contacts"><a href="tel:+4930756576690">+49 30 75657690</a><a href="mailto:info-request@@hanaus.com">info-request@@hanaus.com</a></div></div></div></details></div>
          <p class="cf-anon-link" style="font-size:13px;color:var(--ink-2);margin:20px 0 0;"><b>Anonymous Communication Form<br></br></b>If you would like to report / share your concerns anonymously, <a href="/contact/anonymous" style="color:var(--hana-blue-deep);text-decoration:none;border-bottom:1px solid var(--line);" onmouseover="this.style.color='var(--hana-blue)'" onmouseout="this.style.color='var(--hana-blue-deep)'">click here</a>.</p>
        </div>
        <div style="display:grid;gap:24px;">
        <div class="cf-rfq-cta" style="width:495px;height:212px;">
          <div class="cf-rfq-label">เริ่มต้นโครงการ</div>
          <h3>มีผลิตภัณฑ์ที่ต้องการให้เราผลิตหรือไม่</h3>
          <p>Send a quote request and we&rsquo;ll route you to our sales and technical teams to start the conversation on your needs.</p>
          <a href="/contact/rfq" class="cf-rfq-btn">ขอใบเสนอราคา</a>
        </div>
        <div class="cf-card" id="general-enquiry" style="width:500px;height:818px;">
  <div class="cf-success" hidden><div class="cf-success-mark"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></div><h3>ได้รับข้อความของคุณแล้ว</h3><p>ขอบคุณ เราได้ส่งต่อข้อความของคุณไปยังทีมที่เกี่ยวข้องแล้ว และจะติดต่อกลับภายใน 1 วันทำการ</p></div>
  
  <form class="cf-form" method="post" novalidate>
    <div class="cf-field" style="margin-bottom:18px;"><label for="ge-reason" style="font-size:13px;font-weight:700;color:var(--ink);">เลือกหัวข้อการติดต่อหรือขอใบเสนอราคา</label>
      <select id="ge-reason" name="ge-reason"><option value="" disabled selected>เลือก 1 รายการ</option><option>ฝ่ายขายและฝ่ายสนับสนุนลูกค้า</option><option>ขอใบเสนอราคา (RFQ)</option><option>คำถามด้านความสามารถในการผลิต / ด้านเทคนิค</option><option>นักลงทุนสัมพันธ์</option><option>ร่วมงานกับเรา</option><option>สอบถามสำหรับซัพพลายเออร์</option><option>อื่น ๆ</option></select></div>
    <div class="cf-divider"></div>
    <div class="cf-row two"><div class="cf-field"><label for="ge-name"><span class="req">*</span>Name</label><input type="text" id="ge-name" name="ge-name" placeholder="ชื่อและนามสกุล" required></div><div class="cf-field"><label for="ge-company"><span class="req">*</span>บริษัท</label><input type="text" id="ge-company" name="ge-company" placeholder="ชื่อบริษัท" required></div></div>
    <div class="cf-row two"><div class="cf-field"><label for="ge-email"><span class="req">*</span>อีเมล</label><input type="email" id="ge-email" name="ge-email" placeholder="you@@company.com" required></div><div class="cf-field"><label for="ge-phone">โทรศัพท์ <span class="hint">(ไม่บังคับ)</span></label><input type="tel" id="ge-phone" name="ge-phone" placeholder="+44 …"></div></div>
    <div class="cf-row two"><div class="cf-field"><label for="ge-country"><span class="req">*</span>ประเทศ</label><select id="ge-country" name="ge-country"><option value="" disabled selected>เลือกประเทศ</option><option>สหราชอาณาจักร</option><option>เยอรมนี</option><option>ฝรั่งเศส</option><option>เนเธอร์แลนด์</option><option>สวีเดน</option><option>นอร์เวย์</option><option>เดนมาร์ก</option><option>ฟินแลนด์</option><option>เบลเยียม</option><option>สวิตเซอร์แลนด์</option><option>ออสเตรีย</option><option>อิตาลี</option><option>สเปน</option><option>โปรตุเกส</option><option>โปแลนด์</option><option>สาธารณรัฐเช็ก</option><option>ไอร์แลนด์</option><option>สหรัฐอเมริกา</option><option>แคนาดา</option><option>ไทย</option><option>จีน</option><option>สิงคโปร์</option><option>อื่น ๆ</option></select></div><div class="cf-field"><label for="ge-source">คุณรู้จักเราจากช่องทางใด</label><select id="ge-source" name="ge-source"><option value="" disabled selected>เลือก 1 รายการ</option><option>การค้นหาบนเว็บ</option><option>การค้นหาด้วย AI หรือแชตบอต</option><option>การแนะนำจากเพื่อนร่วมงานหรือพันธมิตร</option><option>งานแสดงสินค้าหรืองานสัมมนา</option><option>สื่อสิ่งพิมพ์หรือข่าวในอุตสาหกรรม</option><option>LinkedIn</option><option>ผู้ติดต่อเดิมที่ Hana</option><option>อื่น ๆ</option></select></div></div>
    <div class="cf-divider"></div>
    <div class="cf-row two" style="margin-bottom:0;"><details class="cf-ms cf-field"><summary class="cf-chip-toggle"><span class="toggle-label">อุตสาหกรรม</span><span class="chip-count" style="display:none">0</span><span class="chevron"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
    <div class="cf-chip-panel"><div class="cf-chip-note">เลือกได้มากกว่า 1 ข้อ</div><div class="cf-chip-group"><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Automotive">ยานยนต์</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Industrial & IoT">อุตสาหกรรมและ IoT</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Telecommunications">โทรคมนาคม</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="RFID">RFID</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Optical & Sensors">ออปติคัลและเซ็นเซอร์</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Consumer Electronics">อิเล็กทรอนิกส์สำหรับผู้บริโภค</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Medical">การแพทย์</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Access Control">ระบบควบคุมการเข้าออก</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Power Management">การจัดการพลังงาน</label><label class="cf-chip"><input type="checkbox" name="ge-industry" value="Other">อื่น ๆ</label></div></div></details><details class="cf-ms cf-field"><summary class="cf-chip-toggle"><span class="toggle-label">บริการ</span><span class="chip-count" style="display:none">0</span><span class="chevron"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
    <div class="cf-chip-panel"><div class="cf-chip-note">เลือกได้มากกว่า 1 ข้อ</div><div class="cf-chip-group"><label class="cf-chip"><input type="checkbox" name="ge-service" value="PCBA & Box Build">PCBA และ box build</label><label class="cf-chip"><input type="checkbox" name="ge-service" value="IC Assembly & Test (OSAT)">การประกอบและทดสอบ IC (OSAT)</label><label class="cf-chip"><input type="checkbox" name="ge-service" value="RFID & Smart Tags">RFID และ smart tag</label><label class="cf-chip"><input type="checkbox" name="ge-service" value="Sensors & Optical">เซ็นเซอร์และออปติคัล</label><label class="cf-chip"><input type="checkbox" name="ge-service" value="Power Solutions">โซลูชันด้านพลังงาน</label><label class="cf-chip"><input type="checkbox" name="ge-service" value="DFM / NPI Support">การสนับสนุนด้าน DFM / NPI</label><label class="cf-chip"><input type="checkbox" name="ge-service" value="Other">อื่น ๆ</label></div></div></details></div>
    <div class="cf-divider"></div>
    <div class="cf-row one" style="margin-bottom:0;"><div class="cf-field"><label for="ge-message"><span class="req">*</span>ข้อความ</label><textarea id="ge-message" name="ge-message" placeholder="แจ้งสิ่งที่คุณต้องการ เช่น ผลิตภัณฑ์ที่คุณผลิต โครงการของคุณอยู่ในขั้นตอนใด และเราจะช่วยคุณได้อย่างไร" required></textarea></div></div>
    <div class="cf-divider"></div>
    <div class="cf-row one" style="margin-bottom:0;"><div class="cf-field" style="margin-bottom:0;"><label>ไฟล์แนบ <span class="hint">(ไม่บังคับ)</span></label>
      <div class="cf-upload"><input type="file" name="ge-files" accept=".pdf,.zip" multiple placeholder="PDF, ZIP"><span class="cf-upload-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.4 11.1-8.5 8.5a5 5 0 0 1-7-7l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7L9 16.4a1.7 1.7 0 0 1-2.3-2.3l7.8-7.8"></path></svg></span><div class="cf-upload-text"><strong>คลิกเพื่ออัปโหลด</strong> หรือลากไฟล์มาวาง</div><div class="cf-upload-meta">PDF หรือ ZIP &middot; ขนาดไม่เกิน 10 MB</div></div>
      <div class="cf-filelist"></div>
    </div></div>
    <div class="cf-submit-area"><div class="cf-recaptcha"><input type="checkbox" id="cf-rc-ge"><label for="cf-rc-ge" class="rc-label">ฉันไม่ใช่โปรแกรมอัตโนมัติ</label>
    <div class="rc-logo"><span class="rc-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue-soft)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></span><span class="rc-text">reCAPTCHA<br>นโยบายความเป็นส่วนตัว &middot; ข้อกำหนดการใช้งาน</span></div></div><button type="submit" class="cf-btn-submit" disabled style="opacity:0.5;cursor:not-allowed;">ส่งข้อความ</button></div>
    <div class="cf-privacy">เราใช้ข้อมูลของคุณเพื่อตอบกลับคำถามของคุณเท่านั้น และจะไม่เปิดเผยข้อมูลให้แก่บุคคลภายนอก</div>
  </form>
</div>
        </div>
      </div>
    </div>
  </section>
</div>

@section Scripts {
    <script src="~/js/contact-forms.js"></script>
}
