@page "/about/history"
@{
    ViewData["Title"] = "Our heritage";
    ViewData["Motion"] = "page";
    ViewData["Description"] = "Building microelectronics since 1978 — the history of Hana Microelectronics across four countries.";
    ViewData["AltLang"] = "th";
    ViewData["AltLangUrl"] = "/th/about/history";
}
@section Head {
    <link rel="stylesheet" href="~/css/about-history.css" />
    <link rel="alternate" hreflang="en" href="https://www.hanagroup.com/about/history" />
    <link rel="alternate" hreflang="th" href="https://www.hanagroup.com/th/about/history" />
    <link rel="alternate" hreflang="x-default" href="https://www.hanagroup.com/about/history" />
}

@* Our heritage. Static content + interactive decade timeline
   (~/js/about-heritage.js). Page CSS in ~/css/about-history.css. *@

<!-- ── Heritage flow wrapper: hero + decade bar + timeline share one flow field ── -->
<div class="heritage-flow" data-hana-bg="flow" data-variant="light" data-accent="cyan" data-fade="none">

<!-- ── Hero band: breadcrumb + hero ── -->
<div class="hero-band hero-band--flow">
  <div class="subbar">
    <div class="subbar-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <span class="nolink">About</span><span class="sep">/</span>
        <span>Our Heritage</span>
      </nav>
      <div class="meta">EST. 1978 · BANGKOK</div>
    </div>
  </div>

  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-title">Our Journey.
        <span class="hero-title-line"><span>From <span class="yr">1978</span></span><span class="arrow" aria-hidden="true"></span><span class="sr-only"> to </span><span class="yr yr-now">2026</span></span>
      </h1>
      <p class="hero-summary">From a workshop in Bangkok to operations across the globe. Follow our story and growth from humble beginnings assembling watch modules to a leading electronics manufacturing operation. </p>
      <div class="hero-cta">
        <a href="/capabilities" class="hana-btn hana-btn-primary">Explore our capabilities</a>
        <a href="/locations" class="hana-btn hana-btn-secondary">Explore our locations</a>
      </div>
    </div>
  </section>
</div>

<!-- ── Decade nav (shares the hero's flow field via .heritage-flow) ── -->
<div class="decade-stick-sentinel" aria-hidden="true" style="height:1px;"></div>
<nav class="decade-nav">
  <div class="decade-nav-inner">
    <button class="decade-chip is-active" data-decade="1970s">1970s</button>
    <button class="decade-chip" data-decade="1980s">1980s</button>
    <button class="decade-chip" data-decade="1990s">1990s</button>
    <button class="decade-chip" data-decade="2000s">2000s</button>
    <button class="decade-chip" data-decade="2010s">2010s</button>
    <button class="decade-chip" data-decade="2020s">2020s</button>
  </div>
</nav>

<!-- ── Horizontal timeline ── -->
<!-- ── Vertical timeline (preview 21 Oct 2026; replaces the horizontal track) ── -->
<section class="tl-v" id="timeline" aria-label="Hana timeline, 1978 to 2026">
  <div class="tl-v-inner">
    <section class="tl-decade" id="decade-1970s" data-decade="1970s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">1970s</span><p class="tl-decade-sum">Founded in Bangkok, assembling LED and then LCD watch modules.</p></div></div>
      <ol class="tl-list">
        <li class="tl-item tl-item--feature" data-year="1978">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1978</span>
          <div class="tl-card"><h3 class="tl-headline">A wooden house on Silom Road</h3><p class="tl-body">Founded in Bangkok as Minerva Trading Co., Ltd. — thirty people assembling LED watch modules in a wooden house at Silom, Bangrak. Later renamed Minerva Electronics, then Hana Industries.</p></div>
        </li>
        <li class="tl-item" data-year="1979">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1979</span>
          <div class="tl-card"><h3 class="tl-headline">Onto LCD watch modules</h3><p class="tl-body">The workshop moved into LCD (liquid crystal display) watch module assembly, following the next wave of consumer electronics components.</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-1980s" data-decade="1980s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">1980s</span><p class="tl-decade-sum">Complete watch movements for export, and a first move into integrated circuit assembly.</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="1982">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1982</span>
          <div class="tl-card"><h3 class="tl-headline">A factory for Swiss watchmaking</h3><p class="tl-body">A new factory opened on Ngang-Linchi Road to assemble electronic modules for quartz analog watch movements, supplying a major Swiss watch group.</p></div>
        </li>
        <li class="tl-item" data-year="1983">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1983</span>
          <div class="tl-card"><h3 class="tl-headline">Complete watch movements</h3><p class="tl-body">Production expanded from modules to complete watch movements, distributed into the Hong Kong watch market.</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="1984">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1984</span>
          <div class="tl-card"><h3 class="tl-headline">First step into semiconductors</h3><p class="tl-body">Hana Semiconductor (BKK) Co., Ltd. was established — the first move into integrated circuit (IC) assembly and a deliberate step into higher-technology manufacturing.</p></div>
        </li>
        <li class="tl-item" data-year="1986">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1986</span>
          <div class="tl-card"><h3 class="tl-headline">Expansion at Laksi</h3><p class="tl-body">PCBA and quartz watch production moved from Ngang-Linchi to Laksi to make room for growing IC work. Hana Coil Co., Ltd. was established to manufacture coil winding.</p></div>
        </li>
        <li class="tl-item" data-year="1988">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1988</span>
          <div class="tl-card"><h3 class="tl-headline">A new name, a clearer focus</h3><p class="tl-body">"Hana Industries" became "Hana Microelectronics Co., Ltd." Coil winding moved from Laksi to Suthisarn. PCBA production started at the Laksi plant.</p></div>
        </li>
        <li class="tl-item" data-year="1989">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1989</span>
          <div class="tl-card"><h3 class="tl-headline">A trading subsidiary</h3><p class="tl-body">Hana Trading Co., Ltd. was established to import finished watches from Hong Kong.</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-1990s" data-decade="1990s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">1990s</span><p class="tl-decade-sum">A public listing, new plants in Lamphun and Ayutthaya, and first operations outside Thailand.</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="1991">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1991</span>
          <div class="tl-card"><h3 class="tl-headline">Consolidating in Laksi</h3><p class="tl-body">Integrated circuit production moved from Ngang-Linchi to the Laksi plant, bringing semiconductor work onto a single site. The following year, the headquarters moved from Silom to Laksi as the business expanded into functional test &mdash; and Laksi has been Hana&rsquo;s home ever since.</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="1993">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1993</span>
          <div class="tl-card"><h3 class="tl-headline">Lamphun, and a public listing</h3><p class="tl-body">PCBA, COB, and coil winding moved to a new facility in the Northern Region Industrial Estate in Lamphun, and Hana listed on the Stock Exchange of Thailand as Hana Microelectronics Public Co., Ltd. PCBA production began at the new site the following year.</p><figure class="tl-photo"><img src="/images/lamphun-facility.webp" alt="Lamphun plant today" width="1600" height="558" loading="lazy" decoding="async"><figcaption>Lamphun plant today</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="1996">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1996</span>
          <div class="tl-card"><h3 class="tl-headline">Hana Technologies, and a Shanghai subsidiary</h3><p class="tl-body">Acquired 100% of Swire Technologies Ltd. (renamed Hana Technologies). Hana Microelectronics Co., Ltd. (Shanghai) was established — the first manufacturing presence in China.</p></div>
        </li>
        <li class="tl-item" data-year="1997">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1997</span>
          <div class="tl-card"><h3 class="tl-headline">A fire, and a new IC plant in Ayutthaya</h3><p class="tl-body">A fire at the Bangkok semiconductor plant caused approximately THB 300 million in damage. IC production relocated to the Hi-Tech Industrial Estate in Bang Pa-In, Ayutthaya — still home to Hana's OSAT operations today.</p></div>
        </li>
        <li class="tl-item" data-year="1998">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1998</span>
          <div class="tl-card"><h3 class="tl-headline">Olin Interconnect Technologies acquisition</h3><p class="tl-body">Acquired 100% of Olin Interconnect Technologies (a division of Olin Corporation, US), forming a new subsidiary: Advanced Interconnect Technologies (AIT).</p></div>
        </li>
        <li class="tl-item" data-year="1999">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">1999</span>
          <div class="tl-card"><h3 class="tl-headline">AIT merger, and a step into microdisplays</h3><p class="tl-body">Hana Technologies merged with AIT, an IC manufacturer in Batam, Indonesia, for a 43% stake. Hana Microdisplay Technologies, Inc. was established in the US to manufacture LCoS components.</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-2000s" data-decade="2000s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2000s</span><p class="tl-decade-sum">Manufacturing begins in Jiaxing, China, and the Thai plants expand.</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="2003">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2003</span>
          <div class="tl-card"><h3 class="tl-headline">A second China subsidiary, in Jiaxing</h3><p class="tl-body">Hana Microelectronics Co., Ltd. (Jiaxing) was established in China&rsquo;s Yangtze River Delta, around 100 km southwest of Shanghai &mdash; the group&rsquo;s second China presence after Shanghai.</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2005">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2005</span>
          <div class="tl-card"><h3 class="tl-headline">Jiaxing, China &mdash; operations begin</h3><p class="tl-body">Production began at the Jiaxing site in eastern China, with PCBA and integrated circuits as the lead products.</p><figure class="tl-photo"><img src="/images/jiaxing-facility.webp" alt="Jiaxing plant today" width="1274" height="474" loading="lazy" decoding="async"><figcaption>Jiaxing plant today</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2007">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2007</span>
          <div class="tl-card"><h3 class="tl-headline">Lamphun and Ayutthaya grow; AIT sold</h3><p class="tl-body">Lamphun added a 10,000 m² building — a 60% floor space increase. Ayutthaya added 3,000 m² of capacity. AIT was sold to Unisem.</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-2010s" data-decade="2010s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2010s</span><p class="tl-decade-sum">Recovery from the 2011 floods, a new plant in Cambodia and a second site in Lamphun.</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="2011">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2011</span>
          <div class="tl-card"><h3 class="tl-headline">Floods in Thailand</h3><p class="tl-body">The Ayutthaya subsidiary was inundated by Thailand's flooding in early October — causing significant property damage and business interruption. The team rebuilt.</p></div>
        </li>
        <li class="tl-item" data-year="2013">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2013</span>
          <div class="tl-card"><h3 class="tl-headline">A new subsidiary in Cambodia</h3><p class="tl-body">Hana Microelectronics (Cambodia) Co., Ltd. was established at the Koh Kong Special Economic Zone — the beginning of a third manufacturing country for the group.</p></div>
        </li>
        <li class="tl-item" data-year="2014">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2014</span>
          <div class="tl-card"><h3 class="tl-headline">Recovery, a new HQ, and Lamphun 2</h3><p class="tl-body">The headquarters moved to a new site at Vibhavadi-Rangsit, Bangkok, on land owned by the company. Final flood insurance settlement was received. A second Lamphun branch, Lamphun 2, was established.</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2015">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2015</span>
          <div class="tl-card"><h3 class="tl-headline">Two new factories open</h3><p class="tl-body">Lamphun 2 began operations in semiconductors and PCBA. In September, the Cambodia plant came online — initially assembling RFID access control readers and quartz crystals.</p><figure class="tl-photo"><img src="/images/koh-kong-facility.webp" alt="Koh Kong plant today" width="1600" height="493" loading="lazy" decoding="async"><figcaption>Koh Kong plant today</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2017">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2017</span>
          <div class="tl-card"><h3 class="tl-headline">Thailand capacity expansion</h3><p class="tl-body">Lamphun 2 fitted out a second floor, doubling its manufacturing capacity. Ayutthaya added a three-story, 2,600&nbsp;m² warehouse.</p></div>
        </li>
        <li class="tl-item" data-year="2017">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2017</span>
          <div class="tl-card"><h3 class="tl-headline">Power Master Semiconductor, in Korea</h3><p class="tl-body">Power Master Semiconductor Co., Ltd. (PMS) was established in Korea to manufacture IC power management devices &mdash; extending Hana&rsquo;s manufacturing footprint into Korea.</p></div>
        </li>
        <li class="tl-item" data-year="2018">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2018</span>
          <div class="tl-card"><h3 class="tl-headline">Lamphun 2 grows; Ohio renamed</h3><p class="tl-body">Lamphun 2 added 6,000 m² of production. The Ohio subsidiary became Hana Technologies, Inc., reflecting a broader scope across LCoS and RFID device manufacturing.</p></div>
        </li>
        <li class="tl-item" data-year="2019">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2019</span>
          <div class="tl-card"><h3 class="tl-headline">A cleaner subsidiary structure</h3><p class="tl-body">Three holding subsidiaries — Hana Technologies Group, Hana Technologies Investments, and Hana Semiconductor Holdings — were dissolved. No gain or loss recognized.</p></div>
        </li>
      </ol>
    </section>
    <section class="tl-decade" id="decade-2020s" data-decade="2020s">
      <div class="tl-decade-side"><div class="tl-decade-label"><span class="tl-decade-name">2020s</span><p class="tl-decade-sum">Further growth in Ayutthaya and Ohio, and a move into RFID inlay manufacturing.</p></div></div>
      <ol class="tl-list">
        <li class="tl-item" data-year="2020">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2020</span>
          <div class="tl-card"><h3 class="tl-headline">Ayutthaya keeps growing</h3><p class="tl-body">Ayutthaya added 6,650 m² of office and production space to support continuing growth in demand.</p></div>
        </li>
        <li class="tl-item" data-year="2021">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2021</span>
          <div class="tl-card"><h3 class="tl-headline">Into the RFID inlay OEM business</h3><p class="tl-body">Hana Technologies, Inc. entered the RFID inlay OEM business — a deliberate move into higher-volume RFID manufacturing.</p></div>
        </li>
        <li class="tl-item tl-item--feature" data-year="2023">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2023</span>
          <div class="tl-card"><h3 class="tl-headline">Capital raise; a new home in Ohio</h3><p class="tl-body">Completed a private placement of 80.48 million shares, raising THB 4.58 billion gross. Hana Technologies, Inc. relocated to Solon, Ohio, tripling manufacturing floor space.</p><figure class="tl-photo"><img src="/images/ohio-facility.webp" alt="Solon, Ohio plant today" width="1600" height="1072" loading="lazy" decoding="async"><figcaption>Solon, Ohio plant today</figcaption></figure></div>
        </li>
        <li class="tl-item" data-year="2024">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2024</span>
          <div class="tl-card"><h3 class="tl-headline">Investment in FT1 Corporation</h3><p class="tl-body">Entered an agreement with NewVersal Co., Ltd. (PTT Public Co., Ltd.) to invest in FT1 Corporation, holding 49% after a further THB 744.8 million investment. Ayutthaya purchased adjacent land for THB 86 million.</p></div>
        </li>
        <li class="tl-item" data-year="2025">
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-year">2025</span>
          <div class="tl-card"><h3 class="tl-headline">Cambodia land sale</h3><p class="tl-body">In February 2025, the company sold land held for dormitory development in Cambodia for USD 1.3 million.</p></div>
        </li>
      </ol>
    </section>
    <div class="tl-rail" aria-hidden="true"><div class="tl-rail-fill"></div></div>
  </div>
</section>

</div>
<!-- ── /heritage-flow ── -->



@section Scripts {
    <script src="~/js/about-heritage.js"></script>
}
