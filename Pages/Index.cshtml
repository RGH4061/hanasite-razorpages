@* Index.cshtml — Homepage
   Composes all homepage partial views.
   Code-behind: Index.cshtml.cs

   Partial views used:
     _Header.cshtml
     _Homepage_Hero.cshtml
     _Homepage_WhySetsApart.cshtml
     _Homepage_Markets.cshtml
     _Homepage_Capabilities.cshtml
     _Homepage_Locations.cshtml
     _Homepage_Cta.cshtml
     _Footer.cshtml

   JS loaded at bottom:
     /js/circuit-hero.js         — canvas animation (auto-inits via [data-circuit-hero])
     /js/mega-menu.js            — header mega-menu (auto-inits on DOMContentLoaded)
     /js/capability-carousel.js  — capability card carousel (auto-inits on DOMContentLoaded)
     /js/reveal.js               — scroll-triggered section reveals ([data-reveal-root] / [data-stagger])

   External:
     Lucide UMD — loaded in _Layout.cshtml, called via lucide.createIcons() below
*@

@page
@model IndexModel
@{
    ViewData["Title"] = "Electronics Manufacturing Services (EMS) & OSAT";
    ViewData["AltLang"] = "th";
    ViewData["AltLangUrl"] = "/th";
}

@* ── Organization JSON-LD (§7.3 schema rules) ─────────────── *@
@section Head {
<link rel="stylesheet" href="~/css/homepage-mobile.css" />
<style>.hs-hdr-input{font-weight:600}:root{--page-max:1144px}</style>
<link rel="alternate" hreflang="en" href="https://www.hanagroup.com/" />
<link rel="alternate" hreflang="th" href="https://www.hanagroup.com/th" />
<link rel="alternate" hreflang="x-default" href="https://www.hanagroup.com/" />
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Organization",
  "name": "Hana Microelectronics Public Company Limited",
  "url": "https://www.hanagroup.com",
  "logo": "https://www.hanagroup.com/images/hana-logo-full.svg",
  "description": "The leading independent EMS and OSAT company in Southeast Asia, specializing in microelectronics.",
  "foundingDate": "1978",
  "contactPoint": {
    "@@type": "ContactPoint",
    "contactType": "sales",
    "url": "https://www.hanagroup.com/contact"
  },
  "location": [
    { "@@type": "Place", "name": "Bangkok, Thailand (HQ)" },
    { "@@type": "Place", "name": "Lamphun, Thailand" },
    { "@@type": "Place", "name": "Ayutthaya, Thailand" },
    { "@@type": "Place", "name": "Koh Kong, Cambodia" },
    { "@@type": "Place", "name": "Jiaxing, China" },
    { "@@type": "Place", "name": "Ohio, USA" }
  ],
  "sameAs": [
    "https://www.linkedin.com/company/hana-microelectronics/"
  ]
}
</script>
}

@* ── Circuit hero ───────────────────────────────────────── *@
<style>
/* Homepage hero — sequential line wipe entrance */
.hha-line{display:block;position:relative}
.hha-in{display:block;clip-path:inset(0 100% 0 0);animation:hhaWipe 900ms cubic-bezier(.22,.7,.2,1) forwards;animation-delay:var(--d)}
.hha-edge{position:absolute;top:6%;bottom:12%;left:0;width:2px;background:#1283DD;opacity:0;box-shadow:0 0 18px rgba(18,131,221,0.9);animation:hhaEdge 900ms cubic-bezier(.22,.7,.2,1) forwards;animation-delay:var(--d)}
.hha-badge,.hha-sub,.hha-acts{opacity:0;animation:hhaFade 700ms cubic-bezier(.16,.84,.3,1) forwards}
.hha-badge{animation-delay:0ms}.hha-sub{animation-delay:1720ms}.hha-acts{animation-delay:1860ms}
@@keyframes hhaWipe{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}
@@keyframes hhaEdge{0%{left:0;opacity:0}8%{opacity:1}92%{opacity:1}100%{left:100%;opacity:0}}
@@keyframes hhaFade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@@media (prefers-reduced-motion:reduce){.hha-in,.hha-edge,.hha-badge,.hha-sub,.hha-acts{animation:none!important;opacity:1!important;transform:none!important;clip-path:none!important}.hha-edge{display:none}}
/* Scroll-triggered reveals */
.hrv{opacity:0;transform:translateY(14px);transition:opacity 640ms cubic-bezier(.16,.84,.3,1),transform 640ms cubic-bezier(.16,.84,.3,1);transition-delay:var(--d,0ms)}
.rv-on .hrv{opacity:1;transform:none}
.hrw-line{display:block;position:relative}
.hrw-in{display:block;clip-path:inset(0 100% 0 0)}
.rv-on .hrw-in{animation:hhaWipe 820ms cubic-bezier(.22,.7,.2,1) forwards;animation-delay:var(--d,0ms)}
.hrw-edge{position:absolute;top:10%;bottom:16%;left:0;width:2px;background:#1283DD;opacity:0;box-shadow:0 0 18px rgba(18,131,221,0.9)}
.rv-on .hrw-edge{animation:hhaEdge 820ms cubic-bezier(.22,.7,.2,1) forwards;animation-delay:var(--d,0ms)}
@@media (prefers-reduced-motion:reduce){.hrv,.hrw-in{opacity:1!important;transform:none!important;clip-path:none!important;animation:none!important;transition:none!important}.hrw-edge{display:none}}
</style>
