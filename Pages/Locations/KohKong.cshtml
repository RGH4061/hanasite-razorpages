<style>.kk-ph{position:relative;overflow:hidden;border-radius:10px;border:1px solid var(--line);background:#030a17;aspect-ratio:3/2}.kk-ph img{width:100%;height:100%;object-fit:cover;display:block}@@media(max-width:900px){.kk-about{grid-template-columns:1fr!important;gap:36px!important}}</style>
<div style="max-width:1240px;margin:0 auto;padding:64px 32px;">
  <div class="kk-about" style="display:grid;grid-template-columns:0.72fr 1.28fr;gap:48px;align-items:start;">
    <div>
      <h2 class="hana-h3" style="margin-bottom:18px;">Electronics manufacturing in the Koh Kong SEZ</h2>
      <p style="font-size:15.5px;color:var(--ink-2);line-height:1.7;margin:0 0 16px;max-width:540px;">Koh Kong provides electronics manufacturing services with deep PCBA and final-assembly capability, building medical devices, consumer electronics and access-control products.</p>
      <p style="font-size:15.5px;color:var(--ink-2);line-height:1.7;margin:0 0 16px;max-width:540px;">Our Cambodian site offers labour-competitive assembly within the Hana group coupled with high technical capabilities in the strictest industries of quality such as medical and automotive devices. As a TAA-designated country, products substantially transformed in Cambodia are eligible for US federal and government procurement, a route few low-cost manufacturing locations can offer.</p>
      <a href="/locations" class="hana-btn hana-btn-secondary" style="margin-top:8px;display:inline-flex;align-items:center;gap:8px;">Explore locations hub <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>
    </div>
    <div class="lc-photos" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <figure class="kk-ph" style="margin:0;"><img src="/images/koh-kong/factory-floor-1.webp" alt="Production floor, Koh Kong" loading="lazy" /></figure>
      <figure class="kk-ph" style="margin:0;"><img src="/images/koh-kong/factory-floor-2.webp" alt="Inspection, Koh Kong" loading="lazy" /></figure>
      <figure class="kk-ph" style="margin:0;"><img src="/images/koh-kong/micro-assembly-bench.webp" alt="Micro-assembly benches, Koh Kong" loading="lazy" /></figure>
      <figure class="kk-ph" style="margin:0;"><img src="/images/koh-kong/ict-test-station.webp" alt="In-circuit test station, Koh Kong" loading="lazy" /></figure>
    </div>
  </div>
</div>

