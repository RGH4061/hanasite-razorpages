@page "/locations/ayutthaya/certifications"
@{
    ViewData["Title"] = "Ayutthaya certifications";
    ViewData["Motion"] = "page";
    ViewData["Description"] = HanaSite.Services.Certifications.Description("ayutthaya");
}
@section Head {
    <link rel="stylesheet" href="~/css/certifications.css" asp-append-version="true" />
}
@* Ayutthaya plant certificates. Content comes from Data/certifications.json; layout in Pages/Shared/_PlantCertifications.cshtml. *@
<partial name="_PlantCertifications" model='"ayutthaya"' />

@* Ayutthaya only (24 Nov 2026): link to the plant's RBA/CSR and Code of Conduct policy page. *@
<section style="padding:0 0 80px;margin-top:-40px;">
  <div class="cert-wrap">
    <a href="/locations/ayutthaya/rba-csr-policy" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;background:#fff;border:1px solid var(--line);border-left:3px solid #0E4A7C;border-radius:var(--radius-card,8px);padding:18px 22px;text-decoration:none;">
      <span><span style="display:block;font-family:var(--font-display);font-size:17px;font-weight:600;color:var(--ink);">RBA/CSR and Code of Conduct policy</span><span style="display:block;font-size:13.5px;color:var(--ink-2);margin-top:4px;">The policy of Hana Semiconductor (Ayutthaya) Co., Ltd. on ethics, labor, health and safety, and the environment.</span></span>
      <span class="hana-link" style="font-size:12px;">Read the policy &rarr;</span>
    </a>
  </div>
</section>
