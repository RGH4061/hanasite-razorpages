@page "/locations/ayutthaya"
@{
    ViewData["Title"] = "Ayutthaya plant";
    ViewData["Motion"] = "page";
    ViewData["Description"] = "Hana's Ayutthaya plant in Thailand: IC assembly and test for low to medium pin-count devices, optical sensor and hermetic packaging, and SMT, IATF 16949 certified.";
}

