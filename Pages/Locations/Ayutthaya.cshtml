<style>.ayt-ph{position:relative;overflow:hidden;border-radius:10px;border:1px solid var(--line);background:#030a17}.ayt-ph img{width:100%;height:100%;object-fit:cover;display:block}@@media(max-width:900px){.ayt-about{grid-template-columns:1fr!important;gap:36px!important}}</style>
<div style="max-width:1240px;margin:0 auto;padding:64px 32px;">
  <div class="ayt-about" style="display:grid;grid-template-columns:0.7fr 1.3fr;gap:48px;align-items:start;">
    <div>
      <h2 class="hana-h3" style="margin-bottom:18px;">Outsourced semiconductor assembly and test (OSAT) in Thailand</h2>
      <p style="font-size:15.5px;color:var(--ink-2);line-height:1.7;margin:0 0 16px;max-width:540px;">Ayutthaya is Hana’s core OSAT operation, packaging and testing semiconductor devices used across automotive, medical, optical, RFID, telecom and broader industrial and consumer electronics.<br /></p>
      <p style="font-size:15.5px;color:var(--ink-2);line-height:1.7;margin:0 0 16px;max-width:540px;">Starting with in-house IC packaging design capabilities, Ayutthaya can run projects from design concept to simulation and test through to IC packaging and EMS/PCBA services on one site.<br><br>With over 600 test systems across analog, logic, memory, mixed-signal, RF and sensor devices, we are equipped to handle the rigours of the highest quality demands.</p>
      <a href="/locations" class="hana-btn hana-btn-secondary" style="margin-top:8px;display:inline-flex;align-items:center;gap:8px;">Explore locations hub <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>
    </div>
    <div class="lc-photos" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <figure class="ayt-ph" style="margin:0;aspect-ratio:3/2;"><img src="/images/ayt-factory-wire-bond.webp" alt="Assembly floor, Ayutthaya" loading="lazy" /></figure>
      <figure class="ayt-ph" style="margin:0;aspect-ratio:3/2;"><img src="/images/ayt-factory-die-bond.webp" alt="Die bonder detail, Ayutthaya" loading="lazy" /></figure>
      <figure class="ayt-ph" style="margin:0;aspect-ratio:3/2;"><img src="/images/ayt-factory-floor.webp" alt="Wire bond operator, Ayutthaya" loading="lazy" /></figure>
      <figure class="ayt-ph" style="margin:0;aspect-ratio:3/2;"><img src="/images/ayt-plant-night.webp" alt="Hana Ayutthaya plant at dusk" loading="lazy" style="object-position:center;object-fit:cover;" /></figure>
    </div>
  </div>

</div>

