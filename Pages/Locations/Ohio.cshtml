<style>
  .cg-section > .hana-bg-layer { opacity: .55 !important; }
  .cg-card { transition: transform 160ms ease, box-shadow 160ms ease; }
  .cg-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(3,10,23,0.32); }
  .cg-title:hover { color: var(--hana-blue) !important; }
  .cg-link:hover { color: var(--hana-blue) !important; }
  .cg-link:hover .cg-arr { transform: translateX(3px); }
  .cg-nav:hover:not(:disabled) { filter: brightness(1.08); }
  .lc-prod-nav:hover:not(:disabled) { border-color: var(--hana-blue) !important; color: var(--hana-blue) !important; }
  .cg-scroll, .lc-prod-scroll { scrollbar-width: none; -ms-overflow-style: none; }
  .cg-scroll::-webkit-scrollbar, .lc-prod-scroll::-webkit-scrollbar { display: none; }
  .oh-video{ position:relative; display:flex; align-items:center; justify-content:center; width:100%; aspect-ratio:16 / 9; padding:0; border:1px solid var(--line); border-radius:12px; overflow:hidden; background:#0B2236; cursor:pointer; }
  .oh-video img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .oh-video::after{ content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(6,18,30,0) 40%, rgba(6,18,30,0.45) 100%); }
  .oh-video-play{ position:relative; z-index:2; width:60px; height:60px; border-radius:999px; background:rgba(255,255,255,0.92); display:flex; align-items:center; justify-content:center; box-shadow:0 4px 18px rgba(0,0,0,0.35); transition:transform 150ms ease; }
  .oh-video-play svg{ margin-left:3px; }
  .oh-video:hover .oh-video-play, .oh-video:focus-visible .oh-video-play{ transform:scale(1.06); }
  .oh-video-tag{ position:absolute; z-index:2; top:12px; left:12px; font-family:'IBM Plex Mono', ui-monospace, monospace; font-size:9px; font-weight:500; text-transform:uppercase; letter-spacing:0.1em; color:rgba(255,255,255,0.75); border:1px solid rgba(255,255,255,0.3); padding:3px 7px; border-radius:3px; }
  .oh-video.is-playing{ cursor:auto; }
  .oh-video.is-playing::after{ display:none; }
  .oh-video.is-playing iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }
</style>

