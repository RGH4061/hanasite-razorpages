@page "/capabilities/automation/mes-traceability"
@{
    ViewData["Title"] = "Manufacturing Traceability — capabilities";
    ViewData["Description"] = "A manufacturing execution system that ties material, process and result to every unit — so a board can be traced from the reel it was built from to the test data it passed, by serial number.";
    ViewData["CapSlug"]  = "mes-traceability";
    ViewData["CapGroup"] = "automation";
}

@* Manufacturing traceability — sub-capability page. FAQ uses native <details>;
