    <span style="color:var(--line);">&rsaquo;</span>
    <a href="/capabilities/automation" class="hana-link" style="font-size:12.5px;text-transform:none;letter-spacing:0;font-weight:500;">Automation</a>
    <span style="color:var(--line);">&rsaquo;</span>
    <span style="color:var(--ink);font-weight:600;">In-line AOI &amp; SPI</span>
  </div>
</div>
<div class="sc-hero-band" data-hana-bg="flow" data-variant="light" data-fade="none" style="background:#fff;position:relative;z-index:1;overflow:hidden;"><img src="~/images/circuit-board-blue.png" aria-hidden="true" style="position:absolute;top:15px;right:-80px;width:300px;height:300px;opacity:0.4;pointer-events:none;z-index:0;user-select:none;transform:rotate(8deg);" /><div style="position:relative;z-index:1;max-width:1000px;margin:0 auto;padding:56px 48px 40px;"><div style="margin-bottom:64px;">
    <div style="font-family:var(--font-text);font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--hana-blue);margin-bottom:14px;">Automation · In-line AOI &amp; SPI</div>
