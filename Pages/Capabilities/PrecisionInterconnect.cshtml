    <div style="position:relative;overflow:hidden;border-radius:10px;border:1px solid var(--line);background:var(--surface);width:100%;height:407px;"><img src="/images/capabilities/cap-microelectronic-assembly-precision-interconnect-hero.webp" alt="Fine gold-wire bonds across die and substrate pads" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;"><div style="position:absolute;inset:auto 0 0 0;height:96px;background:linear-gradient(to top,rgba(3,10,23,0.72),rgba(3,10,23,0));"></div><div style="position:absolute;left:12px;bottom:10px;font-family:var(--font-mono);font-size:10px;letter-spacing:0.04em;color:rgba(255,255,255,0.92);text-transform:uppercase;">Fine-wire bonds across die and substrate pads</div></div>
    
  </div></div></div>
<div class="sc-pillars-band" data-hana-bg="wafer" data-variant="light" data-accent="" data-fade="none" style="background:linear-gradient(120deg,#f5f7fa 35%,#d8e6f3 100%);position:relative;overflow:hidden;"><div class="cap-section cap-section--band"><div style="margin-bottom:64px;"><div style="margin-bottom:26px;"><h2 style="font-family:var(--font-display);font-size:28px;font-weight:600;color:var(--ink);line-height:1.2;letter-spacing:-0.02em;margin:0;">Capability overview</h2><p style="font-family:var(--font-text);font-size:15.5px;color:var(--ink-2);line-height:1.6;max-width:640px;margin:10px 0 0;">Available interconnect processes range from chip-level bonding to film and thermal bonding for flex and module assembly, with verification appropriate to each joint type.</p></div>
    <style>.sc-stack{display:flex!important;flex-direction:column;gap:16px}.sc-stack .sc-pillar{container-type:inline-size}.sc-stack .sc-pillar>div{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);column-gap:48px;row-gap:0;align-items:start;padding:26px 30px!important;position:relative}.sc-stack .sc-pillar>div>*{grid-column:1}.sc-stack .sc-pillar>div>p{margin-bottom:0!important}.sc-stack .sc-pillar>div>ul{grid-column:2;grid-row:2/span 3;margin:-5px 0 0!important;columns:2;column-gap:28px;align-self:start}.sc-stack .sc-pillar li{break-inside:avoid}.sc-stack .sc-pillar>div::before{content:"";position:absolute;top:36px;right:76px;width:min(32%,320px);height:1px;background:linear-gradient(90deg,transparent,var(--hana-blue))}.sc-stack .sc-pillar>div::after{content:"";position:absolute;top:22px;right:30px;width:30px;height:30px;background:url(/images/hana-mark.svg) center/contain no-repeat}.sc-stack .sc-pillar>div>div:first-child{padding-right:48px}@@container (max-width:760px){.sc-stack .sc-pillar>div::before{display:none}.sc-stack .sc-pillar>div{grid-template-columns:minmax(0,1fr)}.sc-stack .sc-pillar>div>ul{grid-column:1;grid-row:auto;columns:1;margin-top:14px!important}}</style><div class="cap-grid-3 sc-stack">
