    ViewData["Description"] = "Assembly and packaging of sensitive MEMS and sensor die — low-stress attach, careful wire bond, and media access or cavity packaging that keeps the sensing element working.";
    ViewData["CapSlug"]  = "mems-sensor-assembly";
    ViewData["CapGroup"] = "microelectronic-assembly";
}

@* MEMS and sensor assembly — sub-capability page. FAQ uses native <details>;
