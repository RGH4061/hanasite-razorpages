@page "/capabilities/microelectronic-assembly/mems-sensor-assembly"
@{
    ViewData["Title"] = "MEMS & Sensor Packaging and Assembly | Capabilities";
    ViewData["Motion"] = "capability";
    ViewData["CapSlug"]  = "mems-sensor-assembly";
    ViewData["CapGroup"] = "microelectronic-assembly";
    ViewData["Canonical"] = "https://www.hanagroup.com/capabilities/microelectronic-assembly/mems-sensor-assembly";
    ViewData["Description"] = "MEMS and sensor packaging and assembly: low-stress die attach, cavity, open-cavity and ported packages for pressure, LiDAR, humidity, gas and optical sensors, with package sizes.";
}

@section Head {
    @* FAQPage data mirrors the visible FAQ below; edit both together. *@
    <script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    {
      "@@type": "Question",
      "name": "What makes MEMS and sensor assembly different?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "The sensing element must continue interacting with its environment after assembly. This requires an attach process and package structure that protect the device while maintaining pressure, optical, gas or other required access."
      }
    },
    {
      "@@type": "Question",
      "name": "What sensor types can Hana assemble?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "MEMS-based pressure, inertial, acoustic and gas sensors, optical proximity, ambient-light, color and time-of-flight sensors, humidity and temperature sensors, and LiDAR sensor packages, in cavity, open-cavity, LCC and custom package formats."
      }
    },
    {
      "@@type": "Question",
      "name": "Which sensor packages has Hana built?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Examples include open-cavity W185QFN LiDAR packages with a glass lid at 10 × 5.2 mm and 27 × 16 mm, a pre-molded W32 DFN oil pressure sensor package made with film-assisted molding, a 5 × 5 mm cavity QFN pressure sensor package with a port hole in the lid, and open-cavity SOIC and 2.5 × 2.5 mm DFN humidity and temperature sensor packages. Sizes and lead counts are listed in the package finder."
      }
    },
    {
      "@@type": "Question",
      "name": "Which package suits which sensor?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "It depends on what the sensing element has to reach. Pressure sensors typically use a lidded cavity with a port hole, or a pre-molded body made with film-assisted molding, as in the W32 DFN oil pressure package. Humidity and temperature sensors use an open cavity, and LiDAR packages an open cavity with a glass lid. Optical sensors use clear transfer mold or caps and filters, covered on the Clear & Optical Packaging page."
      }
    },
    {
      "@@type": "Question",
      "name": "How do you protect sensor accuracy?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Low-stress die attach and stress-decoupling adhesives help limit mechanical loading on the sensing element. Attach materials and cure profiles are selected per device, and the process is developed and qualified during first-article builds, with stress and yield data returned in writing. An NDA is signed before any die or CAD data is shared."
      }
    },
    {
      "@@type": "Question",
      "name": "Can Hana test and calibrate sensors during production?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Electrical and functional test can be integrated into the manufacturing process, including gas and MEMS functional test for medical sensor assemblies. Test and calibration requirements are defined per program."
      }
    },
    {
      "@@type": "Question",
      "name": "What quality systems apply?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "ISO 9001 applies group-wide, with ISO 13485 for medical sensors and IATF 16949 for automotive sensors, in ESD-controlled areas meeting ANSI/ESD S20.20."
      }
    }
  ]
}
    </script>
}

