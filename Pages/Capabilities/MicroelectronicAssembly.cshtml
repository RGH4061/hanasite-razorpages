@page "/capabilities/microelectronic-assembly"
@{
    ViewData["Title"] = "Microelectronic Assembly — capabilities";
    ViewData["Description"] = "The precision end of the group — flip chip, MEMS and sensor assembly, fine interconnect and micro-assembly, where placement is measured in microns.";
    ViewData["CapSlug"]  = "";
    ViewData["CapGroup"] = "microelectronics";
}

@* Capability hub page. Static content; section backgrounds via ~/js/hana-backgrounds.js. *@

<div class="cap-page-grid">
@await Html.PartialAsync("_CapabilitySidebar")
<div class="cap-page-main">




<style>
  .cap-subsel > .hana-bg-layer { opacity:.6 !important; background:transparent !important; }
  .hub-card{ transition:border-color 170ms ease, box-shadow 170ms ease, transform 170ms ease; }
  a.hub-card:hover{ border-color:color-mix(in srgb, var(--hana-blue) 60%, var(--line)) !important; box-shadow:0 8px 22px rgba(18,131,221,.12); transform:translateY(-2px); }
  a.hub-card:hover .hub-card-go{ gap:10px; }
</style>

<div style="border-bottom:1px solid var(--line);background:var(--bg);">
  <div style="max-width:1240px;margin:0 auto;padding:11px 32px;font-size:12.5px;color:var(--ink-3);display:flex;gap:8px;align-items:center;font-family:var(--font-text);">
    <a href="/capabilities" class="hana-link" style="font-size:12.5px;text-transform:none;letter-spacing:0;font-weight:500;">Capabilities</a>
    <span style="color:var(--line);">&rsaquo;</span>
    <span style="color:var(--ink);font-weight:600;">Microelectronic Assembly</span>
  </div>
</div>

<div data-hana-bg="flow" data-variant="light" data-fade="none" style="background:#fff;position:relative;z-index:1;overflow:hidden;"><img src="~/images/hana-mark.svg" alt="" aria-hidden="true" style="position:absolute;top:-240px;right:-240px;width:620px;height:620px;opacity:0.13;pointer-events:none;z-index:0;user-select:none;transform:rotate(45deg);">
  <div style="position:relative;z-index:1;max-width:1000px;margin:0 auto;padding:56px 48px 56px;">
    <div style="margin-bottom:52px;">
      <div style="font-family:var(--font-text);font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--hana-blue);margin-bottom:14px;">Capability</div>
      <h1 style="font-family:var(--font-display);font-size:48px;font-weight:700;color:var(--ink);line-height:1.05;letter-spacing:-0.03em;margin:0 0 18px;max-width:760px;text-wrap:balance;">Microelectronic assembly</h1>
      <p style="font-family:var(--font-text);font-size:18.5px;color:var(--ink-2);line-height:1.55;max-width:680px;margin:0 0 32px;text-wrap:pretty;">The precision end of the group — flip chip, MEMS and sensor assembly, fine interconnect and micro-assembly, where placement is measured in microns. The capabilities that define Hana as a microelectronics specialist, not a general contract assembler.</p>
      <div style="position:relative;overflow:hidden;border-radius:10px;border:1px solid var(--line);background:var(--surface);width:100%;height:320px;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,transparent 0 13px,rgba(18,131,221,0.06) 13px 14px);"><div style="position:absolute;top:10px;left:12px;width:18px;height:18px;opacity:.4;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="1.5"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v4M12 17v4M3 12h4M17 12h4"></path></svg></div><span style="font-family:var(--font-mono);font-size:11px;color:var(--ink-3);text-align:center;padding:0 18px;line-height:1.5;">[ Micro-placement head over a sensor die ]</span></div>
    </div>
    <div class="cap-subsel" data-hana-bg="halftone" data-variant="dark" data-accent="" data-fade="none" style="background:var(--hana-blue-deep);position:relative;overflow:hidden;border-radius:16px;">
      <div style="position:relative;z-index:1;max-width:1000px;margin:0 auto;padding:44px 44px 48px;">
        <div style="margin-bottom:26px;">
          <div style="font-family:var(--font-text);font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#7EC8FF;margin-bottom:12px;">Choose a detailed capability</div>
          <h2 style="font-family:var(--font-display);font-size:28px;font-weight:600;color:#fff;line-height:1.2;letter-spacing:-0.02em;margin:0 0 10px;">Explore Microelectronic Assembly</h2>
          <p style="font-family:var(--font-text);font-size:15.5px;color:rgba(255,255,255,0.72);line-height:1.6;max-width:660px;margin:0;">Four processes for products where size, sensing or interconnect density is the binding constraint.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:18px;">
            <a href="/capabilities/microelectronic-assembly/flip-chip-micro" class="hub-card" style="border:1px solid var(--line);border-radius:var(--radius-card);background:#fff;display:flex;flex-direction:column;overflow:hidden;text-decoration:none;"><div style="position:relative;overflow:hidden;border-top-left-radius:var(--radius-card);border-top-right-radius:var(--radius-card);border-bottom:1px solid var(--line);background:var(--surface);width:100%;aspect-ratio:16 / 9;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,transparent 0 13px,rgba(18,131,221,0.06) 13px 14px);"><div style="position:absolute;top:10px;left:12px;width:16px;height:16px;opacity:.4;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="1.5"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v4M12 17v4M3 12h4M17 12h4"></path></svg></div><span style="font-family:var(--font-mono);font-size:10px;color:var(--ink-3);text-align:center;padding:0 14px;line-height:1.5;text-transform:uppercase;letter-spacing:0.04em;">[ Flip chip ]</span></div><div style="padding:24px;display:flex;flex-direction:column;flex:1;">
              <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--ink);letter-spacing:-0.01em;margin-bottom:9px;text-wrap:balance;">Flip chip</div>
              <p style="font-family:var(--font-text);font-size:13.5px;color:var(--ink-2);line-height:1.55;margin:0 0 18px;">Bumped die bonded face-down for the shortest interconnect path and the highest I/O density per die.</p>
              <span class="hub-card-go" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-text);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--hana-blue);">View capability <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            </div></a>
            <a href="/capabilities/microelectronic-assembly/mems-sensor-assembly" class="hub-card" style="border:1px solid var(--line);border-radius:var(--radius-card);background:#fff;display:flex;flex-direction:column;overflow:hidden;text-decoration:none;"><div style="position:relative;overflow:hidden;border-top-left-radius:var(--radius-card);border-top-right-radius:var(--radius-card);border-bottom:1px solid var(--line);background:var(--surface);width:100%;aspect-ratio:16 / 9;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,transparent 0 13px,rgba(18,131,221,0.06) 13px 14px);"><div style="position:absolute;top:10px;left:12px;width:16px;height:16px;opacity:.4;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="1.5"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v4M12 17v4M3 12h4M17 12h4"></path></svg></div><span style="font-family:var(--font-mono);font-size:10px;color:var(--ink-3);text-align:center;padding:0 14px;line-height:1.5;text-transform:uppercase;letter-spacing:0.04em;">[ MEMS & sensor assembly ]</span></div><div style="padding:24px;display:flex;flex-direction:column;flex:1;">
              <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--ink);letter-spacing:-0.01em;margin-bottom:9px;text-wrap:balance;">MEMS &amp; sensor assembly</div>
              <p style="font-family:var(--font-text);font-size:13.5px;color:var(--ink-2);line-height:1.55;margin:0 0 18px;">Assembly of pressure, motion and optical sensors, with cavity packages and controlled environments.</p>
              <span class="hub-card-go" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-text);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--hana-blue);">View capability <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            </div></a>
            <a href="/capabilities/microelectronic-assembly/precision-interconnect" class="hub-card" style="border:1px solid var(--line);border-radius:var(--radius-card);background:#fff;display:flex;flex-direction:column;overflow:hidden;text-decoration:none;"><div style="position:relative;overflow:hidden;border-top-left-radius:var(--radius-card);border-top-right-radius:var(--radius-card);border-bottom:1px solid var(--line);background:var(--surface);width:100%;aspect-ratio:16 / 9;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,transparent 0 13px,rgba(18,131,221,0.06) 13px 14px);"><div style="position:absolute;top:10px;left:12px;width:16px;height:16px;opacity:.4;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="1.5"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v4M12 17v4M3 12h4M17 12h4"></path></svg></div><span style="font-family:var(--font-mono);font-size:10px;color:var(--ink-3);text-align:center;padding:0 14px;line-height:1.5;text-transform:uppercase;letter-spacing:0.04em;">[ Interconnect solutions ]</span></div><div style="padding:24px;display:flex;flex-direction:column;flex:1;">
              <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--ink);letter-spacing:-0.01em;margin-bottom:9px;text-wrap:balance;">Interconnect solutions</div>
              <p style="font-family:var(--font-text);font-size:13.5px;color:var(--ink-2);line-height:1.55;margin:0 0 18px;">Fine-pitch interconnect between die, substrate and flex — ACF, hot-bar and wire bond.</p>
              <span class="hub-card-go" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-text);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--hana-blue);">View capability <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            </div></a>
            <a href="/capabilities/microelectronic-assembly/micro-assembly" class="hub-card" style="border:1px solid var(--line);border-radius:var(--radius-card);background:#fff;display:flex;flex-direction:column;overflow:hidden;text-decoration:none;"><div style="position:relative;overflow:hidden;border-top-left-radius:var(--radius-card);border-top-right-radius:var(--radius-card);border-bottom:1px solid var(--line);background:var(--surface);width:100%;aspect-ratio:16 / 9;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,transparent 0 13px,rgba(18,131,221,0.06) 13px 14px);"><div style="position:absolute;top:10px;left:12px;width:16px;height:16px;opacity:.4;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="1.5"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v4M12 17v4M3 12h4M17 12h4"></path></svg></div><span style="font-family:var(--font-mono);font-size:10px;color:var(--ink-3);text-align:center;padding:0 14px;line-height:1.5;text-transform:uppercase;letter-spacing:0.04em;">[ Micro-assembly ]</span></div><div style="padding:24px;display:flex;flex-direction:column;flex:1;">
              <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--ink);letter-spacing:-0.01em;margin-bottom:9px;text-wrap:balance;">Micro-assembly</div>
              <p style="font-family:var(--font-text);font-size:13.5px;color:var(--ink-2);line-height:1.55;margin:0 0 18px;">Sub-millimetre component handling and placement for the most compact builds in the group.</p>
              <span class="hub-card-go" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-text);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--hana-blue);">View capability <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            </div></a>
        </div>
      </div>
    </div>
  </div>
</div>


</div><!-- /.cap-page-main -->
</div><!-- /.cap-page-grid -->
