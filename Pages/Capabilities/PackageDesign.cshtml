<script>
(function(){
  function fit(){
    document.querySelectorAll('.pf-scroll').forEach(function(s){
      var w=s.clientWidth; if(!w) return;
      var z=Math.max(0.55,Math.min(1.42,w/1160));
      s.style.setProperty('--pf-zoom',z.toFixed(4));
      s.style.overflowX = z>0.551 ? 'visible' : 'auto';
    });
  }
  fit();
  addEventListener('resize',fit);
  if(window.ResizeObserver){
    var ro=new ResizeObserver(function(){fit()});
    document.querySelectorAll('.pf-scroll').forEach(function(s){ro.observe(s);if(s.parentElement)ro.observe(s.parentElement)});
  }
  addEventListener('transitionend',fit,true);
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fit);
})();
</script>

<script>
(function(){
  function paint(){
    var flow=document.querySelector('.pf-wrap .flow');
    if(!flow||!window.HanaBG)return;
    HanaBG.apply(flow,{pattern:'pcb',variant:'dark',accent:'',fade:'right'});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',paint);else paint();
})();
</script>
