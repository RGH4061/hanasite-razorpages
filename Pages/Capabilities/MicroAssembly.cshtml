@page "/capabilities/microelectronic-assembly/micro-assembly"
@{
    ViewData["Title"] = "Micro-Assembly — capabilities";
    ViewData["Description"] = "Precision assembly of very small components and modules — micro-optics, hybrids and miniature subsystems built with high-accuracy placement, active alignment and micro-dispensing.";
    ViewData["CapSlug"]  = "micro-assembly";
    ViewData["CapGroup"] = "microelectronic-assembly";
}

@* Micro-assembly — sub-capability page. FAQ uses native <details>;
