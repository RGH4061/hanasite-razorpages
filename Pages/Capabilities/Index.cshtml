<script>
(function(){
  var CX=480,CY=400,R=300,CARD_W=224,START=-90;
  function rad(d){return d*Math.PI/180;}
  function positionNodes(){
    var wrap=document.getElementById('radial-wrap'); if(!wrap) return;
    if(window.innerWidth<980) return;
    var nodes=wrap.querySelectorAll('.cap-node'); var svg=document.getElementById('radial-svg'); svg.innerHTML='';
    nodes.forEach(function(node,i){
      var a=rad(START+i*60); var cx=CX+R*Math.cos(a), cy=CY+R*Math.sin(a); var h=node.offsetHeight||170;
      node.style.left=(cx-CARD_W/2)+'px'; node.style.top=(cy-h/2)+'px';
      node.style.setProperty('--ox',(CX-cx)+'px'); node.style.setProperty('--oy',(CY-cy)+'px');
      node.style.setProperty('--d',(1500+i*110)+'ms');
      var dx=cx-CX,dy=cy-CY,dist=Math.sqrt(dx*dx+dy*dy),ux=dx/dist,uy=dy/dist;
      var x1=CX+ux*93,y1=CY+uy*62,hw=CARD_W/2,hh=h/2;
      var ex=Math.max(-hw,Math.min(hw,-ux*hw/Math.max(Math.abs(ux),Math.abs(uy)*hw/hh)));
      var ey=Math.max(-hh,Math.min(hh,-uy*hh/Math.max(Math.abs(uy),Math.abs(ux)*hh/hw)));
      var x2=cx+ex,y2=cy+ey;
      var line=document.createElementNS('http://www.w3.org/2000/svg','line');
      line.setAttribute('x1',x1);line.setAttribute('y1',y1);line.setAttribute('x2',x2);line.setAttribute('y2',y2);
      line.setAttribute('stroke','#7EC8FF');line.setAttribute('stroke-width','1');line.setAttribute('stroke-opacity','0.35');line.setAttribute('stroke-dasharray','4 4');
      line.style.setProperty('--d',(1500+i*110+320)+'ms');
      svg.appendChild(line);
      var dot=document.createElementNS('http://www.w3.org/2000/svg','circle');
      dot.setAttribute('cx',x2);dot.setAttribute('cy',y2);dot.setAttribute('r','3');dot.setAttribute('fill','#7EC8FF');dot.setAttribute('fill-opacity','0.6');
      dot.style.setProperty('--d',(1500+i*110+420)+'ms');
      svg.appendChild(dot);
    });
  }
  function applyGlobe(){
    var outer=document.getElementById('radial-hero-bg'); if(!outer||!window.HanaBG) return;
    var inner=outer.querySelector('div'); if(!inner){inner=document.createElement('div');outer.appendChild(inner);}
    HanaBG.apply(inner,{pattern:'globe',variant:'dark',accent:'cyan',fade:'none'});
    document.getElementById('radial-hero').style.background='radial-gradient(ellipse 80% 100% at 80% 50%, #072c4d 0%, #030a17 65%)';
  }
  function scaleRadial(){
    var wrap=document.getElementById('radial-wrap'); if(!wrap) return;
    if(window.innerWidth<980){wrap.style.transform='';wrap.style.marginBottom='';return;}
    var avail=wrap.parentElement.clientWidth, scale=Math.min(1,avail/960);
    wrap.style.transform='scale('+scale+')'; wrap.style.marginBottom=((scale-1)*800)+'px';
  }
  /* Variation B: mark strokes draw, cards sweep clockwise into place, connectors draw back */
  function emerge(){
    var wrap=document.getElementById('radial-wrap'); if(!wrap||wrap.dataset.emerged) return;
    wrap.dataset.emerged='1';
    var armed=wrap.classList.contains('cap-armed'); wrap.classList.add('cap-emerge');
    if(!armed||!wrap.animate) return;
    var T0=900,OUT='cubic-bezier(.16,.84,.26,1)',IO='cubic-bezier(.65,0,.35,1)';
    function A(el,kf,o){return el.animate(kf,Object.assign({fill:'backwards',easing:OUT},o));}
    wrap.querySelectorAll('.radial-mk path').forEach(function(p,i){p.style.strokeDasharray='1 2';A(p,[{strokeDashoffset:1},{strokeDashoffset:0}],{duration:560,delay:T0+150+i*45});});
    wrap.querySelectorAll('.radial-center>div').forEach(function(r,i){A(r,[{opacity:0,transform:'scale(.7)'},{opacity:1,transform:'scale(1)'}],{duration:700,delay:T0+700+i*90});});
    var nodes=wrap.querySelectorAll('.cap-node');
    if(window.innerWidth<980){nodes.forEach(function(n,i){A(n,[{opacity:0,transform:'translateY(14px)'},{opacity:1,transform:'none'}],{duration:600,delay:T0+600+i*80});});return;}
    var lines=wrap.querySelectorAll('.radial-svg line'),dots=wrap.querySelectorAll('.radial-svg circle'),N=16,SW=rad(80);
    nodes.forEach(function(n,i){
      var d=T0+850+i*85,a=rad(START+i*60),gx=CX+R*Math.cos(a),gy=CY+R*Math.sin(a),kf=[];
      for(var k=0;k<=N;k++){var t=k/N,e=1-Math.pow(1-t,3),r=R*(.15+.85*e),b=a-SW*(1-e);
        kf.push({transform:'translate('+(CX+r*Math.cos(b)-gx).toFixed(1)+'px,'+(CY+r*Math.sin(b)-gy).toFixed(1)+'px) scale('+(.4+.6*e).toFixed(3)+')',opacity:Math.min(1,t*3.2)});}
      A(n,kf,{duration:1050,delay:d,easing:'linear'});
      var ln=lines[i],dt=dots[i]; if(!ln) return;
      drawLine(ln,d+820,380);
      if(dt)A(dt,[{opacity:0},{opacity:1}],{duration:260,delay:d+1080});
    });
  }
  function drawLine(ln,delay,dur){
    var x1=+ln.getAttribute('x1'),y1=+ln.getAttribute('y1'),x2=+ln.getAttribute('x2'),y2=+ln.getAttribute('y2'),t0=null;
    ln.setAttribute('x2',x1);ln.setAttribute('y2',y1);
    function f(ts){if(t0===null)t0=ts+delay;var t=Math.max(0,Math.min(1,(ts-t0)/dur)),e=t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
      if(!ln.isConnected)return;ln.setAttribute('x2',x1+(x2-x1)*e);ln.setAttribute('y2',y1+(y2-y1)*e);if(t<1)requestAnimationFrame(f);}
    requestAnimationFrame(f);
  }
  function run(){applyGlobe();scaleRadial();positionNodes();emerge();}
  window.addEventListener('load',function(){setTimeout(run,100);});
  window.addEventListener('resize',function(){scaleRadial();positionNodes();});
})();
</script>
