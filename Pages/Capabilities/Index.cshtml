@page "/capabilities"
@{
    ViewData["Title"] = "Capabilities Hub | EMS, OSAT & microelectronics";
}

<style>
.radial-section{background:var(--bg);padding:0 0 72px;overflow:hidden;position:relative;}
.radial-hero{max-width:1080px;margin:0 auto;padding:72px 40px 32px;position:relative;z-index:1;}
.radial-eyebrow{font-family:var(--font-mono);font-size:10px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#7EC8FF;margin-bottom:18px;display:flex;align-items:center;gap:10px;}
.radial-eyebrow::before{content:'';display:inline-block;width:24px;height:1px;background:#7EC8FF;opacity:.6;}
.radial-hero h1{font-family:var(--font-display);font-weight:700;font-size:56px;line-height:1.02;letter-spacing:-.032em;color:#fff;margin:0 0 22px;max-width:13ch;}
.radial-hero .lede{font-size:17px;line-height:1.6;color:rgba(255,255,255,.62);max-width:66ch;margin:0;}
.radial-scale-wrap{overflow:hidden;width:100%;}
.radial-wrap{position:relative;width:960px;height:800px;margin:0 auto;transform-origin:top center;}
.radial-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;}
.radial-center{position:absolute;width:252px;height:252px;left:480px;top:400px;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;}
.radial-center-ring{position:absolute;inset:-22px;border-radius:50%;border:1px solid rgba(18,131,221,.35);animation:ring-pulse 3s ease-in-out infinite;}
.radial-center-ring-2{position:absolute;inset:-48px;border-radius:50%;border:1px solid rgba(18,131,221,.18);animation:ring-pulse 3s ease-in-out infinite 1s;}
.radial-center-ring-3{position:absolute;inset:-76px;border-radius:50%;border:1px solid rgba(18,131,221,.08);}
.radial-center-glow{position:absolute;inset:-30px;border-radius:50%;background:radial-gradient(circle,rgba(18,131,221,0.22) 0%,transparent 70%);pointer-events:none;}
@@keyframes ring-pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(1.04);}}
@@media (prefers-reduced-motion: reduce){.radial-center-ring,.radial-center-ring-2{animation:none;}}
.radial-center img,.radial-center .radial-mk{width:100%;height:100%;object-fit:contain;position:relative;z-index:1;display:block;}
.cap-node{position:absolute;width:224px;background:rgba(255,255,255,0.97);border:1px solid rgba(255,255,255,0.25);border-top:2px solid transparent;border-radius:12px;padding:18px 16px 14px;text-decoration:none;color:inherit;transition:border-color 150ms,box-shadow 150ms,transform 150ms;display:flex;flex-direction:column;gap:6px;box-shadow:0 2px 12px rgba(0,0,0,0.22),0 1px 3px rgba(0,0,0,0.14);}
.cap-node:hover{border-color:rgba(18,131,221,0.3);border-top-color:#1283DD;box-shadow:0 8px 28px rgba(0,0,0,0.32),0 2px 6px rgba(18,131,221,0.25);transform:translateY(-3px);}
.cap-node{border-top-width:4px;border-top-color:rgba(18,131,221,.5);overflow:hidden;}
.cap-node::before{content:'';position:absolute;top:-46px;right:-46px;width:150px;height:150px;border-radius:50%;background:repeating-radial-gradient(circle at center,rgba(18,131,221,.13) 0 1px,transparent 1px 13px);pointer-events:none;}
.hero-orbit{position:absolute;z-index:1;top:64px;right:max(36px,calc(50% - 636px));width:440px;pointer-events:none;}
.hero-orbit-img{position:relative;width:100%;aspect-ratio:1;border-radius:50%;overflow:hidden;border:1px solid rgba(126,200,255,.38);}
.hero-orbit-img img{width:100%;height:100%;object-fit:cover;object-position:30% 42%;display:block;filter:saturate(.85) contrast(1.05);}
.hero-orbit-tint{position:absolute;inset:0;background:linear-gradient(160deg,rgba(7,44,77,.55) 0%,rgba(7,44,77,.12) 50%,rgba(18,131,221,.28) 100%);mix-blend-mode:multiply;}
.hero-orbit-ring{position:absolute;border-radius:50%;pointer-events:none;}
.hero-orbit-ring.r1{inset:-16px;border:1px solid rgba(126,200,255,.30);}
.hero-orbit-ring.r2{inset:-38px;border:1px dashed rgba(126,200,255,.20);}
.hero-orbit-ring.r3{inset:-62px;border:1px solid rgba(126,200,255,.09);}
.hero-orbit-ring.r2::after{content:'';position:absolute;width:7px;height:7px;border-radius:50%;background:#7EC8FF;opacity:.75;left:14%;top:7%;}
.hero-orbit-cap{margin-top:16px;text-align:center;font-family:var(--font-mono);font-size:9.5px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:rgba(126,200,255,.75);}
@@media (max-width:1140px){.hero-orbit{display:none;}}
@@media (max-width:979px){
.radial-hero{padding:56px 24px 28px;}
.radial-scale-wrap{overflow:visible;}
.radial-wrap{width:auto;height:auto;transform:none !important;margin:0 !important;padding:0 24px;}
.radial-svg{display:none;}
.radial-center{position:relative;left:auto;top:auto;transform:none;width:132px;height:132px;margin:12px auto 40px;}
.radial-center-ring{inset:-14px;}.radial-center-ring-2{inset:-28px;}.radial-center-ring-3{inset:-42px;}
#cap-nodes{display:flex !important;flex-direction:column;gap:14px;max-width:480px;margin:0 auto;}
.cap-node{position:static;width:100%;left:auto !important;top:auto !important;}
}
.cap-node-count{display:none;}
.radial-hero-bg{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
.radial-hero-bg > div{position:absolute;width:1200px;height:100%;left:50%;transform:translateX(-50%);}
.cap-node-name{font-family:var(--font-display);font-weight:600;font-size:18px;letter-spacing:-.010em;color:var(--ink);line-height:1.2;}
.cap-node-desc{font-size:11.5px;color:var(--ink-3);line-height:1.5;margin:2px 0 4px;}
.cap-node-cta{font-family:var(--font-mono);font-size:9.5px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--hana-blue);display:inline-flex;align-items:center;gap:4px;margin-top:2px;}
@@media (max-width:640px){.radial-hero h1{font-size:36px;}}
/* Hero line wipe + capabilities emerging from the mark */
.hha-line{display:block;position:relative}
.hha-in{display:block;clip-path:inset(0 100% 0 0);animation:hhaWipe 900ms cubic-bezier(.22,.7,.2,1) forwards;animation-delay:var(--d)}
.hha-edge{position:absolute;top:6%;bottom:12%;left:0;width:2px;background:#1283DD;opacity:0;box-shadow:0 0 18px rgba(18,131,221,0.9);animation:hhaEdge 900ms cubic-bezier(.22,.7,.2,1) forwards;animation-delay:var(--d)}
.hha-fade{opacity:0;animation:hhaFade 700ms cubic-bezier(.16,.84,.3,1) forwards;animation-delay:var(--d)}
@@keyframes hhaWipe{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}
@@keyframes hhaEdge{0%{left:0;opacity:0}8%{opacity:1}92%{opacity:1}100%{left:100%;opacity:0}}
@@keyframes hhaFade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.cap-armed:not(.cap-emerge) .cap-node,.cap-armed:not(.cap-emerge) .radial-mk,.cap-armed:not(.cap-emerge) .radial-center>div,.cap-armed:not(.cap-emerge) .radial-svg{opacity:0}
@@media (prefers-reduced-motion:reduce){.hha-in,.hha-edge,.hha-fade,.cap-emerge .cap-node,.cap-emerge .radial-center,.cap-emerge .radial-svg line,.cap-emerge .radial-svg circle{animation:none!important;opacity:1!important;transform:none!important;clip-path:none!important}.hha-edge{display:none}}
</style>
