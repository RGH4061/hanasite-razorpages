@page "/capabilities/dfx-jdm/dfx-dfm"
@{
    ViewData["Title"] = "DFx / DFM — capabilities";
    ViewData["Description"] = "A manufacturing read on your design before it reaches the line — reviewing for manufacturability, test and reliability so problems are found on the drawing, not on the first build.";
    ViewData["CapSlug"]  = "dfx-dfm";
    ViewData["CapGroup"] = "dfx-jdm";
}

@* Design for Excellence (DFx / DFM) — sub-capability page. FAQ uses native <details>;
   section backgrounds via ~/js/hana-backgrounds.js. *@

<div class="cap-page-grid">
@await Html.PartialAsync("_CapabilitySidebar")
