@page "/capabilities/dfx-jdm"
@{
    ViewData["Title"] = "DFx and JDM Collaboration — capabilities";
    ViewData["CapSlug"]  = "";
    ViewData["CapGroup"] = "dfx-jdm";
}

<div class="cap-page-grid">
@await Html.PartialAsync("_CapabilitySidebar")
<div class="cap-page-main">




<style>
  .cap-subsel > .hana-bg-layer { opacity:.6 !important; background:transparent !important; }
  .hub-card{ transition:border-color 170ms ease, box-shadow 170ms ease, transform 170ms ease; }
  a.hub-card:hover{ border-color:color-mix(in srgb, var(--hana-blue) 60%, var(--line)) !important; box-shadow:0 8px 22px rgba(18,131,221,.12); transform:translateY(-2px); }
  a.hub-card:hover .hub-card-go{ gap:10px; }
</style>

<div style="border-bottom:1px solid var(--line);background:var(--bg);">
  <div style="max-width:1240px;margin:0 auto;padding:11px 32px;font-size:12.5px;color:var(--ink-3);display:flex;gap:8px;align-items:center;font-family:var(--font-text);">
    <a href="/capabilities" class="hana-link" style="font-size:12.5px;text-transform:none;letter-spacing:0;font-weight:500;">Capabilities</a>
    <span style="color:var(--line);">&rsaquo;</span>
    <span style="color:var(--ink);font-weight:600;">DFx &amp; JDM Collaboration</span>
  </div>
</div>
<details class="cap-mobnav"><summary><span>DFx &amp; JDM Collaboration</span><span class="cap-mobnav-meta">3<span class="cap-mobnav-chev"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></span></summary><div class="cap-mobnav-list"><a href="/capabilities/dfx-jdm/dfx-dfm" class="cap-sub-leaf"><span class="cap-sub-arr">&#8250;</span>Design for Excellence (DFx)</a><a href="/capabilities/dfx-jdm/jdm" class="cap-sub-leaf"><span class="cap-sub-arr">&#8250;</span>Joint Development Model (JDM)</a><a href="/capabilities/dfx-jdm/npi" class="cap-sub-leaf"><span class="cap-sub-arr">&#8250;</span>New Product Introduction (NPI)</a></div></details>

<div data-hana-bg="flow" data-variant="light" data-fade="none" style="background:#fff;position:relative;z-index:1;overflow:hidden;"><img src="~/images/hana-mark.svg" alt="" aria-hidden="true" style="position:absolute;top:-240px;right:-240px;width:620px;height:620px;opacity:0.13;pointer-events:none;z-index:0;user-select:none;transform:rotate(45deg);">
  <div class="cap-section cap-section--band cap-section--hero">
    <div style="margin-bottom:52px;">
      <div style="font-family:var(--font-text);font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--hana-blue);margin-bottom:14px;">Capability</div>
      <h1 style="font-family:var(--font-display);font-size:48px;font-weight:700;color:var(--ink);line-height:1.05;letter-spacing:-0.03em;margin:0 0 18px;max-width:760px;text-wrap:balance;">DFx and joint development</h1>
      <p style="font-family:var(--font-text);font-size:18.5px;color:var(--ink-2);line-height:1.55;max-width:680px;margin:0 0 32px;text-wrap:pretty;">Hana works with customer engineering teams before volume production through design-for-excellence review, joint development and new product introduction.</p><p style="font-family:var(--font-text);font-size:18.5px;color:var(--ink-2);line-height:1.55;max-width:680px;margin:0 0 32px;text-wrap:pretty;">Our manufacturing and process engineers can engage from the design stage through prototype, qualification and production ramp, helping align product design with the processes that will ultimately manufacture it.</p>
      <div style="position:relative; overflow:hidden; border-radius:10px; border:1px solid var(--line); background:var(--surface); width:100%; height:320px;"><img src="~/images/cap-dfx-jdm-hero.jpg" alt="Engineers reviewing a board file together" style="width:100%; height:100%; object-fit:cover; display:block;" /></div>
    </div>
    <div class="cap-subsel" data-hana-bg="halftone" data-variant="dark" data-accent="" data-fade="none" style="background:var(--hana-blue-deep);position:relative;overflow:hidden;border-radius:16px;">
      <div class="cap-section cap-section--band">
        <div style="margin-bottom:26px;">
          <div style="font-family:var(--font-text);font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#7EC8FF;margin-bottom:12px;">Choose a detailed capability</div>
          <h2 style="font-family:var(--font-display);font-size:28px;font-weight:600;color:#fff;line-height:1.2;letter-spacing:-0.02em;margin:0 0 10px;">Explore DFx &amp; JDM Collaboration</h2>
          <p style="font-family:var(--font-text);font-size:15.5px;color:rgba(255,255,255,0.72);line-height:1.6;max-width:660px;margin:0;">Engineering support from early manufacturability review through co-development and production introduction.</p>
        </div>
        <div class="cap-grid-3">
            <a href="/capabilities/dfx-jdm/dfx-dfm" class="hub-card" style="border:1px solid var(--line);border-radius:var(--radius-card);background:#fff;display:flex;flex-direction:column;overflow:hidden;text-decoration:none;"><div style="position:relative;overflow:hidden;border-top-left-radius:var(--radius-card);border-top-right-radius:var(--radius-card);border-bottom:1px solid var(--line);background:var(--surface);width:100%;aspect-ratio:16 / 9;"><img src="~/images/photos/cap-dfx-jdm-dfx-dfm-hero.webp" alt="Design for excellence (DFx / DFM)" style="width:100%;height:100%;object-fit:cover;display:block;"></div><div style="padding:24px;display:flex;flex-direction:column;flex:1;">
              <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--ink);letter-spacing:-0.01em;margin-bottom:9px;text-wrap:balance;">Design for excellence (DFx / DFM)</div>
              <p style="font-family:var(--font-text);font-size:13.5px;color:var(--ink-2);line-height:1.55;margin:0 0 18px;">Reviewing manufacturability, testability and reliability before production commitment, so potential assembly and process risks can be addressed earlier.</p>
              <span class="hub-card-go" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-text);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--hana-blue);">View capability <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            </div></a>
            <a href="/capabilities/dfx-jdm/jdm" class="hub-card" style="border:1px solid var(--line);border-radius:var(--radius-card);background:#fff;display:flex;flex-direction:column;overflow:hidden;text-decoration:none;"><div style="position:relative;overflow:hidden;border-top-left-radius:var(--radius-card);border-top-right-radius:var(--radius-card);border-bottom:1px solid var(--line);background:var(--surface);width:100%;aspect-ratio:16 / 9;"><img src="~/images/photos/cap-dfx-jdm-jdm-hero.jpeg" alt="Joint development model (JDM)" style="width:100%;height:100%;object-fit:cover;display:block;"></div><div style="padding:24px;display:flex;flex-direction:column;flex:1;">
              <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--ink);letter-spacing:-0.01em;margin-bottom:9px;text-wrap:balance;">Joint development model (JDM)</div>
              <p style="font-family:var(--font-text);font-size:13.5px;color:var(--ink-2);line-height:1.55;margin:0 0 18px;">A collaborative development model in which Hana engineering contributes to product and manufacturing process development alongside the customer team.</p>
              <span class="hub-card-go" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-text);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--hana-blue);">View capability <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            </div></a>
            <a href="/capabilities/dfx-jdm/npi" class="hub-card" style="border:1px solid var(--line);border-radius:var(--radius-card);background:#fff;display:flex;flex-direction:column;overflow:hidden;text-decoration:none;"><div style="position:relative;overflow:hidden;border-top-left-radius:var(--radius-card);border-top-right-radius:var(--radius-card);border-bottom:1px solid var(--line);background:var(--surface);width:100%;aspect-ratio:16 / 9;"><img src="~/images/photos/cap-dfx-jdm-npi-hero.webp" alt="New product introduction (NPI)" style="width:100%;height:100%;object-fit:cover;display:block;"></div><div style="padding:24px;display:flex;flex-direction:column;flex:1;">
              <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--ink);letter-spacing:-0.01em;margin-bottom:9px;text-wrap:balance;">New product introduction (NPI)</div>
              <p style="font-family:var(--font-text);font-size:13.5px;color:var(--ink-2);line-height:1.55;margin:0 0 18px;">A controlled transition from qualified design to repeatable volume production through first-article builds, process qualification and ramp.</p>
              <span class="hub-card-go" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-text);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--hana-blue);">View capability <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--hana-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            </div></a>
        </div>
      </div>
    </div>
  </div>
</div>


</div></div>
</div><!-- /.cap-page-grid -->
