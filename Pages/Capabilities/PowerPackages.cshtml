@page "/capabilities/osat/power-packages"
@{
    ViewData["Title"] = "Power Packages (IGBT, SiC & GaN) | Capabilities";
    ViewData["Motion"] = "capability";
    ViewData["CapSlug"]  = "power-packages";
    ViewData["CapGroup"] = "osat";
    ViewData["Canonical"] = "https://www.hanagroup.com/capabilities/osat/power-packages";
    ViewData["Description"] = "IGBT, SiC and GaN power package assembly: power discretes, top-side cooling packages and power modules, with package sizes, maximum die sizes and AEC-Q101 qualification.";
}

@section Head {
    <link rel="stylesheet" href="~/css/package-finder.css" />
    @* FAQPage data mirrors the visible FAQ below; edit both together. *@
    <script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    {
      "@@type": "Question",
      "name": "Which module formats do you assemble?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "34 mm, 62 mm, EconoDual 3, Econo, PIM, Easy 1B, 2B and 3B, and HP1 and HPD for traction inverters, plus SiC on DBC built into a custom SiP where a standard format does not fit."
      }
    },
    {
      "@@type": "Question",
      "name": "Which power discretes are AEC-Q101 qualified?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "The TO-247 family (2L, 3L, 4L and 4L notched), D2PAK-7L and TSPAK are AEC-Q101 qualified. TOLL and PQFN 8×8 are qualified to industrial requirements. Maximum die size for each package is listed in the power package reference above and can be adjusted after design and process evaluation."
      }
    },
    {
      "@@type": "Question",
      "name": "How do you manage thermal performance in a wide-bandgap package?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Copper clip interconnect instead of wire bonds, dual-cooled pads exposed top and bottom, and ceramic DBC substrates. Voids in the thermal path are held under 5% by vacuum reflow."
      }
    },
    {
      "@@type": "Question",
      "name": "What voltage and isolation class can you assemble to?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Devices to the 1200 V class, with built-in isolation above 2500 V on the TO-247TE outline."
      }
    },
    {
      "@@type": "Question",
      "name": "Do you package GaN devices?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes. GaN devices can be packaged in power QFN 5×6 and in custom IPMs for battery chargers, SiP power converters and EV chargers, including GaN and SiC on DBC. Laser grooving and dicing are qualified for SiC and GaN wafers."
      }
    },
    {
      "@@type": "Question",
      "name": "What reliability testing can you run on a power module?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Power cycling, thermal cycling and reliability sequences are available to the programme qualification plan. The test set is agreed per programme and confirmed per site."
      }
    },
    {
      "@@type": "Question",
      "name": "What is this used for?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "EV and hybrid drivetrains, rail traction, solar and wind inverters, industrial drives, and data center power."
      }
    },
    {
      "@@type": "Question",
      "name": "Can you build a module footprint that isn't one of the standards?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes. SiC on DBC assembled into a custom SiP. If the outline itself has to be drawn, that runs through package design and simulation before any tooling is cut."
      }
    }
  ]
}
    </script>
}

