@page "/capabilities/osat/wafer-probe-final-test"
@{
    ViewData["Title"] = "Wafer Probe & Final Test — capabilities";
    ViewData["Description"] = "Electrical test at wafer level and on the finished package — probe, final test, burn-in and program, closing the loop between assembly and known-good devices.";
    ViewData["CapSlug"]  = "wafer-probe-final-test";
    ViewData["CapGroup"] = "osat";
}

@* Wafer probe and final test — sub-capability page. FAQ uses native <details>;
   section backgrounds via ~/js/hana-backgrounds.js. *@

<div class="cap-page-grid">
@await Html.PartialAsync("_CapabilitySidebar")
<div class="cap-page-main">
<style>
