    <a href="/capabilities" class="hana-link" style="font-size:12.5px;text-transform:none;letter-spacing:0;font-weight:500;">Capabilities</a>
    <span style="color:var(--line);">&rsaquo;</span>
    <a href="/capabilities/dfx-jdm" class="hana-link" style="font-size:12.5px;text-transform:none;letter-spacing:0;font-weight:500;">DFx &amp; JDM</a>
    <span style="color:var(--line);">&rsaquo;</span>
    <span style="color:var(--ink);font-weight:600;">JDM</span>
