<div style="background:#fff;"><div style="max-width:1000px;margin:0 auto;padding:8px 48px 44px;"><div style="margin-bottom:44px;"><div style="margin-bottom:26px;"><h2 style="font-family:var(--font-display);font-size:28px;font-weight:600;color:var(--ink);line-height:1.2;letter-spacing:-0.02em;margin:0;">Why run Die Attach &amp; Wire Bond with Hana</h2></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center;margin-bottom:36px;">
      <div style="order:1;">
        <div style="font-family:var(--font-text);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--hana-blue);margin-bottom:10px;">Decades of bonding</div>
