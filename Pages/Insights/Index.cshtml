@page "/insights"
@{
    ViewData["Title"] = "Insights";
    ViewData["Description"] = "Guides, process explainers and industry updates from Hana Microelectronics on EMS and OSAT manufacturing for automotive, power, optical, RFID and data-center electronics.";
}

@section Head {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Blog",
  "name": "Hana Insights",
  "url": "https://www.hanagroup.com/insights/",
  "publisher": { "@@type": "Organization", "name": "Hana Microelectronics" }
}
</script>
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.hanagroup.com/" },
    { "@@type": "ListItem", "position": 2, "name": "Insights" }
  ]
}
</script>
    <link rel="stylesheet" href="~/css/insights.css" />
}

<!-- breadcrumb + updated -->
  <div class="ins-subbar">
    <div class="hana-wrap ins-subbar-inner">
      <nav class="ins-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span>Insights</span>
      </nav>
    </div>
  </div>

  <!-- hero -->
  <section class="ins-hero" style="background-image:url('/images/photos/insights-hero-cleanroom.webp'); height: 320px">
    <div class="hana-wrap ins-hero-inner">
      <h1>Insights</h1>
      <p class="lede">Technical and market perspectives from Hana Microelectronics — how EMS and OSAT manufacturing works across automotive, RFID, medical, industrial and more, and what it means when you are choosing a manufacturing partner.</p>
    </div>
  </section>

  <!-- lead band: featured evergreen + latest industry updates -->
  <div class="ins-featured-bg" data-hana-bg="pcb" data-variant="light" data-accent="cyan" data-fade="none">
    <div class="hana-wrap ins-lead">
      <div class="ins-lead-feat">
        <span class="ins-klabel">Featured</span>
        <a class="ins-feat-card ins-feat-card--stack" id="insFeatured" href="#"></a>
      </div>
      <div class="ins-updates" data-upd="night" aria-label="Latest industry updates">
        <div class="head"><h2>Latest industry updates</h2></div>
        <div id="insUpdList"></div>
        <button class="all" id="insAllUpdates" type="button">Show older updates &darr;</button>
      </div>
    </div>
  </div>

  <!-- filter rail + card grid -->
  <div class="ins-layout-bg">
    <div class="hana-wrap ins-layout">
      <aside class="ins-sidenav" aria-label="Filter insights">
        <div class="label">Format</div>
        <ul class="ins-filternav" id="insFormatNav"></ul>
        <div class="label">Topic</div>
        <ul class="ins-filternav" id="insTopicNav"></ul>
      </aside>
      <div class="ins-content">
        <div class="ins-topic-head" id="insTopicHead"></div>
        <div class="ins-result">
          <span class="ins-klabel">Showing</span>
          <span class="ri-count" id="riCount"></span>
          <button class="ins-reset" id="insReset" type="button" hidden>Clear filters &times;</button>
        </div>
        <div class="ins-grid" id="insGrid"></div>
        <div class="ins-empty" id="insEmpty">No articles in this combination yet.</div>
      </div>
    </div>
  </div>

  <!-- page-end CTA — contact only -->
  <section class="ins-page-end" aria-label="Contact Hana" data-hana-bg="grid" data-variant="dark" data-accent="cyan" data-fade="none">
    <div class="hana-wrap ins-page-end-inner">
      <div>
        <p class="ttl">Have a manufacturing question?</p>
        <p class="desc">Tell us what you're building and our team will point you to the right capability or facility.</p>
      </div>
      <div style="display:flex; gap:12px;">
        <a href="/contact" class="hana-btn hana-btn-primary">Contact us <i data-lucide="arrow-right" style="width:13px; height:13px;"></i></a>
      </div>
    </div>
  </section>

@section Scripts {
    <script src="~/js/insights-hub.js"></script>
}
