  <div class="ins-layout-bg">
    <div class="hana-wrap ins-layout">
      <aside class="ins-sidenav" aria-label="On this page">
        <div class="label">On this page</div>
        <ul class="ins-toc" id="insToc">
          <li><a href="#what-is-driving-the-sic">What is driving the SiC substrate market recovery?</a></li>
          <li><a href="#where-the-practical-constraints-sit">Where the practical constraints sit</a></li>
