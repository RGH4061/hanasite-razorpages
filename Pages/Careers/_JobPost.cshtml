@model HanaSite.Services.CareersJobs.Job
@using HanaSite.Services
@* Shared layout for one open role. Each role has a page file in Pages/Careers/Jobs/ that sets the
   title and Head section and renders this partial; the content comes from Data/careers-jobs.json.
   The questions contact is the recruitment inbox of the role's plant ("plants" in that file). *@
@{
    var job = Model;
    var plant = CareersJobs.PlantOf(job);
}

<!-- ── Hero band: subbar + hero over dark PCB grid ── -->
<div class="hero-band">
  <svg class="hero-pcb-bg" width="100%" height="100%" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id="pcb-glow" cx="50%" cy="50%" r="60%">
        <stop offset="0%" stop-color="#0E4A7C" stop-opacity="0.45" />
        <stop offset="100%" stop-color="#030a17" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="1200" height="420" fill="url(#pcb-glow)" />
    <g stroke="#1283DD" stroke-width="0.4" stroke-opacity="0.06">
      <line x1="0" y1="0" x2="0" y2="420"/><line x1="75" y1="0" x2="75" y2="420"/><line x1="150" y1="0" x2="150" y2="420"/><line x1="225" y1="0" x2="225" y2="420"/><line x1="300" y1="0" x2="300" y2="420"/><line x1="375" y1="0" x2="375" y2="420"/><line x1="450" y1="0" x2="450" y2="420"/><line x1="525" y1="0" x2="525" y2="420"/><line x1="600" y1="0" x2="600" y2="420"/><line x1="675" y1="0" x2="675" y2="420"/><line x1="750" y1="0" x2="750" y2="420"/><line x1="825" y1="0" x2="825" y2="420"/><line x1="900" y1="0" x2="900" y2="420"/><line x1="975" y1="0" x2="975" y2="420"/><line x1="1050" y1="0" x2="1050" y2="420"/><line x1="1125" y1="0" x2="1125" y2="420"/><line x1="1200" y1="0" x2="1200" y2="420"/>
      <line x1="0" y1="0" x2="1200" y2="0"/><line x1="0" y1="60" x2="1200" y2="60"/><line x1="0" y1="120" x2="1200" y2="120"/><line x1="0" y1="180" x2="1200" y2="180"/><line x1="0" y1="240" x2="1200" y2="240"/><line x1="0" y1="300" x2="1200" y2="300"/><line x1="0" y1="360" x2="1200" y2="360"/><line x1="0" y1="420" x2="1200" y2="420"/>
    </g>
    <g stroke="#1283DD" stroke-width="1.4" stroke-opacity="0.28">
      <line x1="75" y1="60" x2="150" y2="60"/><line x1="225" y1="60" x2="300" y2="60"/><line x1="375" y1="60" x2="450" y2="60"/><line x1="525" y1="60" x2="600" y2="60"/><line x1="675" y1="60" x2="750" y2="60"/><line x1="825" y1="60" x2="900" y2="60"/><line x1="975" y1="60" x2="1050" y2="60"/>
      <line x1="150" y1="120" x2="225" y2="120"/><line x1="300" y1="120" x2="375" y2="120"/><line x1="450" y1="120" x2="525" y2="120"/><line x1="600" y1="120" x2="675" y2="120"/><line x1="750" y1="120" x2="825" y2="120"/><line x1="900" y1="120" x2="975" y2="120"/><line x1="1050" y1="120" x2="1125" y2="120"/>
      <line x1="75" y1="180" x2="150" y2="180"/><line x1="225" y1="180" x2="300" y2="180"/><line x1="450" y1="180" x2="525" y2="180"/><line x1="675" y1="180" x2="750" y2="180"/><line x1="825" y1="180" x2="900" y2="180"/><line x1="1050" y1="180" x2="1125" y2="180"/>
      <line x1="150" y1="240" x2="225" y2="240"/><line x1="375" y1="240" x2="450" y2="240"/><line x1="525" y1="240" x2="600" y2="240"/><line x1="750" y1="240" x2="825" y2="240"/><line x1="900" y1="240" x2="975" y2="240"/><line x1="1125" y1="240" x2="1200" y2="240"/>
      <line x1="75" y1="300" x2="150" y2="300"/><line x1="300" y1="300" x2="375" y2="300"/><line x1="450" y1="300" x2="525" y2="300"/><line x1="675" y1="300" x2="750" y2="300"/><line x1="825" y1="300" x2="900" y2="300"/><line x1="1050" y1="300" x2="1125" y2="300"/>
      <line x1="150" y1="360" x2="225" y2="360"/><line x1="375" y1="360" x2="450" y2="360"/><line x1="600" y1="360" x2="675" y2="360"/><line x1="750" y1="360" x2="825" y2="360"/><line x1="975" y1="360" x2="1050" y2="360"/>
      <line x1="150" y1="60" x2="150" y2="120"/><line x1="300" y1="60" x2="300" y2="120"/><line x1="450" y1="120" x2="450" y2="180"/><line x1="675" y1="60" x2="675" y2="120"/><line x1="825" y1="120" x2="825" y2="180"/><line x1="975" y1="60" x2="975" y2="120"/><line x1="1050" y1="120" x2="1050" y2="180"/>
      <line x1="225" y1="180" x2="225" y2="240"/><line x1="525" y1="180" x2="525" y2="240"/><line x1="750" y1="180" x2="750" y2="240"/><line x1="900" y1="240" x2="900" y2="300"/><line x1="1125" y1="180" x2="1125" y2="240"/>
      <line x1="150" y1="240" x2="150" y2="300"/><line x1="375" y1="240" x2="375" y2="300"/><line x1="675" y1="300" x2="675" y2="360"/><line x1="825" y1="300" x2="825" y2="360"/><line x1="1050" y1="300" x2="1050" y2="360"/>
    </g>
    <g fill="#1283DD" fill-opacity="0.85">
      <rect x="72" y="57" width="6" height="6"/><rect x="222" y="57" width="6" height="6"/><rect x="447" y="117" width="6" height="6"/><rect x="597" y="117" width="6" height="6"/><rect x="822" y="177" width="6" height="6"/><rect x="1047" y="177" width="6" height="6"/>
      <rect x="147" y="237" width="6" height="6"/><rect x="372" y="237" width="6" height="6"/><rect x="522" y="237" width="6" height="6"/><rect x="747" y="297" width="6" height="6"/><rect x="972" y="57" width="6" height="6"/>
      <rect x="297" y="297" width="6" height="6"/><rect x="447" y="297" width="6" height="6"/><rect x="672" y="357" width="6" height="6"/><rect x="897" y="237" width="6" height="6"/><rect x="1122" y="237" width="6" height="6"/>
    </g>
    <g fill="none" stroke="#4E9BDA" stroke-width="1.4" stroke-opacity="0.7">
      <circle cx="375" cy="60" r="2.6"/><circle cx="525" cy="60" r="2.6"/><circle cx="750" cy="120" r="2.6"/><circle cx="900" cy="60" r="2.6"/><circle cx="1125" cy="120" r="2.6"/>
      <circle cx="225" cy="180" r="2.6"/><circle cx="675" cy="180" r="2.6"/><circle cx="975" cy="120" r="2.6"/><circle cx="150" cy="300" r="2.6"/><circle cx="525" cy="300" r="2.6"/>
      <circle cx="825" cy="300" r="2.6"/><circle cx="1050" cy="300" r="2.6"/><circle cx="375" cy="360" r="2.6"/><circle cx="750" cy="360" r="2.6"/><circle cx="1050" cy="360" r="2.6"/>
    </g>
  </svg>
  <div class="hero-overlay"></div>


  <div class="subbar">
    <div class="subbar-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/careers">Careers</a><span class="sep">/</span>
        <span>@job.Title</span>
      </nav>
    </div>
  </div>

  <section class="hero">
    <div class="hero-inner">
      <div class="eyebrow">Open role · @job.Department</div>
      <h1>@job.Title</h1>
    </div>
  </section>
</div>

<!-- ── Main content ── -->
<div class="layout-bg">
  <div class="layout">

    <main class="jd">

      <div class="jd-section">
        <div class="jd-label"><span>Working at Hana</span></div>
        <h2>Join a team that builds what the world runs on</h2>
        <p>At Hana Group, we deliver high-performing manufacturing solutions that solve real challenges for customers across the globe. Behind that mission are the people who drive our processes, develop our strategies, and show up for our customers every day.</p>
        <p>When you join Hana, you join a genuinely multinational team working alongside leading OEM companies across Asia and beyond. We value what you bring today and invest in where you're headed — your development matters to us, not just the output.</p>
        <p>Our people are the foundation of everything we achieve. If you share our drive to pursue excellence and take pride in your work, you'll find your place here.</p>
      </div>

      @if (!string.IsNullOrWhiteSpace(job.About))
      {
      <div class="jd-section">
        <div class="jd-label"><span>About the role</span></div>
        <h2>What you'll be doing</h2>
        <p>@job.About</p>
      </div>
      }

      <div class="jd-section">
        <div class="jd-label"><span>Responsibilities</span></div>
        <h2>Key responsibilities</h2>
        <ul class="jd-list">
          @foreach (var r in job.Responsibilities) { <li>@r</li> }
        </ul>
      </div>

      <div class="jd-section">
        <div class="jd-label"><span>Requirements</span></div>
        <h2>Qualifications</h2>
        <ul class="jd-list">
          @foreach (var q in job.Qualifications) { <li>@q</li> }
        </ul>
      </div>

      @if (job.Benefits is { Count: > 0 })
      {
      <div class="jd-section">
        <div class="jd-label"><span>What we offer</span></div>
        <h2>Life at Hana</h2>
        <ul class="jd-list">
          @foreach (var b in job.Benefits) { <li>@b</li> }
        </ul>
      </div>
      }

    </main>

    <aside class="job-sidebar">
      <div class="apply-card">
        <div class="apply-card-head">
          <div class="role">@job.Title</div>
          <div class="loc">@plant.Location</div>
        </div>
        <div class="apply-card-body">
          <a href="/careers/consent?job=@job.Slug" class="apply-btn">Apply for this role →</a>
        </div>
        <a class="apply-contact" href="mailto:@plant.Email">
          <span class="apply-contact-icon" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
          <span class="apply-contact-text">
            <span class="apply-contact-label">Questions? Email the @plant.Name recruitment team</span>
            <span class="apply-contact-email">@plant.Email</span>
          </span>
        </a>
      </div>

      <div class="details-card">
        <div class="details-card-head">Role details</div>
        <div class="detail-row"><span class="detail-key">Location</span><span class="detail-val">@plant.Location</span></div>
        <div class="detail-row"><span class="detail-key">Type</span><span class="detail-val">@job.Type</span></div>
        <div class="detail-row"><span class="detail-key">Department</span><span class="detail-val">@job.Department</span></div>
        <div class="detail-row"><span class="detail-key">Pay basis</span><span class="detail-val">@job.PayBasis</span></div>
        <div class="detail-row"><span class="detail-key">Posted</span><span class="detail-val">@job.PostedText</span></div>
      </div>

      @if (job.Boards is { Count: > 0 })
      {
      <div class="boards-card">
        <div class="boards-card-head">Also listed on</div>
        @foreach (var b in job.Boards)
        {
        <a href="@b.Url" class="board-link" target="_blank" rel="noopener">
          <svg class="globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"/></svg>
          <span class="board-name">@b.Name</span>
          <svg class="board-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </a>
        }
      </div>
      }
    </aside>

  </div>
</div>

<!-- ── Page end ── -->
<div class="page-end">
  <div class="page-end-inner">
    <p>Looking for a different role? View all open positions at our Thailand, Cambodia and China facilities.</p>
    <a href="/careers#open-roles" class="btn">← Back to all roles</a>
  </div>
</div>
