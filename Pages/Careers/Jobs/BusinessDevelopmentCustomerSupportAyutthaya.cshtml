@page "/careers/jobs/business-development-customer-support-ayutthaya"
@{
    var job = HanaSite.Services.CareersJobs.Get("business-development-customer-support-ayutthaya")!;
    var plant = HanaSite.Services.CareersJobs.PlantOf(job);
    ViewData["Title"] = job.Title + " | Careers";
    ViewData["Motion"] = "page";
    ViewData["Description"] = job.Title + ", " + plant.Location + ". " + job.Type + " role at Hana Microelectronics.";
}
@section Head {
    <link rel="stylesheet" href="~/css/careers-job-post.css" />
}
@* Role content: Data/careers-jobs.json ("business-development-customer-support-ayutthaya"). Layout: Pages/Careers/_JobPost.cshtml. *@
<partial name="_JobPost" model="job" />
