@page "/investor-relations/faq"
@{
    // Results Presentations hidden (management, 27 Nov 2026) until the Q4/2026 recording is published.
    // To bring it back: set this to true, add the video, and rename the page "FAQ & Presentations" again
    // (H1, breadcrumb, intro, IR hub card and the IR sub-navigation links; see git history).
    const bool ShowPresentations = false;
    ViewData["Title"] = "Investor FAQ";
    ViewData["Motion"] = "page";
    ViewData["AltLang"] = "th";
    ViewData["AltLangUrl"] = "/th/investor-relations/faq";
    ViewData["Description"] = "Frequently asked questions for Hana investors.";
}
@section Head {
    <link rel="stylesheet" href="~/css/investors-faq.css" asp-append-version="true" />
}

@* Investor FAQ — Hana Microelectronics. Static content. *@

<div class="hero-band">
  <canvas id="hero-topo"></canvas>
  <div class="hero-overlay"></div>
  <div class="subbar">
    <div class="subbar-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/investor-relations">Investor Relations</a>
        <span class="sep">/</span>
        <span>FAQ</span>
      </nav>
      <div class="meta">
        Page updated <strong>12 Jun 2026</strong>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <h1>Frequently Asked Questions</h1>
      <p class="lede">
        Answers to common questions about Hana Microelectronics Public Company Limited
        (SET: HANA) — our shares, dividends, financial reporting, and how to
        reach the Investor Relations team.
      </p>
    </div>
  </section>
</div>

  <!-- MAIN -->
  <div class="layout-bg">
  <div class="layout">
    <aside class="sectionnav" aria-label="On this page">
      <div class="label">On this page</div>
      @if (ShowPresentations)
      {
      <ol>
        <li>
          <a href="#presentations">
            <span class="num">1</span>
            <span>Results Presentations</span>
            <span class="count">4</span>
          </a>
        </li>
      </ol>
      }
      <div class="navgroup">
        <div class="navgroup-label">Investor FAQs</div>
        <ol class="subnav">
          <li>
            <a href="#shares-dividends">
              <span>Shares &amp; Dividends</span>
              <span class="count">6</span>
            </a>
          </li>
          <li>
            <a href="#reporting">
              <span>Financial Reporting</span>
              <span class="count">4</span>
            </a>
          </li>
          <li>
            <a href="#company-listing">
              <span>Company &amp; Listing</span>
              <span class="count">4</span>
            </a>
          </li>
        </ol>
      </div>
      <div class="footer-link">
        <span class="footer-link-label">See also</span>
        <a href="/investor-relations/contact">Investor Events</a>
        <a href="/investor-relations/news">Investor News</a>
      </div>
    </aside>

    <main class="content">

      @if (ShowPresentations)
      {
      <text>
      <!-- ─── 1. Results Presentations (SET video slots) ─── -->
      <section class="doc" id="presentations">
        <header class="section-head">
          <h2>Results Presentations</h2>
          <p class="intro">
            Recordings of management's quarterly results presentations from the
            Stock Exchange of Thailand's Earnings Call sessions. Each recording is
            published by the Stock Exchange of Thailand on its YouTube channel.
          </p>
        </header>

        @* Results Presentations reset (management, 27 Nov 2026): every earlier recording was removed;
             the first recording on the new site is Q4/2026. 
             To publish it, swap the frame below for the featured video block used before this change
             (git history: button.frame.has-poster.yt-facade with data-yt = the YouTube ID, poster in
             images/ir/, the "Latest" pill and date in .vc-kind, and the SET link in .detail). *@
        <div class="feature feature--pending">
          <div class="feature-head">
            <div class="vc-kind"><span>Earnings Call</span></div>
            <h3>Q4/2026 results presentation</h3>
          </div>
          <div class="feature-grid">
            <div class="frame pending-frame">
              <p class="pending-text">The recording will be published here after the Q4/2026 Earnings Call session.</p>
            </div>
          </div>
        </div>

        <p class="video-note">
          Upcoming sessions and registration are listed on the
          <a href="/investor-relations/contact" style="color:var(--hana-blue-deep);text-decoration:none;border-bottom:1px solid var(--line);">Investor Events &amp; Contact</a> page.
        </p>
      </section>
      </text>
      }

      <!-- ─── Group heading: Investor FAQs ─── -->
      <div class="grouphead" id="faqs">
        <div class="eyebrow">
          <span>Frequently Asked Questions</span>
        </div>
        <h2>Investor FAQs and General Information</h2>
        <p class="intro">
          Answers to the questions we hear most often from investors and analysts,
          grouped by topic. Can't find what you need? Contact the Investor
          Relations team.
        </p>
      </div>

      <!-- ─── 2. Shares & Dividends ─── -->
            <section class="doc" id="shares-dividends">
        <header class="section-head">
          <h2>Shares &amp; Dividends</h2>
          <p class="intro">
            How Hana shares are listed and traded, and how the company approaches dividends.
          </p>
        </header>

        <div class="faqgroup">
          <details class="faq">
            <summary><span class="q">Where are Hana Microelectronics shares listed?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana Microelectronics Public Company Limited is listed on the Stock Exchange of Thailand (SET) under the ticker symbol <strong>HANA</strong>. Shares are denominated and traded in Thai baht (THB).</p>
              <dl class="faq-dl">
                <div><dt>Name</dt><dd>Hana Microelectronics Public Co., Ltd.</dd></div>
                <div><dt>Stock Code</dt><dd><strong>HANA</strong></dd></div>
                <div><dt>Capital Market</dt><dd>The Stock Exchange of Thailand (SET)</dd></div>
                <div><dt>Company Registration No.</dt><dd>0107536000773</dd></div>
              </dl>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">What is Hana's share capital?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <dl class="faq-dl">
                <div><dt>Registered Share Capital</dt><dd>885,366,746 ordinary shares at par value of Baht 1.00</dd></div>
                <div><dt>Paid-up Capital</dt><dd>885,366,660 ordinary shares at par value of Baht 1.00</dd></div>
                <div><dt>Par Value</dt><dd>Baht 1.00 per share</dd></div>
              </dl>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">What is Hana's dividend policy?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>The Company has a policy to pay dividends to shareholders at a rate of not less than 30% of its consolidated net profit, after deduction of corporate income tax and allocation to statutory reserves as required by law. The actual dividend payment shall depend on the Company’s operating results, financial position, cash flow, investment plans, and other factors as deemed appropriate by the Board of Directors, and shall be in compliance with applicable laws and regulations. Accordingly, the dividend payout ratio may be lower or higher than the above rate, and may exceed 100% of consolidated net profit where deemed appropriate by the Board of Directors.</p>
              <p>The dividend policy of the subsidiaries is to pay dividends to the Company based on their operating results, financial position, cash flow, investment plans, and business requirements, as deemed appropriate by their respective boards of directors and in compliance with applicable laws and regulations.</p>
              <p>Historical dividend records are shown under <a href="#dividend-history" data-open-faq>Dividend Payment History</a> below.</p>
            </div>
          </details>
          <details class="faq" id="dividend-history">
            <summary><span class="q">Dividend Payment History</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Earnings and dividends per share for the last ten financial years. Each payment is announced to the SET and published on the <a href="/investor-relations/news">Investor News</a> page.</p>
              <div class="divtable-wrap">
                <table class="divtable">
                  <caption class="sr-only">Dividend payment history, 2016 to 2025</caption>
                  <thead><tr><th scope="col">Year</th><th scope="col">EPS</th><th scope="col">Interim Dividend<br>(Baht/Share)</th><th scope="col">Annual Dividend<br>(Baht/Share)</th><th scope="col">Total<br>(Baht/Share)</th><th scope="col">%<br>Payout</th></tr></thead>
                  <tbody>
                  <tr><th scope="row">2025</th><td>0.76</td><td>0.25</td><td>0.75</td><td>1.00</td><td>132%</td></tr>
                  <tr><th scope="row">2024</th><td>(0.72)</td><td>0.25</td><td>0.50</td><td>0.75</td><td>0%*</td></tr>
                  <tr><th scope="row">2023</th><td>2.14</td><td>0.50</td><td>0.50</td><td>1.00</td><td>47%</td></tr>
                  <tr><th scope="row">2022</th><td>2.61</td><td>0.50</td><td>0.50</td><td>1.00</td><td>38%</td></tr>
                  <tr><th scope="row">2021</th><td>1.92</td><td>1.00</td><td>1.00</td><td>2.00</td><td>104%</td></tr>
                  <tr><th scope="row">2020</th><td>2.37</td><td>0.65</td><td>0.75</td><td>1.40</td><td>59%</td></tr>
                  <tr><th scope="row">2019</th><td>2.24</td><td>0.65</td><td>0.65</td><td>1.30</td><td>58%</td></tr>
                  <tr><th scope="row">2018</th><td>2.95</td><td>1.00</td><td>1.00</td><td>2.00</td><td>68%</td></tr>
                  <tr><th scope="row">2017</th><td>3.59</td><td>1.00</td><td>1.00</td><td>2.00</td><td>56%</td></tr>
                  <tr><th scope="row">2016</th><td>2.62</td><td>1.00</td><td>1.00</td><td>2.00</td><td>76%</td></tr>
                  </tbody>
                </table>
              </div>
              <p class="divnote">Note: *Payout ratio is not applicable due to negative EPS; 0% is shown for presentation purposes only.</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">When does Hana pay dividends?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Dividends are typically considered alongside the full-year results and approved at the Annual General Meeting, with payment following the record date set in the SET announcement. Any interim dividend is announced separately.</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">Does Hana offer a dividend reinvestment plan?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana does not currently operate a dividend reinvestment plan. Dividends are paid in cash to registered shareholders.</p>
            </div>
          </details>
        </div>
      </section>

      <!-- ─── 3. Financial Reporting ─── -->
      <section class="doc" id="reporting">
        <header class="section-head">
          <h2>Financial Reporting</h2>
          <p class="intro">
            When and how Hana reports its results, and where to find the
            underlying documents.
          </p>
        </header>

        <div class="faqgroup">
          <details class="faq">
            <summary><span class="q">When does Hana's financial year end?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana's financial year runs from 1 January to 31 December. The company reports results on a quarterly basis in line with SET requirements.</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">How often does Hana report results?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana publishes quarterly financial statements together with a Management’s Discussion &amp; Analysis (MD&amp;A), and a full-year Annual Report (Form 56-1 One Report). Each release is announced to the SET and made available on the company's Investor Relations pages.</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">Where can I find Hana's annual report and financial statements?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>The latest Annual Report (56-1 One Report) is available on the <a href="/investor-relations/annual">Annual Reports</a> page. Quarterly statements and MD&amp;A are on the <a href="/investor-relations/news">Investor News</a> page.@if (ShowPresentations) {<text> Results presentations are on this page, under <a href="#presentations">Results Presentations</a>.</text>}</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">How can I follow Hana's SET announcements?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>All official disclosures are filed with the Stock Exchange of Thailand and republished on our <a href="/investor-relations/news">Investor News</a> page as downloadable documents, grouped by year.</p>
            </div>
          </details>
        </div>
      </section>

      <!-- ─── 4. Company & Listing ─── -->
      <section class="doc" id="company-listing">
        <header class="section-head">
          <h2>Company &amp; Listing</h2>
          <p class="intro">
            Background on the company behind the listing and how to get in touch.
          </p>
        </header>

        <div class="faqgroup">
          <details class="faq">
            <summary><span class="q">What does Hana Microelectronics do?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana Microelectronics is an electronics manufacturing services (EMS) and semiconductor assembly &amp; test (OSAT) provider. The group manufactures printed circuit board assemblies, integrated circuit packaging, RFID and smart-tag products, and sensor and optical modules for customers across automotive, industrial, medical, telecommunications, and other markets.</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">Where does Hana operate?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana is headquartered in Thailand and operates manufacturing facilities across Thailand, China, Cambodia, and the United States. Details of each site are on the <a href="/locations">Locations</a> pages.</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">When was Hana listed on the SET?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Hana Microelectronics has been listed on the Stock Exchange of Thailand since 01 Feb 1993. Listing details are summarized in the Annual Report.</p>
            </div>
          </details>
          <details class="faq">
            <summary><span class="q">How do I contact the Investor Relations team?</span><span class="chev" aria-hidden="true">+</span></summary>
            <div class="a">
              <p>Investor inquiries are handled by the Corporate Affairs team. Contact details and the registered office address are on the <a href="/investor-relations/contact">Investor Events &amp; Contact</a> page.</p>
            </div>
          </details>
        </div>

        <div class="related">
          <span class="lbl">See also</span>
          <a href="/investor-relations/contact">Investor Events &amp; Contact</a>
          <span class="sep">·</span>
          <a href="/investor-relations/annual">Annual Reports</a>
          <span class="sep">·</span>
          <a href="/investor-relations/governance">Governance Documents</a>
        </div>
      </section>

    </main>
  </div>
  </div>

  <!-- PAGE END -->
  <section class="page-end" aria-label="Investor relations contact">
    <div class="page-end-inner">
      <div>
        <p class="ttl">Didn't find your answer?</p>
        <p class="desc">
          Contact the Investor Relations team directly, or browse upcoming
          investor events.
        </p>
      </div>
      <div class="actions">
        <a href="/investor-relations/contact" class="btn">Investor Events</a>
        <a href="/investor-relations/contact" class="btn primary">Contact IR &nbsp;→</a>
      </div>
    </div>
  </section>

@section Scripts {
<script>
document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[data-open-faq]');if(!a)return;var d=document.querySelector(a.getAttribute('href'));if(d&&d.tagName==='DETAILS'){d.open=true;}});
</script>
    <script>
document.querySelectorAll('.detail .tab').forEach(function(tab){
  tab.addEventListener('click', function(){
    var detail = tab.closest('.detail');
    detail.querySelectorAll('.tab').forEach(function(t){ t.classList.remove('active'); });
    detail.querySelectorAll('.detail-panel').forEach(function(p){ p.classList.remove('active'); });
    tab.classList.add('active');
    var panel = detail.querySelector('#' + tab.dataset.panel);
    if (panel) panel.classList.add('active');
  });
});
</script>
    <script src="~/js/investors-bg.js"></script>
    <script src="~/js/yt-facade.js" defer></script>
    <script src="~/js/oppday-tabs.js" defer></script>
}
