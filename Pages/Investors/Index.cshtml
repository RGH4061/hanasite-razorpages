@page "/investor-relations"
@{
    ViewData["Title"] = "Investor Relations";
    ViewData["Motion"] = "page";
    ViewData["Description"] = "SET-listed (HANA): financial reporting, governance, and shareholder information.";
    ViewData["Canonical"] = "https://www.hanagroup.com/investor-relations";
    ViewData["AltLang"] = "th";
    ViewData["AltLangUrl"] = "/th/investor-relations";
}
@section Head {
    <link rel="stylesheet" href="~/css/investors.css" />
    <link rel="stylesheet" href="~/css/market-page.css" />
    <link rel="stylesheet" href="~/css/investors-hub.css" />
}

@* Investor Relations — Hana Microelectronics. Static content. *@

@{
    // SET serves its HANA price widget only on the website registered with it (www.hanagroup.com); on any
    // other host (localhost, the GitHub Pages preview) its firewall answers "Access denied", so those hosts
    // show the HANA-box half of SET's sample image, labelled as a preview.
    var setLive = HttpContext.Request.Host.Host.EndsWith("hanagroup.com", StringComparison.OrdinalIgnoreCase);
}
<div class="ir-hub">

  <div class="mk-crumbbar"><div class="mk-wrap in"><a href="/">Home</a><span class="sep">&rsaquo;</span><span class="here">Investor Relations</span><span class="ir-hub-updated">Updated <strong>14 May 2026</strong></span></div></div>

  <div class="ir-hub-stage">
  <section class="mk-hero">
    <div class="mk-wrap mk-hero-in">
      <div>
        <span class="hero-accent" aria-hidden="true"></span>
        <h1 class="mk-h1">Investor Relations Hub</h1>
        <p class="mk-lede">Financial information, governance, and corporate disclosure for Hana Microelectronics, which is listed on the Stock Exchange of Thailand under the symbol HANA.</p>
      </div>
    </div>
  </section>

  <section class="ir-hub-body" data-hana-bg="flow" data-variant="light" data-accent="cyan" data-fade="none">
    <div class="mk-wrap ir-hub-in">
      <div class="feature-banner">
        <a class="feature-body" href="/investor-relations/news">
          <h2 class="fb-title">Investor news</h2>
          <p class="fb-desc">SET announcements, quarterly financial statements, AGM notices, and dividend disclosures, organized by year.</p>
          <div class="fb-meta">
            <div class="m"><div class="m-val">14 May 2026</div><div class="m-lbl">Latest filing</div></div>
            <div class="m"><div class="m-val">Q1 2026</div><div class="m-lbl">Latest result</div></div>
          </div>
          <span class="fb-cta">View all News &amp; filings  →</span>
        </a>
        @* SET price panel: SET's free IR widget (irpage.jsp, the HANA price box, 200 x 214 px, shown at x1.25). *@
        <div class="stock-panel sp-set">
          <div class="sp-label">HANA &nbsp;·&nbsp; SET price</div>
          <div class="sp-set-box">
            @if (setLive)
            {
            <iframe class="sp-set-frame" src="https://weblink.settrade.com/IRPage/irpage.jsp?txtSymbol=HANA&amp;language=en&amp;key=27160" title="HANA share price from the Stock Exchange of Thailand" width="200" height="214" frameborder="0" scrolling="no"></iframe>
            }
            else
            {
            <img class="sp-set-frame" src="https://media.set.or.th/set/Images/2022/Mar/%E0%B8%95%E0%B8%B1%E0%B8%A7%E0%B8%AD%E0%B8%A2%E0%B9%88%E0%B8%B2%E0%B8%87%E0%B8%A3%E0%B8%B9%E0%B8%9B%E0%B9%81%E0%B8%9A%E0%B8%9A%E0%B8%A1%E0%B8%B2%E0%B8%95%E0%B8%A3%E0%B8%90%E0%B8%B2%E0%B8%99%E0%B8%82%E0%B8%AD%E0%B8%87%E0%B8%95%E0%B8%A5%E0%B8%B2%E0%B8%94%E0%B8%AB%E0%B8%A5%E0%B8%B1%E0%B8%81%E0%B8%97%E0%B8%A3%E0%B8%B1%E0%B8%9E%E0%B8%A2%E0%B9%8C%E0%B8%AF.jpg" alt="SET sample display of the IR widget" />
            }
          </div>
          @if (!setLive)
          {
          <span class="sp-set-tag">Preview: SET sample (Thai, old data)</span>
          }
          <p class="sp-set-note">Prices delayed 15 minutes. Source: Stock Exchange of Thailand.</p>
          <a href="https://www.set.or.th/en/market/product/stock/quote/hana/price" target="_blank" rel="noopener noreferrer" class="sp-set-link">View HANA on SET &nbsp;↗</a>
        </div>
      </div>

      <h2 class="mk-h2 sm ir-hub-sechead">Investor information</h2>
      <div class="ir-grid ir-hub-cards">
        <a class="ir-card" href="/investor-relations/annual"><span class="ir-hub-ic"><i data-lucide="file-text"></i></span>
          <h3 class="ic-title">Annual Reports &amp; 56-1 One Report</h3>
          <p class="ic-desc">Audited financials and the 56-1 One Report submitted to the SET, with the business overview and sustainability disclosures for each financial year.</p>
          <span class="ic-cta">View →</span></a>
        <a class="ir-card" href="/investor-relations/governance"><span class="ir-hub-ic"><i data-lucide="landmark"></i></span>
          <h3 class="ic-title">Governance Documents</h3>
          <p class="ic-desc">Articles of Association, committee charters, CG policies, anti-corruption commitment, and CAC membership.</p>
          <span class="ic-cta">View →</span></a>
        <a class="ir-card" href="/investor-relations/structure"><span class="ir-hub-ic"><i data-lucide="network"></i></span>
          <h3 class="ic-title">Group Structure &amp; Shareholders</h3>
          <p class="ic-desc">Principal subsidiaries, associates, and major shareholders as disclosed to the Stock Exchange of Thailand.</p>
          <span class="ic-cta">View →</span></a>
        <a class="ir-card" href="/investor-relations/faq"><span class="ir-hub-ic"><i data-lucide="presentation"></i></span>
          <h3 class="ic-title">FAQ &amp; Presentations</h3>
          <p class="ic-desc">SET Earnings Call recordings with summaries and transcripts, and answers to common investor questions on shares, dividends, and reporting.</p>
          <span class="ic-cta">View →</span></a>
        <a class="ir-card" href="/investor-relations/contact"><span class="ir-hub-ic"><i data-lucide="calendar-days"></i></span>
          <h3 class="ic-title">Investor Events &amp; Contact</h3>
          <p class="ic-desc">Upcoming and past analyst meetings and SET Earnings Calls, and direct contact for the Investor Relations team.</p>
          <span class="ic-cta">View →</span></a>
        <a class="ir-card" href="/investor-relations/esg"><span class="ir-hub-ic"><i data-lucide="leaf"></i></span>
          <h3 class="ic-title">Sustainability</h3>
          <p class="ic-desc">Our approach to environmental, social, and governance responsibility: the Board's ESG statement, sustainability policy, and ESG Data Platform disclosures.</p>
          <span class="ic-cta">View →</span></a>
      </div>
    </div>

    <section class="mk-cta ir-hub-cta" data-hana-bg="flow" data-variant="dark" data-fade="none" aria-label="Investor relations contact">
      <div class="mk-wrap in">
        <div>
          <h2 class="mk-h2 on-dark">Investor inquiries</h2>
          <p class="mk-body on-dark">For questions on financial results, governance, or to join the investor mailing list, please contact the Investor Relations team.</p>
        </div>
        <div class="acts">
          <a href="/investor-relations/contact" class="hana-btn hana-btn-ghost-on-dark" style="padding:12px 22px;font-size:12px;">Investor events</a>
          <a href="/investor-relations/contact#ir-contact" class="hana-btn hana-btn-on-dark" style="padding:12px 22px;font-size:12px;">Contact IR <i data-lucide="arrow-right" style="width:14px;height:14px;margin-left:6px;"></i></a>
        </div>
      </div>
    </section>
  </section>
  </div>

</div>

@section Scripts {
    <script src="~/js/investors-bg.js"></script>
}
