@functions {
    public record Link(string Label, string Href, Link[] Kids);
    public record Sec(string Title, Link[] Items);
    static Link L(string label, string href, params Link[] kids) => new(label, href, kids);
    static Sec S(string title, params Link[] items) => new(title, items);
}
@section Head {
    <link rel="stylesheet" href="~/css/sitemap.css" />
}

<div class="sm">
  <header class="sm-head">
    <h1 class="sm-title">Site map</h1>
    <p class="sm-lede">All pages on the Hana Microelectronics website, grouped by section.</p>
    <ul class="sm-quick">
      <li><a href="/">Home</a></li>
      <li><a href="/search">Search</a></li>
      <li><a href="/th" lang="th">ภาษาไทย</a></li>
    </ul>
  </header>

  <div class="sm-grid">
    @foreach (var column in columns)
    {
      <div class="sm-col">
        @foreach (var sec in column)
        {
          <section class="sm-sec">
            <h2 class="sm-sec-title">@sec.Title</h2>
            <ul class="sm-list">
              @foreach (var item in sec.Items)
              {
                <li class="@(item.Kids.Length > 0 ? "has-kids" : null)">
                  <a class="sm-l1" href="@item.Href">@item.Label</a>
                  @if (item.Kids.Length > 0)
                  {
                    <ul class="sm-kids">
                      @foreach (var kid in item.Kids)
                      {
                        <li><a class="sm-l2" href="@kid.Href">@kid.Label</a></li>
                      }
                    </ul>
                  }
                </li>
              }
            </ul>
          </section>
        }
      </div>
    }
  </div>
</div>
