                    L("Power Modules", "/markets/automotive/power-modules"),
                    L("Automotive PCBA", "/markets/automotive/automotive-pcba"),
                    L("Sensor Assembly", "/markets/automotive/sensor-assembly"),
                    L("LED Lighting", "/markets/automotive/led-lighting")
