                    L("MEMS & Sensor Assembly", "/capabilities/microelectronic-assembly/mems-sensor-assembly"),
                    L("Precision Interconnect", "/capabilities/microelectronic-assembly/precision-interconnect"),
                    L("Micro-Assembly", "/capabilities/microelectronic-assembly/micro-assembly")
                ),
                L("RFID & Smart Tags", "/capabilities/rfid-smart-tags"),
                L("Automation & Smart Manufacturing", "/capabilities/automation",
                    L("Robotic & Smart Manufacturing", "/capabilities/automation/robotic-smart-manufacturing"),
                    L("Manufacturing Traceability", "/capabilities/automation/mes-traceability")
