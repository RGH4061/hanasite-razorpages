    ViewData["Description"] = "Hana assembles IGBT and silicon-carbide power modules for EV traction inverters, chargers and converters — on AEC-Q101-qualified lines across Thailand and China.";
    ViewData["Canonical"] = "https://www.hanagroup.com/markets/automotive/power-modules";

    var activeSlug = "power-modules";
    var subs = new[] {
        new { slug = "power-modules",   name = "Power Modules",   icon = "zap" },
        new { slug = "sensor-assembly", name = "Sensor Assembly", icon = "radio" },
        new { slug = "led-lighting",    name = "LED Lighting",    icon = "lightbulb" },
        new { slug = "rfid-tire-tags",  name = "RFID Tire Tags",  icon = "circle-dot" },
        new { slug = "automotive-pcba", name = "Automotive PCBA", icon = "cpu" }
    };
    var heroStats = new[] {
        new { v = "AEC-Q101", l = "Qualified" },
        new { v = "IGBT · SiC", l = "Device types" },
        new { v = "Ag sinter", l = "Die attach" },
        new { v = "Power cycle", l = "Tested in-house" }
    };
    var plants = new[] {
        new { route = "lamphun",   country = "Thailand", name = "Lamphun",   note = "PCBA · box build · lighting" },
        new { route = "ayutthaya", country = "Thailand", name = "Ayutthaya", note = "Power modules · microelectronics" },
        new { route = "jiaxing",   country = "China",    name = "Jiaxing",   note = "High-volume PCBA · modules" }
    };
    var faq = new[] {
        new { q = "What power devices can Hana assemble into modules?", a = "Hana supports IGBT and silicon-carbide (SiC) die in single- and multi-die layouts, with solder or silver-sinter die attach and aluminum-wire or copper-clip interconnect." },
        new { q = "Why does silver sintering matter for SiC?", a = "SiC devices operate at higher temperatures and switching speeds than conventional silicon devices. Silver-sinter die attach provides improved thermal and mechanical performance under elevated temperature and repeated thermal cycling." },
        new { q = "How is the thermal path controlled?", a = "The thermal path is managed through DBC or AMB ceramic substrates, baseplate attachment and controlled solder or sinter interfaces. X-ray inspection is used where required to verify joint quality and voiding." }
    };
}
