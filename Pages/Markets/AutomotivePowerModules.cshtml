@page "/markets/automotive/power-modules"
@{
    ViewData["Title"] = "Automotive Power Module Assembly";
    ViewData["Motion"] = "market";
    ViewData["Description"] = "IGBT and SiC power module assembly for EV traction inverters, on-board chargers and DC-DC converters, with AEC-Q101 qualified power discretes. Thailand and China.";
    ViewData["Canonical"] = "https://www.hanagroup.com/markets/automotive/power-modules";

    var activeSlug = "power-modules";
    var subs = new[] {
        new { slug = "power-modules",   name = "Power Modules",   icon = "zap" },
        new { slug = "sensor-assembly", name = "Sensor Assembly", icon = "radio" },
        new { slug = "led-lighting",    name = "LED Lighting",    icon = "lightbulb" },
        new { slug = "rfid-tire-tags",  name = "RFID Tire Tags",  icon = "circle-dot" },
        new { slug = "automotive-pcba", name = "Automotive PCBA", icon = "cpu" }
    };
    var plants = new[] {
        new { route = "ayutthaya", country = "Thailand", name = "Ayutthaya", note = "Power modules · microelectronics" },
        new { route = "jiaxing",   country = "China",    name = "Jiaxing",   note = "Power modules · power discretes" }
    };
    var faq = new[] {
    new { q = "Which module formats do you build for traction inverters?", a = "Custom SiC modules on DBC substrate, and the HP1 and HPD formats." },
    new { q = "Are the power modules AEC-Q101 qualified?", a = "AEC-Q101 is a qualification for discrete devices. Hana’s TO-247 family, D2PAK-7L and TSPAK discretes are AEC-Q101 qualified. Module reliability testing, including power and thermal cycling, follows the program’s qualification plan." },
    new { q = "When is silver-sinter die attach used?", a = "Where the program specifies it, typically for SiC devices. Silver sinter can give better thermal and mechanical performance than solder at the higher junction temperatures and repeated thermal cycling that SiC devices see." }
    };
}
