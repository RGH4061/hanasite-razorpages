    <style>
    .mk-caplinks .links .pending{display:inline-flex;align-items:baseline;gap:8px;border:1px dashed var(--line);border-radius:4px;padding:12px 18px;font-family:var(--font-text);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3)}
