@page "/markets/automotive/sensor-assembly"
@{
    ViewData["Title"] = "Automotive Sensor Assembly";
    ViewData["Motion"] = "market";
    ViewData["Description"] = "Hana assembles MEMS and optical automotive sensors for ADAS, LiDAR and in-cabin sensing — stress-managed, cavity-packaged and automotive-qualified, in controlled environments in Thailand and China.";
    ViewData["Canonical"] = "https://www.hanagroup.com/markets/automotive/sensor-assembly";

    var finderUrl = "/capabilities/osat/package-finder?cat=Sensor%20packages";
    // Sensor examples: the p60 package types first, then the vehicle locations named on the Automotive hub.
    var locations = new[] {
        "LiDAR sensor (ADAS)", "Oil pressure sensor", "Pressure & fuel sensor", "Air pressure sensor",
        "Humidity sensor", "Temperature & fog sensors", "Passenger weight sensor", "Intake air control sensor",
        "Intake sensor", "Brake sensor", "Gear transmission sensor", "Armrest control sensor", "Steering sensor"
    };
    // Sensor packages — OSAT deck p60. The same rows sit in the package finder under "Sensor packages".
    var autoSensors = new[] {
        new { img = "lidar-qfn-10x5",      name = "LiDAR sensor package (ADAS)", pkg = "W185QFN",            size = "10 × 5.2 mm", build = "Open cavity with glass lid attach" },
        new { img = "lidar-qfn-27x16",     name = "LiDAR sensor package (ADAS)", pkg = "W185QFN, 227 leads", size = "27 × 16 mm",  build = "Open cavity with glass lid attach" },
        new { img = "oil-pressure-dfn",    name = "Oil pressure sensor package", pkg = "W32 DFN, 4 leads",   size = "7 × 8.4 mm",  build = "Pre-molded package using film-assisted molding (FAM)" },
        new { img = "pressure-cavity-qfn", name = "Pressure sensor package",     pkg = "Cavity QFN",         size = "5 × 5 mm",    build = "Lid attach, with a port hole in the lid" }
    };
    var relatedSensors = new[] {
        new { img = "humidity-temp-soic", name = "Humidity and temperature sensor package", pkg = "SOIC, 8 leads", size = "",             build = "Open cavity packaging" },
        new { img = "humidity-dfn",       name = "Humidity sensor package",                 pkg = "DFN",           size = "2.5 × 2.5 mm", build = "Open cavity packaging" }
    };
    var faq = new[] {
        new { q = "What sensor types can Hana assemble?", a = "Hana supports MEMS-based pressure, inertial and acoustic sensors, optical proximity and ambient-light detectors, and LiDAR sensor packages in cavity, LCC and custom package formats." },
        new { q = "Which automotive sensor packages has Hana built?", a = "Examples include open-cavity W185QFN LiDAR packages with a glass lid at 10 × 5.2 mm and 27 × 16 mm, a pre-molded W32 DFN oil pressure sensor package made with film-assisted molding, and a 5 × 5 mm cavity QFN pressure sensor package with a port hole in the lid. Humidity and temperature sensors can also be packaged in open-cavity SOIC and DFN formats." }
    };
    var faqLd = string.Join(",\n        ", faq.Select(f =>
        "{ \"@type\": \"Question\", \"name\": " + System.Text.Json.JsonSerializer.Serialize(f.q) +
        ", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": " + System.Text.Json.JsonSerializer.Serialize(f.a) + " } }"));
}
@section Head {
    <link rel="stylesheet" href="~/css/automotive.css" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        @Html.Raw(faqLd)
      ]
    }
    </script>
}

<div class="auto-page"><div class="auto-crumb"><div class="inner"><a href="/markets">Markets</a><span class="sep">&rsaquo;</span><a href="/markets/automotive">Automotive</a><span class="sep">&rsaquo;</span><span class="here">Sensor Assembly</span></div></div><div class="auto-spoke-grid"><aside class="auto-side"><div class="side-head"><span class="side-head-label">Automotive components</span><button type="button" class="side-toggle" aria-label="Collapse sidebar"><span class="chev"><i data-lucide="chevron-right" style="width:13px;height:13px;"></i></span></button></div><a class="s" href="/markets/automotive/power-modules"><span class="abbr">PM</span><span class="label">Power Modules</span></a><a class="s active" href="/markets/automotive/sensor-assembly"><span class="abbr">SA</span><span class="label">Sensor Assembly</span></a><a class="s" href="/markets/automotive/automotive-pcba"><span class="abbr">AP</span><span class="label">Automotive PCBA</span></a><a class="s" href="/markets/rfid/rfid-tire-tags"><span class="abbr">RT</span><span class="label">RFID Tire Tags</span></a><a class="s" href="/markets/automotive/led-lighting"><span class="abbr">LL</span><span class="label">LED Lighting</span></a><div class="helper"><div class="h">Not sure which fits?</div><p>Tell us what the part does in the vehicle and we&rsquo;ll point you to the right line.</p><a class="cta" href="/contact" style="text-decoration:none;">Work with us <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></a></div></aside><main style="min-width:0; overflow:hidden;">

<!-- hero -->
<div data-hana-bg="globe" data-variant="light" data-fade="none" style="position:relative; overflow:hidden;">
  <div style="position:relative; z-index:1; padding:44px 48px 22px; max-width:976px;">
    <div class="auto-sens-hero">
      <div>
        <div class="auto-eyebrow">Automotive · Sensor Assembly</div>
        <h1 style="font-family:var(--font-display); font-size:40px; font-weight:700; color:var(--ink); line-height:1.06; letter-spacing:-0.03em; margin:0 0 18px; text-wrap:balance;">Sensor assembly for ADAS and in-cabin sensing</h1>
        <p style="font-size:16px; color:var(--ink-2); line-height:1.65; margin:0 0 22px; text-wrap:pretty;">Hana assembles MEMS, optical and related automotive sensor packages for ADAS, LiDAR, pressure measurement and in-cabin sensing.</p>
        <div class="auto-sens-ctas">
          <a href="#sensor-packages" class="auto-btn auto-btn--primary">See sensor packages <i data-lucide="arrow-down" style="width:13px;height:13px;"></i></a>
          <a href="@finderUrl" class="auto-btn auto-btn--secondary">Open the package finder</a>
        </div>
      </div>
      <div class="auto-sens-hero-img"><img src="/images/mk-automotive-sensor-assembly-samples.webp" alt="A sample of assembled automotive sensor packages" width="494" height="330" /></div>
    </div>
    <div class="auto-sens-locs">
      <div class="h">Automotive sensor examples</div>
      <ul>@foreach (var l in locations) {<li>@l</li>}</ul>
    </div>
  </div>
</div>

<!-- sensor packages (OSAT deck p60) -->
<div id="sensor-packages" class="auto-sens" style="position:relative; z-index:1; padding:36px 48px 20px; max-width:976px;">
  <div class="auto-sechead"><h2>Sensor packages we build</h2><p>Leadframe-based sensor packages from Hana&rsquo;s OSAT operation in Ayutthaya. Each uses an open or lidded cavity so the sensing element is exposed to light, pressure or the surrounding air, as the design requires.</p></div>
  <div class="auto-sens-group">Automotive sensor packages</div>
  <div class="auto-sens-grid">
    @foreach (var s in autoSensors) {
    <div class="auto-sens-card"><div class="img"><img src="/images/photos/mk-auto-sensor-@(s.img).webp" alt="@s.name, @s.pkg" loading="lazy" width="480" height="360" /></div><div class="body"><h3>@s.name</h3><dl><div><dt>Package</dt><dd>@s.pkg</dd></div><div><dt>Body size</dt><dd>@s.size</dd></div><div><dt>Construction</dt><dd>@s.build</dd></div></dl></div></div>
    }
  </div>
  <div class="auto-sens-group">Related open-cavity sensor packages</div>
  <p class="auto-sens-note">Humidity and temperature sensor packages built on the same open-cavity process. Automotive requirements are reviewed per program.</p>
  <div class="auto-sens-grid">
    @foreach (var s in relatedSensors) {
    <div class="auto-sens-card"><div class="img"><img src="/images/photos/mk-auto-sensor-@(s.img).webp" alt="@s.name, @s.pkg" loading="lazy" width="480" height="360" /></div><div class="body"><h3>@s.name</h3><dl><div><dt>Package</dt><dd>@s.pkg</dd></div>@if (s.size != "") {<div><dt>Body size</dt><dd>@s.size</dd></div>}<div><dt>Construction</dt><dd>@s.build</dd></div></dl></div></div>
    }
  </div>
  <p style="margin:18px 0 0;"><a href="@finderUrl" class="auto-sens-link">Compare these in the package finder <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></a></p>
</div>

<!-- capabilities -->
<div style="position:relative; z-index:1; padding:20px 48px 40px; max-width:976px;"><div class="auto-moreinfo" data-hana-geo="side" data-geo-theme="midnight"><div><h2>More information</h2><p>Explore the capabilities behind automotive sensor assembly.</p></div><div class="acts"><a href="/capabilities/microelectronic-assembly/mems-sensor-assembly" class="auto-btn auto-btn--ondark-primary">MEMS &amp; Sensor Assembly <i data-lucide="arrow-right" style="width:13px;height:13px;"></i></a><a href="/capabilities/microelectronic-assembly" class="auto-btn auto-btn--ondark-primary">Microelectronic Assembly <i data-lucide="arrow-right" style="width:13px;height:13px;"></i></a><a href="/markets/optical-sensors" class="auto-btn auto-btn--ondark-primary">Optical sensor packaging <i data-lucide="arrow-right" style="width:13px;height:13px;"></i></a></div></div></div>

<!-- where it's made -->
<div style="background:#EAF2FB; border-top:1px solid var(--line); padding:40px 0;"><div style="max-width:976px; padding:0 48px;"><div class="auto-sechead"><h2>Where it&#39;s made</h2><p>Ayutthaya and Lamphun in Thailand are the principal sites for sensor assembly, with further support in Jiaxing, China. Lines run with temperature, humidity and particulate controls appropriate to the device.</p></div><div class="auto-plants" style="grid-template-columns:repeat(3, 1fr);"><a class="auto-plantcard" href="/locations/ayutthaya" style="text-decoration:none; color:inherit;"><div><span class="co"><i data-lucide="map-pin" style="width:13px;height:13px;"></i> Thailand</span><div class="nm">Ayutthaya</div></div><span class="cta">View plant <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></span></a><a class="auto-plantcard" href="/locations/lamphun" style="text-decoration:none; color:inherit;"><div><span class="co"><i data-lucide="map-pin" style="width:13px;height:13px;"></i> Thailand</span><div class="nm">Lamphun</div></div><span class="cta">View plant <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></span></a><a class="auto-plantcard" href="/locations/jiaxing" style="text-decoration:none; color:inherit;"><div><span class="co"><i data-lucide="map-pin" style="width:13px;height:13px;"></i> China</span><div class="nm">Jiaxing</div></div><span class="cta">View plant <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></span></a></div><p style="font-size:13px; line-height:1.5; margin:18px 0 0;"><a href="/locations" style="color:var(--hana-blue); text-decoration:none; font-weight:600;">View all locations &rarr;</a></p></div></div>

<!-- FAQ -->
<div style="background:var(--bg); border-top:1px solid var(--line); padding:40px 0 48px;"><div style="max-width:976px; padding:0 48px;"><div class="auto-sechead"><h2>Frequently asked questions</h2></div><div class="auto-faq">
@for (var i = 0; i < faq.Length; i++) {
<div class="item @(i == 0 ? "is-open" : "")"><button type="button" class="q"><span class="num">@((i + 1).ToString("00"))</span><h3 class="qt">@faq[i].q</h3><span class="chev"><i data-lucide="chevron-down" style="width:16px;height:16px;"></i></span></button><div class="panel"><span></span><p>@faq[i].a</p></div></div>
}
</div><div style="margin-top:22px;"><a href="/markets/automotive" style="font-size:12px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; color:var(--hana-blue); text-decoration:none; display:inline-flex; align-items:center; gap:6px; white-space:nowrap; line-height:1.4;"><i data-lucide="arrow-left" style="width:13px;height:13px;"></i> Back to the Automotive market hub</a></div></div></div>

<section class="auto-cta auto-cta--spoke" style="background:var(--hana-blue-deep);" data-hana-bg="flow" data-variant="dark" data-accent="cyan" data-fade="none"><div class="inner"><div><h2>Have an automotive sensor to build?</h2><p>Send the device and its role in the vehicle. We'll come back with a packaging approach and an indicative plan.</p></div><div class="actions"><a href="/contact" class="auto-btn auto-btn--ondark-primary">Start a program <i data-lucide="arrow-right" style="width:13px;height:13px;"></i></a></div></div></section></main></div></div>

@section Scripts {
    <script src="~/js/automotive.js"></script>
}
