@page "/markets"
@{
    ViewData["Title"] = "Markets we serve — Hana Microelectronics";
    ViewData["Description"] = "Hana builds microelectronics for ten market segments — automotive, industrial and IoT, telecommunications, RFID, optical and sensors, consumer electronics, medical, access control, power management and data centers.";
}
@section Head {
    <link rel="stylesheet" href="~/css/markets-hub.css" />
}

@* Markets hub (pillar) page. Static content. *@

<section class="mkt-hero-section">
  <div class="mkt-hero-bg" id="mkt-hero-bg"></div>
  <div class="mkt-hero">
    <div class="mkt-hero-eyebrow">Markets</div>
    <h1>Experience built across diverse markets</h1>
    <p class="lede">The Hana group covers the full breadth of EMS services, from automotive qualified production and medical grade assembly to high-volume RFID inlays, complex PCBA and sensor packaging.</p>
    <p class="lede">This diversity strengthens our manufacturing capability and shared quality standards across all sectors. Experience gained across different products, volumes and technical requirements informs how we push towards innovative new processes, apply automation and support customer programs. It also gives Hana a balanced customer and market base, reducing dependence on any single sector.</p>
  </div>
  <div class="mkt-orbit" aria-hidden="true">
    <div class="mkt-orbit-ring r3"></div>
    <div class="mkt-orbit-ring r2"></div>
    <div class="mkt-orbit-ring r1"></div>
    <div class="mkt-orbit-img">
      <div class="mkt-orbit-glow"></div>
      <img src="~/images/hana-mark-white.svg" alt=""/>
    </div>
  </div>

  <div class="mkt-grid-section">
    <div class="mkt-grid-wrap">
      <div class="mkt-sec-eyebrow">Go into detail</div>
      <h2 class="mkt-sec-title">The markets we build for</h2>
      <p class="mkt-sec-note">Each market category covers examples of the end applications of the products we build and the capabilities we specialize in.</p>
      <div class="mkt-bento">
        <a class="mkt-tile" href="/markets/automotive">
          <img src="~/images/photos/homepage-markets-automotive.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Automotive</h3><p class="mkt-tile-desc">Power modules, ADAS, sensors, EV charging, LED lighting.</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/industrial-iot">
          <img src="~/images/photos/mk-industrial-iot-hero.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Industrial &amp; IoT</h3><p class="mkt-tile-desc">Environmental sensors, controllers, meters.</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/telecommunications">
          <img src="~/images/photos/mk-telecommunications-hero.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Telecommunications</h3><p class="mkt-tile-desc">Network infrastructure and gateways, console servers.</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/rfid">
          <img src="~/images/photos/mk-rfid-hero.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">RFID</h3><p class="mkt-tile-desc">Inlays, tire tags, retail smart labels.</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/optical-sensors">
          <img src="~/images/photos/mk-optical-sensors-hero.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Optical &amp; sensors</h3><p class="mkt-tile-desc">Camera module, image and light sensors.</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/consumer-electronics">
          <img src="~/images/photos/mk-consumer-electronics-card-smt-sensors.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Consumer electronics</h3><p class="mkt-tile-desc">Smart phone sensors, IoT products &amp; peripherals.</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/medical">
          <img src="~/images/photos/mk-medical-hero.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Medical</h3><p class="mkt-tile-desc">Hearing aids, patient monitoring and diagnostics.</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/access-control">
          <img src="~/images/photos/mk-access-control-hero.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Access control</h3><p class="mkt-tile-desc">Smart cards, readers, smart locks, security tokens.</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/power-management">
          <img src="~/images/photos/mk-power-management-hero.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Power management</h3><p class="mkt-tile-desc">Power packages and conversion. SiC, GaN and more</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
        <a class="mkt-tile" href="/markets/data-centers">
          <img src="~/images/photos/mk-data-centers-hero.webp" alt="" loading="lazy" decoding="async"/>
          <div class="mkt-tile-body"><div><h3 class="mkt-tile-name">Data Centers</h3><p class="mkt-tile-desc">AI data centre cooling infrastructure, optical equipment and power infrastructure</p></div><span class="mkt-tile-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
        </a>
      </div>
    </div>
  </div>

  <section class="mkt-cta">
    <h2>Tell us what you are building</h2>
    <p>Send us the product and the market it ships into. We will tell you which plants are qualified to run it and what the path to volume looks like.</p>
    <a class="mkt-cta-btn" href="/contact">Start a conversation</a>
  </section>
</section>

<script>
window.addEventListener('load', function () {
  var outer = document.getElementById('mkt-hero-bg');
  if (!outer || !window.HanaBG) return;
  var inner = outer.querySelector('div');
  if (!inner) { inner = document.createElement('div'); outer.appendChild(inner); }
  HanaBG.apply(inner, { pattern: 'globe', variant: 'dark', accent: 'cyan', fade: 'none' });
});
</script>

