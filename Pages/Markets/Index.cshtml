@page "/markets"
@{
    ViewData["Title"] = "Markets we serve";
    ViewData["Motion"] = "market";
    ViewData["Description"] = "Markets Hana serves: automotive, industrial and IoT, telecom, RFID, optical and sensors, consumer, medical, access control, power management and data centers.";
}
@section Head {
    <link rel="stylesheet" href="~/css/markets-hub.css" />
}

@* Markets hub (pillar) page. Static content. *@

<section class="mkt-hero-section">
