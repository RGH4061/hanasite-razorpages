    ViewData["Description"] = "Hana builds embeddable RFID tire tags engineered to survive cure, flex and road heat for the life of the tire — UHF ISO 18000-63, on qualified RFID lines in Thailand and the USA.";
    ViewData["Canonical"] = "https://www.hanagroup.com/markets/automotive/rfid-tire-tags";

    var activeSlug = "rfid-tire-tags";
    var subs = new[] {
        new { slug = "power-modules",   name = "Power Modules",   icon = "zap" },
        new { slug = "sensor-assembly", name = "Sensor Assembly", icon = "radio" },
        new { slug = "led-lighting",    name = "LED Lighting",    icon = "lightbulb" },
        new { slug = "rfid-tire-tags",  name = "RFID Tire Tags",  icon = "circle-dot" },
        new { slug = "automotive-pcba", name = "Automotive PCBA", icon = "cpu" }
    };
    var heroStats = new[] {
        new { v = "Embeddable", l = "Form factor" },
        new { v = "High-temp rated", l = "Cure-survive" },
        new { v = "ISO 18000-63", l = "Compliant" },
        new { v = "Long-life", l = "Tested" }
    };
    var plants = new[] {
        new { route = "lamphun", country = "Thailand", name = "Lamphun", note = "PCBA · box build · lighting" },
        new { route = "ohio",    country = "USA",      name = "Ohio",    note = "Regional PCBA · support" }
    };
    var faq = new[] {
        new { q = "What makes a tire tag different from a standard RFID label?", a = "A tire tag is embedded in rubber during vulcanization and must therefore withstand cure temperatures above 150°C, followed by repeated flex and temperature exposure throughout the tire's service life. The antenna, chip attachment and encapsulation materials are selected for this environment." },
        new { q = "What frequency and protocol does Hana produce for?", a = "Hana supports UHF operation across 860–960 MHz to ISO 18000-63 / EPC Gen 2. Other protocols can be considered to program requirements." },
        new { q = "Can Hana support the antenna design as well as production?", a = "Yes. Hana can work with the customer on antenna geometry and encapsulation material selection so the tag can be qualified against the required tire compound, geometry and production process before volume manufacturing." }
    };
}
