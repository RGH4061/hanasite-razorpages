@page "/cookie-policy"
@{
    ViewData["Title"] = "Cookie Policy";
    ViewData["Description"] = "How Hana Microelectronics uses cookies and similar technologies.";
}

@section Head {
    <link rel="stylesheet" href="~/css/insights.css" />
}


<div class="ins-page">

  <div class="ins-subbar">
    <div class="hana-wrap ins-subbar-inner">
      <nav class="ins-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span>Cookie policy</span>
      </nav>
      <div class="meta">Updated <strong>2 Jul 2026</strong></div>
    </div>
  </div>

  <section class="ins-hero" style="height:200px;">
    <div class="hana-wrap ins-hero-inner">
      <h1 style="font-size:32px;">Cookie policy</h1>
      <p class="lede">How Hana Microelectronics uses cookies and similar technologies on this website, and how you can control them.</p>
    </div>
  </section>

  <div class="ins-layout-bg">
    <div class="hana-wrap ins-layout">

      <aside class="ins-sidenav" aria-label="On this page">
        <div class="label">On this page</div>
        <ul class="ins-toc" id="legalToc">
          <li><a href="#what">What cookies are</a></li>
          <li><a href="#types">Types we use</a></li>
          <li><a href="#control">Managing cookies</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </aside>

      <article class="ins-article">
        <p class="lede">This policy explains how Hana Microelectronics uses cookies and similar technologies on our website, in line with our <a class="inline" href="/privacy-policy">Privacy Policy</a> and the Personal Data Protection Act B.E. 2562 (2019).</p>

        <h2 id="what">What cookies are</h2>
        <p>Cookies are small text files placed on your device when you visit a website. They help the site function, remember your preferences, and let us understand how the site is used so we can improve it.</p>

        <h2 id="types">Types we use</h2>
        <ul>
          <li><strong>Essential cookies</strong> — required for the site to function, such as security and navigation.</li>
          <li><strong>Performance cookies</strong> — collect anonymous, aggregated statistics on how visitors use our pages, so we can improve site performance.</li>
          <li><strong>Preference cookies</strong> — remember choices you've made, such as language or region.</li>
        </ul>
        <p>We do not use cookies to build advertising profiles, and we do not sell cookie data to third parties.</p>

        <h2 id="control">Managing cookies</h2>
        <p>Most browsers let you view, delete, and block cookies through their settings. Blocking essential cookies may affect how parts of the site function. Because cookie controls vary by browser, consult your browser's help documentation for instructions specific to your setup.</p>

        <h2 id="contact">Contact</h2>
        <p>Questions about this policy can be directed to our team via the <a class="inline" href="/contact">contact page</a>, or see our <a class="inline" href="/privacy-policy">Privacy Policy</a> for how we handle personal data more broadly.</p>
      </article>
    </div>
  </div>
</div>